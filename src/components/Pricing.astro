---
import PricingCards from './PricingCards.astro';
---

<section id="pricing" class="py-20 sm:py-24 lg:py-32" aria-labelledby="pricing-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 min-w-0">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="pricing-heading" class="reveal text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--text-primary)] tracking-[-0.03em]">
        Simple pricing.
      </h2>
      <p class="reveal mt-5 text-lg font-medium text-[var(--text-tertiary)] leading-relaxed">
        No hidden fees. No per-click charges. One price for everything.
      </p>
    </div>

    <PricingCards />

    <p class="reveal text-center mt-10 text-sm font-medium text-[var(--text-muted)]">
      Ad spend is billed separately. All plans include AI optimization, real-time analytics, and reporting exports.
    </p>
  </div>
</section>
