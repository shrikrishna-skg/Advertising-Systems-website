---
const platforms = [
  { name: 'Google Ads',        domain: 'google.com',       letter: 'G',  live: true  },
  { name: 'Meta Ads',          domain: 'meta.com',          letter: 'M',  live: true  },
  { name: 'Expedia TravelAds', domain: 'expedia.com',       letter: 'E',  live: true  },
  { name: 'Instagram',         domain: 'instagram.com',     letter: 'IG', live: true  },
  { name: 'Facebook',          domain: 'facebook.com',      letter: 'F',  live: true  },
  { name: 'Google Analytics',  domain: 'analytics.google.com', letter: 'GA', live: true },
  { name: 'Bing Ads',          domain: 'microsoft.com',     letter: 'B',  live: true  },
  { name: 'YouTube',           domain: 'youtube.com',       letter: 'YT', live: true  },
  { name: 'Booking.com',       domain: 'booking.com',       letter: 'B',  live: false },
  { name: 'TripAdvisor',       domain: 'tripadvisor.com',   letter: 'T',  live: false },
  { name: 'Trivago',           domain: 'trivago.com',       letter: 'Tr', live: false },
  { name: 'Airbnb',            domain: 'airbnb.com',        letter: 'A',  live: false },
  { name: 'Hotels.com',        domain: 'hotels.com',        letter: 'H',  live: false },
  { name: 'Kayak',             domain: 'kayak.com',         letter: 'K',  live: false },
  { name: 'Vrbo',              domain: 'vrbo.com',          letter: 'V',  live: false },
  { name: 'TikTok',            domain: 'tiktok.com',        letter: 'TT', live: false },
  { name: 'LinkedIn',          domain: 'linkedin.com',      letter: 'Li', live: false },
  { name: 'X',                 domain: 'x.com',             letter: 'X',  live: false },
  { name: 'Pinterest',         domain: 'pinterest.com',     letter: 'P',  live: false },
  { name: 'HubSpot',           domain: 'hubspot.com',       letter: 'HS', live: false },
  { name: 'Snapchat',          domain: 'snapchat.com',      letter: 'SC', live: false },
  { name: 'Reddit Ads',        domain: 'reddit.com',        letter: 'R',  live: false },
  { name: 'Amazon Ads',        domain: 'amazon.com',        letter: 'A',  live: false },
  { name: 'Shopify',           domain: 'shopify.com',       letter: 'S',  live: false },
];
---

<section class="py-28" aria-labelledby="integrations-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 id="integrations-heading" class="reveal text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--text-primary)] tracking-[-0.03em]">
        Connects to everything. Already.
      </h2>
      <p class="reveal mt-5 text-lg text-[var(--text-tertiary)] leading-relaxed">
        One integration to rule your entire ad stack. No more tab-switching.
      </p>
    </div>

    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-3">
      {platforms.map((platform) => (
        <div class={`reveal glass hover-glow flex flex-col items-center gap-2.5 p-4 rounded-xl transition-all duration-200 ${!platform.live ? 'opacity-50' : ''}`}>
          <div class="logo-wrap w-12 h-12 rounded-xl overflow-hidden bg-white border border-[var(--border)] shadow-sm flex items-center justify-center">
            <img
              src={`https://cdn.brandfetch.io/${platform.domain}/w/128/h/128?c=1idBMgJ4tRFpVJGkCUM`}
              alt={platform.name}
              width="48"
              height="48"
              loading="lazy"
              class="logo-img w-full h-full object-contain p-1"
              data-fallback={platform.letter}
            />
            <span class="logo-fallback hidden w-full h-full items-center justify-center text-sm font-bold text-[var(--text-tertiary)]">{platform.letter}</span>
          </div>
          <span class="text-[11px] text-[var(--text-tertiary)] font-medium text-center leading-tight">{platform.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  html.dark .logo-wrap {
    background: var(--surface-raised);
    border-color: var(--border);
  }
</style>

<script>
  document.querySelectorAll('.logo-img').forEach((img) => {
    img.addEventListener('error', function (this: HTMLImageElement) {
      this.classList.add('hidden');
      const fallback = this.nextElementSibling as HTMLElement | null;
      if (fallback) fallback.classList.replace('hidden', 'flex');
    });
  });
</script>
