---
import { pricingPlans } from '../data/pricing';

interface Props {
  mode?: 'marketing' | 'billing';
  currentPlan?: string;
  recommendedPlan?: string;
}

const {
  mode = 'marketing',
  currentPlan = '',
  recommendedPlan = '',
} = Astro.props;

const isBillingMode = mode === 'billing';
const sourcePage = Astro.url.pathname === '/'
  ? 'home'
  : Astro.url.pathname.replace(/^\/|\/$/g, '') || 'home';

const getDemoHref = (planName: string) => {
  const params = new URLSearchParams({
    source_page: sourcePage,
    cta: 'pricing-plan',
    plan: planName,
  });

  return `/book-demo?${params.toString()}#book-demo-form`;
};

/**
 * Tone → token map.
 *
 * The amber/blue/violet tones were raw Tailwind 100/700 steps built for a white
 * page. On the dark-first ground they rendered pale pastel chips, and — worse —
 * they made four plans carry four different brand colours in a direction that
 * has exactly ONE accent. Every tone now resolves to structure (surface-alt +
 * tertiary text); the accent is spent only on the highlighted plan, which is
 * the one genuine brand moment on this card set.
 *
 * The emerald row was already tokenised through --pos and is unchanged: green
 * is the "gains" semantic here, and the Starter plan's tone is the one place
 * that reading is intended.
 */
const NEUTRAL_TONE = {
  wrap: 'bg-[var(--surface-alt)] text-[var(--text-tertiary)]',
  icon: 'text-[var(--text-tertiary)]',
  border: 'border-[var(--border)]',
  button: 'btn-secondary',
  badge: 'bg-[var(--text-primary)] text-[var(--surface)]',
};

const toneClasses: Record<string, { wrap: string; icon: string; border: string; button: string; badge: string }> = {
  emerald: {
    wrap: 'bg-[var(--pos-tint)] text-[var(--pos)]',
    icon: 'text-[var(--pos)]',
    border: 'border-[var(--pos-line)]',
    button: 'btn-secondary',
    badge: 'bg-[var(--pos)] text-[var(--surface)]',
  },
  // The highlighted plan. Accent border, accent fill on the CTA, accent badge —
  // label colour comes from --acc-btn-fg so the neon green accent flips it to
  // near-black instead of shipping white-on-neon at 1.62:1.
  amber: {
    wrap: 'bg-[var(--acc-tint)] text-[var(--acc)]',
    icon: 'text-[var(--acc)]',
    border: 'border-[var(--acc)]',
    button: 'bg-[var(--acc-btn)] text-[var(--acc-btn-fg)] hover:bg-[var(--acc-btn-h)]',
    badge: 'bg-[var(--acc-btn)] text-[var(--acc-btn-fg)]',
  },
  blue: NEUTRAL_TONE,
  violet: NEUTRAL_TONE,
};

const getPlanState = (planName: string) => {
  if (isBillingMode && planName === currentPlan) {
    return {
      badge: 'CURRENT',
      badgeClass: 'bg-[var(--text-primary)] text-[var(--surface)]',
      borderClass: 'border-[var(--text-primary)]',
      isCurrent: true,
    };
  }

  if (isBillingMode && planName === recommendedPlan) {
    return {
      badge: 'RECOMMENDED',
      badgeClass: 'bg-[var(--acc-btn)] text-[var(--acc-btn-fg)]',
      borderClass: 'border-[var(--acc)]',
      isCurrent: false,
    };
  }

  return {
    badge: '',
    badgeClass: '',
    borderClass: '',
    isCurrent: false,
  };
};
---

<div class="reveal pricing-cards" data-pricing-cards>
  <div class="mb-10 flex flex-wrap items-center gap-3" role="group" aria-label="Billing frequency">
    <button
      type="button"
      class="pricing-billing-button is-active"
      data-billing-option="monthly"
      aria-pressed="true"
    >
      Monthly
    </button>
    <button
      type="button"
      class="pricing-billing-button"
      data-billing-option="annual"
      aria-pressed="false"
    >
      Annual
    </button>
    <span class="rounded-[3px] bg-[var(--pos-tint)] border border-[var(--pos-line)] px-4 py-2 text-sm font-bold text-[var(--pos)]">Save 20%</span>
  </div>

  <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
    {pricingPlans.map((plan) => {
      const tone = toneClasses[plan.tone] ?? toneClasses.blue;
      const state = getPlanState(plan.name);
      const badge = state.badge || (!isBillingMode ? plan.badge : '');
      const badgeClass = state.badgeClass || tone.badge;
      const borderClass = state.borderClass || (plan.highlighted && !isBillingMode ? tone.border : 'border-[var(--border)]');
      const ctaText = state.isCurrent ? 'Current plan' : plan.cta.text;
      const ctaClass = state.isCurrent
        ? 'border border-[var(--border)] bg-[var(--surface)] text-[var(--text-muted)] cursor-default'
        : (isBillingMode && plan.name === recommendedPlan
          ? 'bg-[var(--acc-btn)] text-[var(--acc-btn-fg)] hover:bg-[var(--acc-btn-h)]'
          : tone.button);

      return (
        <article class={`relative flex min-h-full flex-col rounded-lg border bg-[var(--surface-raised)] p-6 ${borderClass}`}>
          {badge && (
            <div class="absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/2">
              <span class={`rounded-[2px] px-3 py-1 text-[10px] font-black uppercase tracking-[0.12em] ${badgeClass}`}>{badge}</span>
            </div>
          )}

          <div class="flex items-center gap-3">
            <div class={`flex h-11 w-11 items-center justify-center rounded-full ${tone.wrap}`}>
              {plan.icon === 'building' && (
                <svg class={`h-5 w-5 ${tone.icon}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16" />
                  <path d="M16 8h2a2 2 0 0 1 2 2v11" />
                  <path d="M8 7h4M8 11h4M8 15h4" />
                </svg>
              )}
              {plan.icon === 'trend' && (
                <svg class={`h-5 w-5 ${tone.icon}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="m3 17 6-6 4 4 8-8" />
                  <path d="M14 7h7v7" />
                </svg>
              )}
              {plan.icon === 'chart' && (
                <svg class={`h-5 w-5 ${tone.icon}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M4 19V5" />
                  <path d="M4 19h16" />
                  <path d="M8 16v-5" />
                  <path d="M12 16V8" />
                  <path d="M16 16v-7" />
                </svg>
              )}
              {plan.icon === 'crown' && (
                <svg class={`h-5 w-5 ${tone.icon}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="m3 8 4 4 5-7 5 7 4-4-2 11H5L3 8Z" />
                  <path d="M5 19h14" />
                </svg>
              )}
            </div>
            <h3 class="text-xl font-black text-[var(--text-primary)]">{plan.name}</h3>
          </div>

          <p class="mt-4 min-h-10 text-sm font-medium leading-relaxed text-[var(--text-tertiary)]">{plan.description}</p>

          <div class="mt-5 flex flex-wrap items-end gap-x-2 gap-y-1">
            <span
              class="num whitespace-nowrap text-[2rem] font-black leading-none text-[var(--text-primary)]"
              data-plan-price
              data-monthly-price={plan.price}
              data-annual-price={plan.annualPrice}
            >
              {plan.price}
            </span>
            <span class="mb-0.5 whitespace-nowrap text-base font-medium text-[var(--text-tertiary)]">{plan.period}</span>
          </div>

          <p class="mt-3 text-sm font-bold text-[var(--text-secondary)]">{plan.spend}</p>

          <div class="mt-5 grid grid-cols-3 gap-1.5">
            {plan.quotas.map((quota) => (
              <div class="min-w-0 rounded-[3px] border border-[var(--border)] bg-[var(--surface-alt)] px-1.5 py-3 text-center">
                <div class={`num mx-auto min-h-5 max-w-full leading-none text-[var(--text-primary)] ${quota.value === 'Unlimited' ? 'text-[13px] font-black' : 'text-base font-black'}`}>
                  {quota.value}
                </div>
                <div class="mx-auto mt-1 max-w-full text-[9px] font-bold uppercase leading-tight tracking-[0.02em] text-[var(--text-tertiary)]">
                  {quota.label}
                </div>
              </div>
            ))}
          </div>

          {state.isCurrent ? (
            <button
              type="button"
              class={`mt-5 inline-flex h-12 w-full items-center justify-center rounded-lg text-base font-bold transition-colors ${ctaClass}`}
              disabled
            >
              {ctaText}
            </button>
          ) : (
            <a
              href={getDemoHref(plan.name)}
              class={`mt-5 inline-flex h-12 w-full items-center justify-center rounded-lg text-base font-bold transition-colors ${ctaClass}`}
              data-plan-cta
            >
              {ctaText}
              {plan.name === 'Enterprise' && (
                <svg class="ml-2 h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M7 17 17 7" />
                  <path d="M7 7h10v10" />
                </svg>
              )}
            </a>
          )}

          <ul class="mt-6 space-y-3" role="list">
            {plan.features.map((feature) => (
              <li class="flex gap-3 text-sm font-medium leading-relaxed text-[var(--text-secondary)]">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-[var(--pos)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="m5 12 4 4L19 6" />
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-7 space-y-3">
          </div>
        </article>
      );
    })}
  </div>
</div>

<style>
  .pricing-billing-button {
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.6rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--text-secondary);
    background: var(--surface);
    transition: background 0.16s, color 0.16s, border-color 0.16s;
  }
  .pricing-billing-button:hover { background: var(--surface-alt); color: var(--text-primary); }
  .pricing-billing-button.is-active {
    background: var(--text-primary);
    color: var(--surface);
    border-color: var(--text-primary);
  }
</style>

<script>
  document.querySelectorAll('[data-pricing-cards]').forEach((pricingRoot) => {
    const buttons = Array.from(pricingRoot.querySelectorAll('[data-billing-option]'));
    const prices = Array.from(pricingRoot.querySelectorAll('[data-plan-price]'));

    const setBilling = (billing: string) => {
      buttons.forEach((button) => {
        const isActive = button.getAttribute('data-billing-option') === billing;
        button.setAttribute('aria-pressed', String(isActive));
        // One class, styled from tokens below. The old version toggled four
        // literal Tailwind greys, which is how the inactive state ended up
        // slate-600 on a navy ground.
        button.classList.toggle('is-active', isActive);
      });

      prices.forEach((price) => {
        const nextValue = price.getAttribute(billing === 'annual' ? 'data-annual-price' : 'data-monthly-price');
        if (nextValue) price.textContent = nextValue;
      });
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => setBilling(button.getAttribute('data-billing-option') || 'monthly'));
    });
  });
</script>
