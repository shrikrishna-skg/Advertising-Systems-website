---
interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  items: BreadcrumbItem[];
}

// Home is rendered once below, even when callers include it.
const items = Astro.props.items.filter((item) => item.href !== '/');
if (items.length === 0) return null;
---

<!-- Width tracks `.terminal .wrap` (1240px / 28px gutter), not max-w-7xl — the
     crumb sat wider than the content it labelled on every interior page. -->
<nav class="border-b border-[var(--border)] bg-[var(--surface-alt)]" aria-label="Breadcrumb">
  <div class="wrap py-3">
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-medium text-[var(--text-tertiary)]" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" class="hover:text-[var(--color-link)] transition-colors" itemprop="item">
          <span itemprop="name">Home</span>
        </a>
        <meta itemprop="position" content="1" />
      </li>
      {items.map((item, i) => (
        <li class="flex items-center gap-x-2 min-w-0" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="text-[var(--text-faint)] font-medium" aria-hidden="true">/</span>
          {i === items.length - 1 ? (
            <span class="font-semibold text-[var(--text-primary)] truncate max-w-[min(60vw,20rem)] sm:max-w-none" itemprop="name">{item.name}</span>
          ) : (
            <a href={item.href} class="hover:text-[var(--color-link)] transition-colors font-medium" itemprop="item">
              <span itemprop="name">{item.name}</span>
            </a>
          )}
          <meta itemprop="position" content={String(i + 2)} />
        </li>
      ))}
    </ol>
  </div>
</nav>
