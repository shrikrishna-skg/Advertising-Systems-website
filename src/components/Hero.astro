---
/**
 * Terminal hero — Wave 1.2.
 *
 * Replaces the React <AnimatedHero client:load>: the rotating headline is now
 * CSS-only with all four words server-rendered, which kills the client bundle
 * AND closes the crawler gap (the old version hid the headline behind
 * hydration, so bots and LLMs never read it).
 *
 * PROVENANCE — playbook honesty rule 1. Every number on this screen is
 * illustrative and is labelled as such in two places: the blotter header and
 * the caption under the KPI strip. (A third tag pinned to the ticker was
 * removed 2026-08-16 by owner ruling — it overlapped the scrolling items;
 * the two remaining labels carry the disclosure.) The only real figures on
 * the homepage live in <VerifiedCase />, which links from here.
 */
const ticker = [
  { ch: 'EXPEDIA', metric: 'ROAS', value: '5.7×', dir: 'up' },
  { ch: 'BOOKING.COM', metric: 'ROAS', value: '3.4×', dir: 'up' },
  { ch: 'GOOGLE ADS', metric: 'ROAS', value: '6.1×', dir: 'up' },
  { ch: 'META', metric: 'ROAS', value: '2.8×', dir: 'up' },
  { ch: 'MICROSOFT ADS', metric: 'ROAS', value: '1.9×', dir: 'dn' },
  { ch: 'REDDIT', metric: 'ROAS', value: '1.6×', dir: 'dn' },
  { ch: 'PORTFOLIO', metric: 'WASTE', value: '−38%', dir: 'up' },
];

/* Channel order is fixed family-wide: Expedia · Booking · Google · Meta ·
   Microsoft · Reddit. Booking.com and Reddit are early access — they carry the
   same "Early access" marker here as in the channel grid, so the two sections
   can never contradict each other. */
const positions = [
  { channel: 'Expedia TravelAds', spend: '$14,900', roas: '5.7×', delta: '+1.4', dir: 'up' },
  { channel: 'Booking.com', spend: '$9,480', roas: '3.4×', delta: 'Early access', dir: 'soon' },
  { channel: 'Google Ads', spend: '$18,400', roas: '6.1×', delta: '+0.9', dir: 'up' },
  { channel: 'Meta Ads', spend: '$11,250', roas: '2.8×', delta: '+0.3', dir: 'up' },
  { channel: 'Microsoft Ads', spend: '$3,120', roas: '1.9×', delta: '−0.2', dir: 'dn' },
  { channel: 'Reddit Ads', spend: '$1,640', roas: '1.6×', delta: 'Early access', dir: 'soon' },
];

const kpis = [
  { v: '4.6×', l: 'Blended ROAS', d: '+142% vs. baseline' },
  { v: '$12.40', l: 'Cost per acquisition', d: '−31% in 47 days' },
  { v: '2,847', l: 'Conversions', d: 'Across 6 channels' },
  { v: '−38%', l: 'Wasted spend', d: 'Reallocated, not cut' },
];
---

<!-- TICKER -->
<div class="ticker">
  <div class="ticker-track" aria-hidden="true">
    {[0, 1].map(() => ticker.map(({ ch, metric, value, dir }) => (
      <span class="tick"><b>{ch}</b> <span>{metric}</span> <span class={dir}>{value}</span></span>
    )))}
  </div>
</div>

<section class="hero" aria-labelledby="hero-heading">
  <div class="wrap">
    <div class="hero-top">
      <div>
        <span class="badge-line"><i aria-hidden="true"></i> AI advertising management — a Multisystems company</span>

        <h1 id="hero-heading">
          Your ads should
          <span class="rotator">
            <span>make money.</span>
            <span>reach further.</span>
            <span>scale smarter.</span>
            <span>save you time.</span>
          </span>
        </h1>

        <p class="lead">
          Your ad spend is a portfolio. Advertising Systems puts Expedia, Booking.com, Google,
          Meta, Microsoft and Reddit on one screen — then works the budget every fifteen minutes
          so nothing bleeds overnight.
        </p>

        <div class="cta-row">
          <a class="btn btn-p" href="/book-demo">
            Book a demo
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M13.5 4.5L21 12l-7.5 7.5M21 12H3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="btn btn-l" href="/pricing">See pricing</a>
        </div>
        <p class="fine">Secure signup · Guided onboarding · Cancel anytime</p>
      </div>

      <div class="blotter">
        <div class="blotter-hd">
          <h2>Channel positions — last 30 days</h2>
          <a class="illus" href="#case" title="Jump to the verified single-channel export">Illustrative — see real data ↓</a>
        </div>
        <table class="pos">
          <thead>
            <tr><th>Channel</th><th class="r">Spend</th><th class="r">ROAS</th><th class="r">Δ</th></tr>
          </thead>
          <tbody>
            {positions.map(({ channel, spend, roas, delta, dir }) => (
              <tr>
                <td class="ch">{channel}</td>
                <td class="r num">{spend}</td>
                <td class="r num">{roas}</td>
                <td class={`r ${dir}`}>{delta}</td>
              </tr>
            ))}
            <tr>
              <td class="ch">Portfolio</td>
              <td class="r num">$58,790</td>
              <td class="r num">4.6×</td>
              <td class="r"><span class="bar-mini"><i style="width:76%"></i></span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="kpis">
      {kpis.map(({ v, l, d }) => (
        <div class="kpi">
          <div class="v num">{v}</div>
          <div class="l">{l}</div>
          <div class="d">{d}</div>
        </div>
      ))}
    </div>
    <p class="fine kpi-note">
      Illustrative portfolio figures, not company averages or a forecast.
      The only verified numbers on this page are the platform export in
      <a href="#case">section 04</a>.
    </p>
  </div>
</section>

<style>
  /* -- ticker -- */
  .ticker {
    display: flex;
    align-items: stretch;
    background: var(--footer-bg);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  /* Pinned, does not scroll: a market ticker reads as a live feed, so the
     label has to be on screen at all times, not once per 48s loop. */
  .ticker-track {
    display: flex;
    width: max-content;
    animation: ticker-slide 48s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }
  @keyframes ticker-slide { to { transform: translateX(-50%); } }
  .tick {
    display: flex; align-items: center; gap: 9px;
    padding: 9px 26px;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 12px; white-space: nowrap;
  }
  .tick b { color: #fff; font-weight: 700; font-size: 11.5px; letter-spacing: 0.06em; }
  .tick span { color: var(--footer-text-muted); }
  .tick .up { color: var(--pos); font-weight: 700; }
  .tick .dn { color: #F0705C; font-weight: 700; }

  /* -- hero ground: a ruled grid, not a glow -- */
  .hero {
    padding: 64px 0 0;
    background:
      linear-gradient(var(--dot-grid-color) 1px, transparent 1px) 0 0 / 100% 34px,
      linear-gradient(90deg, var(--dot-grid-color) 1px, transparent 1px) 0 0 / 34px 100%,
      var(--surface-alt);
    border-bottom: 1px solid var(--border);
  }
  .hero-top {
    display: grid;
    grid-template-columns: 1.02fr 0.98fr;
    gap: 56px;
    align-items: end;
    padding-bottom: 46px;
  }

  /* -- rotating headline, ported from Multisystems globals.css .rotator --
     Every word is in the DOM and server-rendered, so crawlers and LLMs read
     all four. Grid-stacking keeps the block as tall as the longest word, so
     nothing reflows. Sequential, no crossfade: each word is fully out at 25%,
     exactly when the next word's delay slot opens. */
  .rotator { display: grid; min-height: 1.22em; }
  .rotator > span {
    grid-area: 1 / 1;
    /* --acc-btn, not --acc: the headline should be the same saturated red as
       the primary button (owner call). --acc lightens to rose-400 in dark
       because SMALL accent text fails AA at #E11D48 on dark — but the rotator
       is display text (36-60px/800), where AA large is 3.0:1 and #E11D48
       measures 3.92:1 on the hero ground. Do not copy this to any small use. */
    color: var(--acc-display, var(--acc-btn));
    overflow-wrap: break-word;
    opacity: 0;
    transform: translateY(12px);
    animation: as-rotate 10s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }
  /* Fallback: if the animation never runs — reduced motion, an old engine, a
     prerender or screenshot pass that freezes CSS animations — every word would
     sit at opacity 0 and the headline would vanish. Word one stays visible by
     default; a running animation outranks a normal declaration in the cascade,
     so this costs nothing when things work. */
  .rotator > span:first-child { opacity: 1; transform: none; }
  .rotator > span:nth-child(1) { animation-delay: 0s; }
  .rotator > span:nth-child(2) { animation-delay: 2.5s; }
  .rotator > span:nth-child(3) { animation-delay: 5s; }
  .rotator > span:nth-child(4) { animation-delay: 7.5s; }
  @keyframes as-rotate {
    0%   { opacity: 0; transform: translateY(12px); }
    4%   { opacity: 1; transform: translateY(0); }
    21%  { opacity: 1; transform: translateY(0); }
    25%  { opacity: 0; transform: translateY(-12px); }
    100% { opacity: 0; transform: translateY(-12px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .rotator > span { animation: none; }
    .rotator > span:first-child { opacity: 1; transform: none; }
  }

  /* -- position blotter -- */
  /* The table is allowed to be wider than the phone; the PAGE is not.
     Without this the blotter set document width at 390px and clipped the hero
     copy off the right edge — content loss, not just a scrollbar. */
  .blotter { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .blotter table.pos { min-width: 460px; }
  .blotter {
    border: 1px solid var(--border);
    background: var(--surface-raised);
    border-radius: 4px;
    overflow: hidden;
  }
  .blotter-hd {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 11px 14px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-alt);
  }
  .blotter-hd h2 {
    font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--text-secondary);
  }
  table.pos { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  table.pos th {
    text-align: left; font-size: 9.5px; font-weight: 700; letter-spacing: 0.11em;
    text-transform: uppercase; color: var(--text-tertiary);
    padding: 9px 14px; border-bottom: 1px solid var(--border);
  }
  table.pos th.r, table.pos td.r { text-align: right; }
  table.pos td { padding: 10px 14px; border-bottom: 1px solid var(--border); }
  table.pos tbody tr:last-child td { border-bottom: 0; background: var(--surface-alt); }
  table.pos .ch { font-weight: 700; color: var(--text-primary); }
  table.pos .up { color: var(--pos); font-weight: 700; }
  table.pos .dn { color: var(--neg); font-weight: 700; }
  table.pos .soon { color: var(--warn); font-weight: 700; font-size: 11px; }
  .bar-mini {
    height: 4px; border-radius: 2px; background: var(--border);
    overflow: hidden; width: 56px; display: inline-block; vertical-align: middle;
  }
  .bar-mini i { display: block; height: 100%; background: var(--acc); font-style: normal; }

  /* -- KPI strip -- */
  .kpis { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--border); }
  .kpi { padding: 20px 0 24px; border-right: 1px solid var(--border); }
  .kpi:last-child { border-right: 0; }
  .kpi:not(:first-child) { padding-left: 22px; }
  .kpi .v {
    font-size: clamp(26px, 3vw, 36px); font-weight: 800;
    letter-spacing: -0.035em; line-height: 1; color: var(--text-primary);
  }
  .kpi .l {
    margin-top: 7px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.11em;
    text-transform: uppercase; color: var(--text-tertiary);
  }
  .kpi .d { font-size: 12px; font-weight: 700; color: var(--pos); margin-top: 4px; }
  .kpi-note { padding-bottom: 26px; }
  .kpi-note a { color: var(--acc); font-weight: 600; }

  @media (max-width: 1000px) {
    .hero-top { grid-template-columns: 1fr; gap: 36px; align-items: start; }
  }
  @media (max-width: 640px) {
    .kpis { grid-template-columns: repeat(2, 1fr); }
    .kpi {
      border-bottom: 1px solid var(--border);
      padding-left: 0 !important;
      padding-inline: 14px;
    }
    .kpi:nth-child(2n) { border-right: 0; }
  }
</style>
