---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found — Advertising Systems"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <Navbar />
  <main class="terminal">
    <section class="sec nf">
      <div class="wrap">
        <span class="eyebrow">Error 404</span>
        <h1>Page not found.</h1>
        <p class="lead">
          This URL doesn't exist or has moved. The three places most people are heading are below.
        </p>
        <div class="cta-row">
          <a class="btn btn-p" href="/">Homepage</a>
          <a class="btn btn-l" href="/faq">FAQ</a>
          <a class="btn btn-l" href="/knowledge-base">Knowledge base</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <style>
    .nf { min-height: 58vh; display: flex; align-items: center; }
    .nf .eyebrow { display: block; margin-bottom: 14px; }
  </style>
</Layout>
