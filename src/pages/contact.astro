---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import FAQSection from '../components/FAQSection.astro';
import { contactFaqs } from '../data/page-faqs';

/**
 * Contact — Wave 3, Terminal conversion.
 *
 * HONESTY PASS: the old page listed "+1-800-ADV-SYS1" and a "San Francisco, CA"
 * office card. Neither is verifiable anywhere in the repo or the family sites
 * (ReputationSystems publishes +1 615 900-0224 — a different, real number), so
 * both are removed rather than restyled. The published email is now
 * contact@multisystems.ai — the address the mail system actually sends from and
 * tells users to reply to (src/lib/intake-confirmation-email.ts). Owner can
 * restore a phone/office card with real details any time.
 */
const breadcrumbs = [{ name: 'Contact', href: '/contact' }];
const CONTACT_EMAIL = 'contact@multisystems.ai';
---

<Layout
  title="Contact — Advertising Systems | Get in Touch"
  description="Reach out to the Advertising Systems team. We'd love to hear from you — whether you have a question, need support, or want to learn more."
  breadcrumbs={breadcrumbs}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact Advertising Systems',
    url: 'https://advertisingsystems.ai/contact',
    mainEntity: {
      '@type': 'Organization',
      name: 'Advertising Systems',
      email: CONTACT_EMAIL,
      url: 'https://advertisingsystems.ai'
    }
  }}
>
  <Navbar />
  <main class="terminal">
    <PageHero
      badge="We're here to help"
      title="Get in"
      titleAccent="touch."
      lead="Have a question, need support, or want to see how Advertising Systems fits your accounts? Send a message — we read every one and reply as soon as we can."
    />

    <!-- 01 · Message + channels -->
    <section class="sec" aria-labelledby="contact-form-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div><h2 id="contact-form-heading">Send us a message.</h2></div>
        </div>

        <div class="contact-grid">
          <div class="panel-box">
            <div class="panel-hd"><h3>Message</h3></div>
            <form id="contact-form" action="/api/contact" method="POST" class="c-form" aria-label="Contact form">
              <div class="c-row2">
                <div>
                  <label for="name">Name</label>
                  <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your full name" />
                </div>
                <div>
                  <label for="email">Email</label>
                  <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@company.com" />
                </div>
              </div>
              <div class="c-row2">
                <div>
                  <label for="company">Company</label>
                  <input type="text" id="company" name="company" autocomplete="organization" placeholder="Your company name" />
                </div>
                <div>
                  <label for="phone">Phone</label>
                  <input type="tel" id="phone" name="phone" autocomplete="tel" placeholder="+1 (555) 000-0000" />
                </div>
              </div>
              <div>
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="5" required placeholder="Tell us how we can help..."></textarea>
              </div>
              <div class="c-honeypot" aria-hidden="true">
                <label for="contact-website">Website</label>
                <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
              </div>
              <div id="contact-message" class="c-alert" role="alert" hidden></div>
              <button type="submit" id="contact-submit" class="btn btn-p">
                Send message
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M13.5 4.5L21 12l-7.5 7.5M21 12H3" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </form>
          </div>

          <div class="c-side">
            <div class="panel-box">
              <div class="panel-hd"><h3>Direct</h3></div>
              <div class="c-side-bd">
                <a class="c-line" href={`mailto:${CONTACT_EMAIL}`}>
                  <span class="c-k">Email</span>
                  <span class="c-v">{CONTACT_EMAIL}</span>
                </a>
                <a class="c-line" href="/book-demo">
                  <span class="c-k">Demo</span>
                  <span class="c-v">Book a 30-minute walkthrough →</span>
                </a>
                <a class="c-line" href="/faq">
                  <span class="c-k">FAQ</span>
                  <span class="c-v">Quick answers to common questions →</span>
                </a>
              </div>
            </div>

            <div class="panel-box">
              <div class="panel-hd"><h3>What happens next</h3></div>
              <div class="c-side-bd">
                <ol class="c-steps">
                  <li>Your message lands with the team and gets a reply from {CONTACT_EMAIL} — from a person, not an autoresponder.</li>
                  <li>For demo requests we suggest a time that works for you.</li>
                  <li>No mailing lists, no drip sequence — you wrote to us, we write back.</li>
                </ol>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={contactFaqs} name="contact-faq" />
  </main>
  <Footer />

  <style>
    .contact-grid {
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      gap: 18px;
      align-items: start;
    }

    .c-form { padding: 18px 16px; display: grid; gap: 14px; }
    .c-row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .c-form label {
      display: block;
      font-size: 10.5px; font-weight: 700; letter-spacing: 0.11em;
      text-transform: uppercase; color: var(--text-tertiary);
      margin-bottom: 6px;
    }
    .c-form input, .c-form textarea {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid var(--border);
      border-radius: 3px;
      background: var(--surface);
      color: var(--text-primary);
      font-family: inherit;
      font-size: 14.5px;
      transition: border-color 0.15s;
      resize: none;
    }
    .c-form input::placeholder, .c-form textarea::placeholder { color: var(--text-faint); }
    .c-form input:focus, .c-form textarea:focus {
      outline: none;
      border-color: var(--acc);
    }
    .c-form .btn { justify-self: start; }
    .c-honeypot { display: none; }
    .c-alert {
      font-size: 13.5px; font-weight: 600;
      border: 1px solid var(--border); border-radius: 3px;
      padding: 10px 12px;
    }
    .c-alert.ok { color: var(--pos); border-color: var(--pos); background: var(--pos-tint); }
    .c-alert.err { color: var(--neg); border-color: var(--neg); background: var(--neg-tint); }

    .c-side { display: grid; gap: 18px; }
    .c-side-bd { padding: 6px 0; }
    .c-line {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 12px;
      padding: 12px 16px;
      text-decoration: none;
      border-bottom: 1px solid var(--border);
    }
    .c-line:last-child { border-bottom: 0; }
    .c-line:hover .c-v { color: var(--acc); }
    .c-k {
      font-size: 10px; font-weight: 700; letter-spacing: 0.11em;
      text-transform: uppercase; color: var(--text-tertiary);
      padding-top: 2px;
    }
    .c-v { font-size: 14px; font-weight: 600; color: var(--text-primary); transition: color 0.15s; overflow-wrap: anywhere; }

    .c-steps { margin: 0; padding: 6px 16px 14px 32px; }
    .c-steps li { font-size: 13.5px; color: var(--text-secondary); line-height: 1.55; padding: 5px 0; }
    .c-steps li::marker { color: var(--acc); font-weight: 700; }

    @media (max-width: 900px) {
      .contact-grid { grid-template-columns: 1fr; }
      .c-row2 { grid-template-columns: 1fr; }
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      var form = document.getElementById('contact-form');
      var messageEl = document.getElementById('contact-message');
      var submitBtn = document.getElementById('contact-submit');
      if (!form) return;
      function getClientSubmissionId(prefix) {
        if (window.crypto?.randomUUID) return prefix + '-' + window.crypto.randomUUID();
        return prefix + '-' + Date.now() + '-' + Math.random().toString(36).slice(2);
      }
      function getContext(defaultCta) {
        var params = new URLSearchParams(window.location.search);
        var sourcePage = params.get('source_page');
        return {
          landingPage: sourcePage ? (sourcePage.charAt(0) === '/' ? sourcePage : '/' + sourcePage) : window.location.pathname,
          referrer: document.referrer || undefined,
          cta: params.get('cta') || defaultCta,
          posthogDistinctId: window.posthog?.get_distinct_id?.() || undefined,
          utm: {
            source: params.get('utm_source') || undefined,
            medium: params.get('utm_medium') || undefined,
            campaign: params.get('utm_campaign') || undefined,
          },
        };
      }
      function setMessage(text, isError) {
        if (!messageEl) return;
        messageEl.textContent = text;
        messageEl.className = isError ? 'c-alert err' : 'c-alert ok';
        messageEl.hidden = false;
      }
      form.addEventListener('submit', async function(event) {
        event.preventDefault();
        if (submitBtn) submitBtn.disabled = true;
        if (messageEl) messageEl.hidden = true;
        var email = form.querySelector('#email')?.value?.trim();
        var company = form.querySelector('#company')?.value?.trim();
        var payload = {
          name: form.querySelector('#name')?.value?.trim(),
          email: email,
          company: company,
          phone: form.querySelector('#phone')?.value?.trim(),
          message: form.querySelector('#message')?.value?.trim(),
          website: form.querySelector('#contact-website')?.value?.trim(),
          client_submission_id: getClientSubmissionId('contact'),
          context: getContext('Contact Sales'),
        };
        try {
          var analyticsConsent = '';
          try { analyticsConsent = localStorage.getItem('ads_cookie_consent') === 'accepted' ? 'accepted' : ''; } catch (e) {}
          var res = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Analytics-Consent': analyticsConsent,
            },
            body: JSON.stringify(payload),
          });
          var data = await res.json().catch(function() { return {}; });
          if (!res.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
          if (email) window.posthog?.identify(email, { company: company || undefined });
          window.posthog?.capture('contact_form_submitted', {
            has_company: Boolean(company),
            has_phone: Boolean(payload.phone),
            status: 'accepted',
          });
          setMessage(data.message || "Thanks. We've received your message.", false);
          form.reset();
        } catch (error) {
          var message = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
          window.posthog?.capture('contact_form_errored', { error_message: message });
          setMessage(message, true);
        } finally {
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    });
  </script>
</Layout>
