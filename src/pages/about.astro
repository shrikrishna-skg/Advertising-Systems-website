---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQSection from '../components/FAQSection.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import { aboutFaqs } from '../data/page-faqs';

const breadcrumbs = [{ name: 'About', href: '/about' }];

const values = [
  {
    n: '01',
    title: 'Transparency',
    desc: 'No black box. Every automated decision is logged with its reason and its amount, and you can read the log back the next morning.',
  },
  {
    n: '02',
    title: 'Proof over claims',
    desc: 'We publish one reconciled platform export rather than a wall of aggregate numbers nobody can check.',
  },
  {
    n: '03',
    title: 'Data-driven',
    desc: 'Decisions come from the signals in your own connected accounts, not from a benchmark taken from someone else\'s business.',
  },
  {
    n: '04',
    title: 'Customer outcomes',
    desc: 'Every feature has to survive the same question: does this make the next budget decision easier to get right?',
  },
];

/**
 * Sibling products. Both non-Advertising entries previously pointed at
 * multisystems.ai rather than their own canonical hosts, so the family links
 * resolved to the hub instead of the product. Canonical hosts per the family
 * registry: hotelsystems.ai and reputationsystems.ai are APEX (no www DNS);
 * advertisingsystems.ai is www.
 */
const ecosystem = [
  { name: 'HotelSystems', desc: 'Property management and booking optimisation', href: 'https://hotelsystems.ai' },
  { name: 'ReputationSystems', desc: 'Review management and brand monitoring', href: 'https://reputationsystems.ai' },
  { name: 'Advertising Systems', desc: 'AI-powered advertising management', href: '/', active: true },
];
---

<Layout
  title="About — Advertising Systems | Built by Multisystems"
  description="Learn about Advertising Systems, our mission to simplify advertising management, and the Multisystems ecosystem powering businesses worldwide."
  breadcrumbs={breadcrumbs}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Advertising Systems',
    url: 'https://advertisingsystems.ai/about',
    mainEntity: {
      '@type': 'Organization',
      name: 'Advertising Systems',
      parentOrganization: {
        '@type': 'Organization',
        name: 'Multisystems',
        url: 'https://multisystems.ai'
      }
    }
  }}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />

    <PageHero
      badge="Built by Multisystems"
      title="Simplifying advertising"
      titleAccent="for every business."
      lead="One mission: make advertising spend legible. Every channel on one ledger, every automated decision written down, and one verified export instead of a page of claims."
      primaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      secondaryCta={{ text: 'Read the verified case', href: '/case-studies' }}
    />

    <!-- 01 · Mission -->
    <section class="sec" aria-labelledby="mission-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="mission-heading">Why this exists.</h2>
            <p class="sub">
              Advertising should drive growth, not drain the week. Most operators lose budget to
              fragmented tools, manual reconciliation and reporting that cannot be checked.
            </p>
          </div>
        </div>
        <div class="cardgrid cols-2">
          <div>
            <div class="cn">The problem</div>
            <h3>Five platforms, five versions of the truth</h3>
            <p>
              Each channel reports on itself, in its own definitions. Added up, the channels claim more
              conversions than the business actually had — so nobody trusts the total, and the budget
              decision gets made on instinct.
            </p>
          </div>
          <div>
            <div class="cn">The answer</div>
            <h3>One ledger, one set of definitions</h3>
            <p>
              Campaign management, optimisation and attribution reading and writing the same connected
              accounts. Nothing to reconcile between them, because there is only one of them.
            </p>
          </div>
        </div>
        <p class="fine">
          We publish reconciled platform exports rather than aggregate claims — <a href="/case-studies">see the verified case</a>.
        </p>
      </div>
    </section>

    <!-- 02 · Values -->
    <section class="sec soft" aria-labelledby="values-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="values-heading">What we hold to.</h2>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {values.map((value) => (
            <div>
              <div class="cn">{value.n}</div>
              <h3>{value.title}</h3>
              <p>{value.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 03 · Family -->
    <section class="sec" aria-labelledby="ecosystem-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div>
            <h2 id="ecosystem-heading">Part of the Multisystems suite.</h2>
            <p class="sub">
              Advertising Systems is one product in the <a href="https://multisystems.ai">Multisystems</a> family,
              built to share accounts and definitions rather than sit beside each other.
            </p>
          </div>
        </div>
        <div class="cardgrid">
          {ecosystem.map((product) => (
            <a href={product.href} class="eco">
              <h3>{product.name}</h3>
              <p>{product.desc}</p>
              {product.active && <span class="here">You are here</span>}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 · Team -->
    <section class="sec soft" aria-labelledby="vision-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">04</span>
          <div>
            <h2 id="vision-heading">A distributed team with one standard.</h2>
            <p class="sub">
              Engineers, data scientists and operators who have run this work from the other side of the
              dashboard. We are building the tool we wanted while doing that job.
            </p>
          </div>
        </div>
        <p class="fine"><a href="/careers">Open roles →</a></p>
      </div>
    </section>

    <FAQSection title="Common questions about us" faqs={aboutFaqs} name="about-faq" no="05" soft={false} />
    <CTABand />
  </main>
  <Footer />

  <style>
    .sec-hd .sub a { color: var(--acc); font-weight: 600; text-decoration: none; }
    .eco { text-decoration: none; display: block; transition: background 0.15s; }
    a.eco:hover { background: var(--surface-alt); }
    a.eco:hover h3 { color: var(--acc); }
    .eco h3 { transition: color 0.15s; }
    .here {
      display: inline-block; margin-top: 12px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--acc); border: 1px solid var(--acc-line); border-radius: 2px; padding: 2px 6px;
    }
  </style>
</Layout>
