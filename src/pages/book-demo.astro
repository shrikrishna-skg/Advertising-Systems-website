---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FAQSection from '../components/FAQSection.astro';
import { bookDemoFaqs } from '../data/page-faqs';
import { pricingPlans } from '../data/pricing';

/**
 * Book a demo — Wave 3, Terminal conversion.
 * Cal.com embed (shared Multisystems scheduler) inside a Terminal panel;
 * ?plan= context chip preserved for the pricing CTAs.
 */
const CAL_BOOKING_URL = 'https://cal.com/multisystems';
const CAL_EMBED_URL = `${CAL_BOOKING_URL}?embed=1`;

/**
 * COPY, 2026-08-16. Two of these promised things the call does not deliver:
 * "See real data for your industry" implies a benchmark set we do not publish,
 * and "Custom ROI projection for your budget" promises a forecast produced live
 * — the exact kind of number the honesty pass stripped everywhere else.
 * Replaced with the two things we can actually put on screen: the verified
 * Expedia export, and a plan recommendation based on account count and spend.
 */
const benefits = [
  'Personalised walk-through of all 5 modules',
  'The verified 30-day Expedia export, read line by line',
  'Which plan fits your account count and spend',
  'No prep required, and no access to your accounts',
  'Clear next steps after the demo',
];

const coverage = [
  'Google, Meta, and OTA campaigns in one dashboard',
  'How the engine allocates and paces budget inside guardrails',
  'Reporting your team and your owners actually read',
  'Pricing, account count, and the right starting plan',
];

const pathStats = [
  { value: '30 min', label: 'Demo walkthrough' },
  { value: '5 modules', label: 'Covered live' },
  { value: 'Instant', label: 'Calendar confirmation' },
  { value: 'Local', label: 'Slots in your timezone' },
];

const planOptions = pricingPlans.map((plan) => ({
  name: plan.name,
  priceLabel: plan.period === '/month' ? `${plan.price.replace(/\.00$/, '')}/mo` : plan.price,
  description: plan.description,
  spend: plan.spend.replace(/•/g, '·'),
}));
---

<Layout
  title="Book a Demo — Advertising Systems | See It in Action"
  description="Book a 30-minute walkthrough of all five modules: the unified dashboard, how the engine paces budget, and the reporting owners read. No prep and no account access needed."
  breadcrumbs={[{ name: 'Book a Demo', href: '/book-demo' }]}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Book a Demo — Advertising Systems',
    url: 'https://advertisingsystems.ai/book-demo',
    potentialAction: {
      '@type': 'ReserveAction',
      name: 'Book a Demo',
      target: CAL_BOOKING_URL
    }
  }}
>
  <Navbar />
  <main class="terminal">
    <section class="bd-hero" aria-labelledby="demo-hero-heading">
      <div class="wrap bd-grid">

        <!-- Left: what the 30 minutes buys -->
        <div class="bd-left">
          <span class="badge-line"><i aria-hidden="true"></i> Get started in minutes</span>
          <h1 id="demo-hero-heading">Book your <span class="bd-accent">personalized demo.</span></h1>
          <p class="lead">We'll walk you through every module, open the one verified export we publish, and answer your questions. Nothing to connect, nothing to prepare.</p>

          <ul class="bd-benefits" aria-label="Benefits">
            {benefits.map((text) => <li>{text}</li>)}
          </ul>

          <div class="panel-box bd-cover">
            <div class="panel-hd"><h2>What we'll cover</h2></div>
            <ul class="bd-cover-list">
              {coverage.map((text) => <li>{text}</li>)}
            </ul>
          </div>
        </div>

        <!-- Right: scheduler -->
        <div class="bd-right" id="book-demo-form">
          <div id="demo-plan-context" class="panel-box bd-plan" data-plan-context hidden>
            {planOptions.map((plan) => (
              <span
                hidden
                data-plan-option
                data-name={plan.name}
                data-price={plan.priceLabel}
                data-description={plan.description}
                data-spend={plan.spend}
              ></span>
            ))}
            <div class="panel-hd"><h2>Selected from pricing</h2><span class="illus ok">Carried over</span></div>
            <div class="bd-plan-bd">
              <p class="bd-plan-name"><b id="demo-plan-name"></b> <span id="demo-plan-price" class="num"></span></p>
              <p id="demo-plan-summary" class="bd-plan-sum"></p>
              <p class="bd-plan-note">Mention this plan when you book — we'll tailor the walkthrough to it. <a href="/pricing">Compare plans</a></p>
            </div>
          </div>

          <div class="panel-box">
            <div class="panel-hd">
              <h2>Pick a time</h2>
              <a class="bd-newtab" href={CAL_BOOKING_URL} target="_blank" rel="noopener noreferrer">Open in a new tab →</a>
            </div>
            <iframe
              src={CAL_EMBED_URL}
              title="Book an Advertising Systems demo"
              loading="lazy"
              class="bd-frame"
            ></iframe>
          </div>

          <p class="fine">
            Times shown in your own timezone. If the calendar does not load,
            <a href={CAL_BOOKING_URL} target="_blank" rel="noopener noreferrer">book directly on Cal.com</a>.
          </p>
        </div>
      </div>

      <div class="wrap">
        <div class="bd-stats">
          {pathStats.map(({ value, label }) => (
            <div class="bd-stat">
              <div class="v num">{value}</div>
              <div class="l">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={bookDemoFaqs} name="book-demo-faq" />
  </main>
  <Footer />

  <style>
    .bd-hero {
      padding: 56px 0 0;
      background:
        linear-gradient(var(--dot-grid-color) 1px, transparent 1px) 0 0 / 100% 34px,
        linear-gradient(90deg, var(--dot-grid-color) 1px, transparent 1px) 0 0 / 34px 100%,
        var(--surface-alt);
      border-bottom: 1px solid var(--border);
    }
    .bd-grid {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(440px, 1.1fr);
      gap: 48px;
      align-items: start;
      padding-bottom: 46px;
    }
    /* Display-text exception — same rule as the homepage rotator. */
    .bd-accent { color: var(--acc-display, var(--acc-btn)); }

    .bd-benefits { margin: 26px 0 0; padding: 0; list-style: none; }
    .bd-benefits li {
      position: relative;
      padding: 7px 0 7px 26px;
      font-size: 14.5px; color: var(--text-secondary); line-height: 1.5;
    }
    .bd-benefits li::before {
      content: ""; position: absolute; left: 0; top: 14px;
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--pos);
    }

    .bd-cover { margin-top: 26px; }
    .bd-cover-list { margin: 0; padding: 6px 0; list-style: none; }
    .bd-cover-list li {
      position: relative;
      padding: 8px 16px 8px 34px;
      font-size: 13.5px; color: var(--text-secondary); line-height: 1.5;
      border-bottom: 1px solid var(--border);
    }
    .bd-cover-list li:last-child { border-bottom: 0; }
    .bd-cover-list li::before {
      content: ""; position: absolute; left: 16px; top: 15px;
      width: 6px; height: 2px; background: var(--acc);
    }

    .bd-plan { margin-bottom: 18px; }
    .bd-plan-bd { padding: 12px 16px 14px; }
    .bd-plan-name { font-size: 16px; color: var(--text-primary); }
    .bd-plan-name b { font-weight: 800; }
    .bd-plan-name span { font-size: 13px; font-weight: 700; color: var(--text-tertiary); margin-left: 6px; }
    .bd-plan-sum { margin-top: 4px; font-size: 13px; color: var(--text-secondary); line-height: 1.5; }
    .bd-plan-note { margin-top: 8px; font-size: 12px; color: var(--text-tertiary); }
    .bd-plan-note a { color: var(--acc); font-weight: 600; }

    .bd-newtab { font-size: 12.5px; font-weight: 700; color: var(--acc); text-decoration: none; white-space: nowrap; }
    .bd-newtab:hover { text-decoration: underline; }
    .bd-frame { display: block; width: 100%; height: 760px; border: 0; background: var(--surface-raised); }
    @media (min-width: 640px) { .bd-frame { height: 720px; } }
    .fine a { color: var(--acc); font-weight: 600; }

    .bd-stats {
      display: grid; grid-template-columns: repeat(4, 1fr);
      border-top: 1px solid var(--border);
    }
    .bd-stat { padding: 20px 0 24px; border-right: 1px solid var(--border); }
    .bd-stat:last-child { border-right: 0; }
    .bd-stat:not(:first-child) { padding-left: 22px; }
    .bd-stat .v {
      font-size: clamp(22px, 2.4vw, 30px); font-weight: 800;
      letter-spacing: -0.03em; line-height: 1; color: var(--text-primary);
    }
    .bd-stat .l {
      margin-top: 7px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.11em;
      text-transform: uppercase; color: var(--text-tertiary);
    }

    #book-demo-form { scroll-margin-top: calc(var(--t-header-h) + 12px); }

    @media (max-width: 1000px) {
      .bd-grid { grid-template-columns: 1fr; gap: 32px; }
    }
    @media (max-width: 640px) {
      .bd-stats { grid-template-columns: repeat(2, 1fr); }
      .bd-stat { border-bottom: 1px solid var(--border); padding-left: 0 !important; padding-inline: 14px; }
      .bd-stat:nth-child(2n) { border-right: 0; }
    }
  </style>

  <script is:inline>
    /* Carry ?plan= from the pricing CTAs into the scheduler card so the visitor
       still sees which plan they clicked. Cal.com collects the booking itself. */
    (function () {
      var planContextEl = document.getElementById('demo-plan-context');
      var planNameEl = document.getElementById('demo-plan-name');
      var planPriceEl = document.getElementById('demo-plan-price');
      var planSummaryEl = document.getElementById('demo-plan-summary');
      if (!planContextEl) return;

      var requestedPlan = new URLSearchParams(window.location.search).get('plan');
      if (!requestedPlan) return;

      var match = Array.from(document.querySelectorAll('[data-plan-option]')).find(function (option) {
        return (option.getAttribute('data-name') || '').toLowerCase() === requestedPlan.toLowerCase();
      });
      if (!match) return;

      if (planNameEl) planNameEl.textContent = match.getAttribute('data-name') || requestedPlan;
      if (planPriceEl) planPriceEl.textContent = match.getAttribute('data-price') || '';
      if (planSummaryEl) {
        planSummaryEl.textContent = [
          match.getAttribute('data-description') || '',
          match.getAttribute('data-spend') || '',
        ].filter(Boolean).join(' · ');
      }
      planContextEl.hidden = false;

      window.posthog?.capture('demo_plan_context_shown', { plan: match.getAttribute('data-name') || requestedPlan });
    })();
  </script>
</Layout>
