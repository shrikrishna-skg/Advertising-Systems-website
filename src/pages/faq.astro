---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import { faqs } from '../data/faq';

const breadcrumbs = [{ name: 'FAQ', href: '/faq' }];

// FAQPage JSON-LD for the full question list rendered on this page.
const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const categories = [
  {
    title: 'About the Platform',
    indices: [0, 1, 5],
  },
  {
    title: 'AI & Optimization',
    indices: [2, 3],
  },
  {
    title: 'Setup & Security',
    indices: [4, 6, 7],
  },
  {
    title: 'Pricing & Billing',
    indices: [8, 9],
  },
];
---

<Layout
  title="FAQ — Frequently Asked Questions | Advertising Systems"
  description="Quick answers about setup, pricing, AI optimization, integrations, and security. Can't find your question? Contact our team."
  breadcrumbs={breadcrumbs}
  jsonLd={faqPageSchema}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />

    <PageHero
      title="Frequently asked questions."
      lead="Setup, pricing, what the engine is allowed to do, and where your data goes. If the answer you need is not here, ask us directly."
      primaryCta={{ text: 'Talk to our team', href: '/contact' }}
      secondaryCta={{ text: 'Book a demo', href: '/book-demo' }}
    />

    {categories.map((category, ci) => (
      <section class:list={['sec', { soft: ci % 2 === 1 }]} aria-label={category.title}>
        <div class="wrap">
          <div class="sec-hd">
            <span class="no" aria-hidden="true">{String(ci + 1).padStart(2, '0')}</span>
            <div><h2>{category.title}</h2></div>
          </div>
          <div class="faq">
            {category.indices.map((i, qi) => (
              <details name={`faq-${category.title}`} open={ci === 0 && qi === 0}>
                <summary>{faqs[i].question}</summary>
                <p>{faqs[i].answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))}

    <CTABand />
  </main>
  <Footer />
</Layout>
