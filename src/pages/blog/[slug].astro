---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import { getPostBySlug } from '../../data/blog-posts';

const { slug } = Astro.params;
const post = slug ? getPostBySlug(slug) : undefined;

if (!post) {
  return Astro.rewrite('/404');
}

const breadcrumbs = [
  { name: 'Blog', href: '/blog' },
  { name: post.title, href: `/blog/${post.slug}` },
];

const visualBlocks = post.visualBlocks ?? [];
const hasVisualBlocks = visualBlocks.length > 0;
const articleTitle = post.seo?.title ?? `${post.title} — Blog | Advertising Systems`;
const articleDescription = post.seo?.description ?? post.excerpt;
const parsedDate = new Date(post.date);
const datePublished = Number.isNaN(parsedDate.valueOf()) ? post.date : parsedDate.toISOString();
const primaryCta = post.primaryCta ?? { label: 'Book a Demo', href: '/book-demo' };

/**
 * Metric tone. THE BUG: `case 'green'` returned an accent-ramp step and the
 * accent is ROSE — so every `tone: 'green'` metric, including Read time on all
 * 24 posts, rendered dark red. Green is --pos, which is what --pos is for.
 * Blue was a second brand colour this direction does not have; it resolves to
 * structure. (Class names are not spelled out in this comment: Tailwind scans
 * comment text and would re-emit the dead utilities into the bundle.)
 */
const toneText = (tone = 'slate') => {
  switch (tone) {
    case 'green': return 't-pos';
    case 'rose': return 't-neg';
    case 'amber': return 't-warn';
    case 'violet': return 't-acc';
    default: return 't-plain';
  }
};

/** Chip form of the same map — a ruled chip, never a translucent wash. */
const toneBg = (tone = 'slate') => {
  switch (tone) {
    case 'green': return 'chip c-pos';
    case 'rose': return 'chip c-neg';
    case 'amber': return 'chip c-warn';
    case 'violet': return 'chip c-acc';
    default: return 'chip';
  }
};

const externalAttrs = (href: string) => href.startsWith('http')
  ? { target: '_blank', rel: 'noreferrer' }
  : {};
---

<Layout
  title={articleTitle}
  description={articleDescription}
  breadcrumbs={breadcrumbs}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.title,
    description: articleDescription,
    datePublished,
    articleSection: post.category,
    keywords: post.seo?.keywords,
    mainEntityOfPage: `https://advertisingsystems.ai/blog/${post.slug}`,
    author: { '@type': 'Organization', name: post.author.name },
    publisher: { '@type': 'Organization', name: 'Advertising Systems' },
  }}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />
    <!-- See decision-guides.astro — same pre-.terminal double offset. -->
    <article aria-labelledby="post-title">
      <PageHero
        badge={post.learningTrack ?? post.category}
        title={post.title}
        lead={post.excerpt}
        primaryCta={{ text: primaryCta.label, href: primaryCta.href }}
        secondaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      >
        <p class="meta">
          <time datetime={datePublished}>{post.date}</time>
          <span aria-hidden="true">·</span><span>{post.readTime}</span>
          <span aria-hidden="true">·</span><span>{post.author.name}{post.author.role ? `, ${post.author.role}` : ''}</span>
          <span aria-hidden="true">·</span><a href="/blog">All modules</a>
        </p>

        <div class="score">
          <div class="panel-box">
            <div class="panel-hd"><h3>Module scorecard</h3></div>
            {(post.heroStats ?? [
              { label: 'Category', value: post.category, caption: 'Topic area', tone: 'slate' },
              { label: 'Read time', value: post.readTime.replace(' read', ''), caption: 'Fast scan', tone: 'green' },
            ]).map((stat) => (
              <div class="sc-row">
                <div class="sc-t">
                  <span class="sc-l">{stat.label}</span>
                  {stat.caption && <span class="sc-c">{stat.caption}</span>}
                </div>
                <span class={`sc-v num ${toneText(stat.tone)}`}>{stat.value}</span>
              </div>
            ))}
          </div>

          {post.relatedLinks && post.relatedLinks.length > 0 && (
            <div class="panel-box">
              <div class="panel-hd"><h3>Next links</h3></div>
              {post.relatedLinks.map((link) => (
                <a href={link.href} {...externalAttrs(link.href)} class="nx">
                  <span>{link.label}</span><span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </PageHero>

      <div class="wrap">
        {hasVisualBlocks && post.content.length > 0 && (
          <div class="max-w-3xl py-10">
            {post.content.map((section) => (
              <section class="mb-8 last:mb-0">
                {section.title && (
                  <h2 class="text-2xl font-bold text-[var(--text-primary)] tracking-[-0.02em] mb-4">
                    {section.title}
                  </h2>
                )}
                <div class="space-y-4">
                  {section.paragraphs.map((para) => (
                    <p class="text-lg text-[var(--text-secondary)] leading-relaxed">
                      {para}
                    </p>
                  ))}
                </div>
              </section>
            ))}
          </div>
        )}

        {hasVisualBlocks ? (
          <div class="space-y-0">
            {visualBlocks.map((block) => (
              <section class="vb">
                <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-5 mb-7">
                  <div class="max-w-3xl">
                    {block.eyebrow && (
                      <p class="eyebrow eyebrow-b">{block.eyebrow}</p>
                    )}
                    <h2 class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)] tracking-[-0.02em]">{block.title}</h2>
                    {block.body && (
                      <p class="mt-3 text-base sm:text-lg text-[var(--text-tertiary)] leading-relaxed">{block.body}</p>
                    )}
                  </div>
                </div>

                {block.type === 'metric-strip' && (
                  <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--border)]">
                    {(block.metrics ?? []).map((metric) => (
                      <div class="bg-[var(--surface)] p-5 sm:p-6 min-w-0">
                        <p class={`text-3xl font-bold tracking-[-0.03em] ${toneText(metric.tone)}`}>{metric.value}</p>
                        <p class="mt-2 text-sm font-bold text-[var(--text-primary)]">{metric.label}</p>
                        {metric.caption && <p class="mt-1 text-sm text-[var(--text-tertiary)] leading-snug">{metric.caption}</p>}
                      </div>
                    ))}
                  </div>
                )}

                {block.type === 'step-cards' && (
                  <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-4">
                    {(block.steps ?? []).map((step) => (
                      <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5">
                        <div class="flex items-center justify-between gap-4 mb-4">
                          <span class="sl">{step.label}</span>
                          {step.metric && <span class="chip">{step.metric}</span>}
                        </div>
                        <h3 class="text-lg font-bold text-[var(--text-primary)] leading-snug">{step.title}</h3>
                        <p class="mt-3 text-sm text-[var(--text-tertiary)] leading-relaxed">{step.body}</p>
                      </div>
                    ))}
                  </div>
                )}

                {block.type === 'comparison' && (
                  <div class="overflow-hidden rounded-2xl border border-[var(--border)]">
                    <div class="grid sm:grid-cols-[180px_1fr_1fr] bg-[var(--surface-alt)] border-b border-[var(--border)]">
                      <div class="hidden sm:block p-4 text-xs font-bold uppercase tracking-[0.12em] text-[var(--text-muted)]">Signal</div>
                      <div class="p-4 text-xs font-bold uppercase tracking-[0.12em] text-[var(--text-muted)]">Surface read</div>
                      <div class="p-4 text-xs font-bold uppercase tracking-[0.12em] text-[var(--text-muted)]">Better owner read</div>
                    </div>
                    {(block.rows ?? []).map((row) => (
                      <div class="grid sm:grid-cols-[180px_1fr_1fr] border-b border-[var(--border)] last:border-b-0">
                        <div class="p-4 sm:p-5 bg-[var(--surface-alt)]">
                          <p class="text-sm font-bold text-[var(--text-primary)]">{row.label}</p>
                        </div>
                        <div class="p-4 sm:p-5">
                          <p class="text-sm text-[var(--text-tertiary)] leading-relaxed">{row.before}</p>
                        </div>
                        <div class="p-4 sm:p-5 border-t sm:border-t-0 sm:border-l border-[var(--border)]">
                          <p class="text-sm font-semibold text-[var(--text-secondary)] leading-relaxed">{row.after}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {block.type === 'channel-map' && (
                  <div class="grid lg:grid-cols-2 gap-4">
                    {(block.channels ?? []).map((channel) => (
                      <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5">
                        <div class="flex items-start justify-between gap-4">
                          <h3 class="text-lg font-bold text-[var(--text-primary)]">{channel.name}</h3>
                          <span class={`${toneBg(channel.tone)}`}>Channel</span>
                        </div>
                        <div class="mt-5 grid sm:grid-cols-3 gap-px overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--border)]">
                          <div class="bg-[var(--surface)] p-3">
                            <p class="text-[10px] font-bold uppercase tracking-[0.1em] text-[var(--text-muted)]">Job</p>
                            <p class="mt-1 text-sm font-semibold text-[var(--text-secondary)] leading-snug">{channel.role}</p>
                          </div>
                          <div class="bg-[var(--surface)] p-3">
                            <p class="text-[10px] font-bold uppercase tracking-[0.1em] text-[var(--text-muted)]">Signal</p>
                            <p class="mt-1 text-sm font-semibold text-[var(--text-secondary)] leading-snug">{channel.signal}</p>
                          </div>
                          <div class="bg-[var(--surface)] p-3">
                            <p class="text-[10px] font-bold uppercase tracking-[0.1em] text-[var(--text-muted)]">Risk</p>
                            <p class="mt-1 text-sm font-semibold text-[var(--text-secondary)] leading-snug">{channel.risk}</p>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                )}

                {block.type === 'report-preview' && (
                  <div class="panel-box rp p-6 sm:p-8">
                    <div class="grid lg:grid-cols-[1fr_280px] gap-6 items-center">
                      <div>
                        <div class="grid sm:grid-cols-2 gap-px overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--border)] mb-6">
                          {(block.metrics ?? []).map((metric) => (
                            <div class="bg-[var(--surface)] p-4">
                              <p class={`text-2xl font-bold ${toneText(metric.tone)}`}>{metric.value}</p>
                              <p class="mt-1 text-sm font-bold text-[var(--text-primary)]">{metric.label}</p>
                              {metric.caption && <p class="mt-1 text-xs text-[var(--text-tertiary)] leading-snug">{metric.caption}</p>}
                            </div>
                          ))}
                        </div>
                        {block.cta && (
                          <a href={block.cta.href} class="btn btn-p">
                            {block.cta.label}
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                            </svg>
                          </a>
                        )}
                      </div>
                      <div class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-4">
                        <p class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-[0.12em]">Report preview</p>
                        <div class="mt-4 h-28 rounded-lg bg-[var(--surface-alt)] border border-[var(--border)] p-3 flex flex-col justify-between">
                          <div class="flex items-center justify-between gap-3">
                            <span class="h-2.5 w-20 rounded-full bg-[var(--text-tertiary)]"></span>
                            <span class="h-2.5 w-12 rounded-full bg-[var(--acc)]"></span>
                          </div>
                          <div class="space-y-2">
                            <span class="block h-2 rounded-full bg-[var(--warn)] w-11/12"></span>
                            <span class="block h-2 rounded-full bg-[var(--neg)] w-8/12"></span>
                            <span class="block h-2 rounded-full bg-[var(--text-faint)] w-10/12"></span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                {block.type === 'takeaway' && (
                  <div class="panel-box tk">
                    <div class="grid lg:grid-cols-[280px_1fr] gap-6">
                      <div>
                        <p class="eyebrow">Owner takeaway</p>
                        {block.body && <p class="mt-3 text-lg font-semibold text-[var(--text-primary)] leading-relaxed">{block.body}</p>}
                      </div>
                      <div class="grid sm:grid-cols-3 gap-3">
                        {(block.bullets ?? []).map((bullet) => (
                          <div class="rounded-xl border border-[var(--border)] bg-[var(--surface)] p-4">
                            <p class="text-sm font-semibold text-[var(--text-secondary)] leading-relaxed">{bullet}</p>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                )}

                {block.type === 'source-note' && (
                  <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface-alt)] p-5 sm:p-6">
                    {block.links && block.links.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {block.links.map((link) => (
                          <a href={link.href} {...externalAttrs(link.href)} class="nxl">
                            <span class="min-w-0">{link.label}</span>
                            <span aria-hidden="true">-></span>
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                )}
              </section>
            ))}
          </div>
        ) : (
          <div class="max-w-3xl prose-blog">
            {post.content.map((section) => (
              <section class="mb-10">
                {section.title && (
                  <h2 class="text-xl sm:text-2xl font-bold text-[var(--text-primary)] tracking-[-0.02em] mb-4">
                    {section.title}
                  </h2>
                )}
                <div class="space-y-4">
                  {section.paragraphs.map((para) => (
                    <p class="text-[var(--text-secondary)] leading-relaxed">
                      {para}
                    </p>
                  ))}
                </div>
              </section>
            ))}
          </div>
        )}

        <footer class="mt-10 pt-10 border-t border-[var(--border)]">
          <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
            <a
              href="/blog"
              class="inline-flex items-center gap-2 text-[var(--color-link)] font-semibold hover:underline"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
              </svg>
              All modules
            </a>
            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href={primaryCta.href}
                class="btn btn-p"
              >
                {primaryCta.label}
              </a>
              <a
                href="/book-demo"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 btn-secondary font-semibold text-base px-8 py-3.5 rounded-lg"
              >
                Book a Demo
              </a>
            </div>
          </div>
        </footer>
      </div>
    </article>
  </main>
  <Footer />
  <style>
    .meta {
      margin-top: 18px; display: flex; flex-wrap: wrap; gap: 9px;
      font-size: 12.5px; color: var(--text-tertiary);
    }
    .meta a { color: var(--acc); font-weight: 600; text-decoration: none; }

    .score { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 30px; max-width: 62em; }
    @media (max-width: 720px) { .score { grid-template-columns: 1fr; } }
    .sc-row {
      display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
      padding: 11px 14px; border-bottom: 1px solid var(--border);
    }
    .sc-row:last-child { border-bottom: 0; }
    .sc-l { display: block; font-size: 9.5px; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; color: var(--text-tertiary); }
    .sc-c { display: block; margin-top: 3px; font-size: 12px; color: var(--text-tertiary); }
    .sc-v { font-size: 17px; font-weight: 800; color: var(--text-primary); text-align: right; white-space: nowrap; }
    .nx {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 11px 14px; border-bottom: 1px solid var(--border);
      font-size: 13px; font-weight: 600; color: var(--text-secondary); text-decoration: none;
    }
    .nx:last-child { border-bottom: 0; }
    .nx:hover { color: var(--acc); background: var(--surface-alt); }

    .vb { padding: 44px 0; border-top: 1px solid var(--border); }
    .eyebrow-b { display: block; margin-bottom: 10px; }
    .sl { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; color: var(--acc); }

    .chip {
      display: inline-flex; align-items: center;
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--text-tertiary); border: 1px solid var(--border);
      border-radius: 2px; padding: 3px 7px; white-space: nowrap;
    }
    .c-pos { color: var(--pos); border-color: var(--pos-line); }
    .c-neg { color: var(--neg); border-color: var(--neg); }
    .c-warn { color: var(--warn); border-color: var(--warn); }
    .c-acc { color: var(--acc); border-color: var(--acc-line); }

    .t-pos { color: var(--pos) !important; }
    .t-neg { color: var(--neg) !important; }
    .t-warn { color: var(--warn) !important; }
    .t-acc { color: var(--acc) !important; }

    .rp, .tk { padding: 24px; }
    .tk { border-left: 2px solid var(--acc); }
    .nxl {
      display: inline-flex; max-width: 100%; align-items: center; gap: 8px;
      border: 1px solid var(--border); border-radius: 3px;
      background: var(--surface); padding: 7px 12px;
      font-size: 13px; font-weight: 600; color: var(--acc); text-decoration: none;
    }
    .nxl:hover { border-color: var(--acc); }
  </style>
</Layout>
