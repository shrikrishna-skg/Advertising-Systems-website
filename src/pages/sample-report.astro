---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Sample Performance Report — See Exactly What You Get | AdvertisingSystems"
  description="A real monthly report from Best Western Davison Inn. $432 ad spend → $9,525 revenue → 22:1 ROAS. See every metric, chart, and AI recommendation your property receives every month."
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-[#0a2547] via-[#133b73] to-[#1d68b5] pt-28 pb-16 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute right-[-10%] top-[-10%] w-[600px] h-[600px] rounded-full bg-white/5"></div>
      <div class="absolute left-[-5%] bottom-[-15%] w-[400px] h-[400px] rounded-full bg-blue-400/10"></div>
    </div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 border border-white/20 text-white text-xs font-bold uppercase tracking-widest mb-6 backdrop-blur-sm">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
        Real Client Report · April 2026
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight tracking-tight mb-6">
        This is what your<br/>monthly report looks like
      </h1>
      <p class="text-lg sm:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed mb-10">
        Every property we manage gets a report like this — every month. Real numbers, real charts, real AI recommendations. No fluff.
      </p>

      <!-- Key stats bar -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto mb-10">
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-bold text-white">$432</div>
          <div class="text-xs text-white/70 font-semibold mt-1 uppercase tracking-wider">Ad Spend</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-bold text-white">$9,525</div>
          <div class="text-xs text-white/70 font-semibold mt-1 uppercase tracking-wider">Revenue</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-bold text-emerald-300">22:1</div>
          <div class="text-xs text-white/70 font-semibold mt-1 uppercase tracking-wider">ROAS</div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-4 text-center">
          <div class="text-2xl sm:text-3xl font-bold text-white">34</div>
          <div class="text-xs text-white/70 font-semibold mt-1 uppercase tracking-wider">Bookings</div>
        </div>
      </div>

      <p class="text-sm text-white/50 font-medium">Best Western Davison Inn · Expedia TravelAds · April 1–30, 2026</p>
    </div>
  </section>

  <!-- What's inside strip -->
  <section class="bg-white border-b border-gray-100 py-8">
    <div class="max-w-5xl mx-auto px-4 sm:px-8">
      <p class="text-center text-xs font-bold uppercase tracking-widest text-gray-400 mb-6">Every report includes 7 sections — scroll or click the tabs below</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
        {[
          { icon: '📊', label: 'Overview' },
          { icon: '📈', label: 'Trends' },
          { icon: '🔀', label: 'Booking Funnel' },
          { icon: '⚡', label: 'Opportunity' },
          { icon: '✅', label: 'Action Plan' },
          { icon: '🔍', label: 'Your Listing' },
          { icon: '⭐', label: 'Reputation' },
        ].map(item => (
          <div class="flex flex-col items-center gap-1.5 bg-gray-50 rounded-xl px-3 py-3 text-center border border-gray-100">
            <span class="text-xl">{item.icon}</span>
            <span class="text-xs font-semibold text-gray-600">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The interactive report -->
  <section class="bg-[#f5f5f7] py-10">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
        <div>
          <h2 class="text-lg font-bold text-gray-900">Interactive Report</h2>
          <p class="text-sm text-gray-500 mt-0.5">Click any card, chart, or tab — everything is fully interactive</p>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-bold border border-emerald-100">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Live report · April 2026
          </span>
        </div>
      </div>

      <!-- Report preview card -->
      <div class="rounded-2xl overflow-hidden border border-gray-200 shadow-xl bg-white">
        <!-- Preview header -->
        <div class="bg-gradient-to-r from-[#0a2547] to-[#1d68b5] px-6 py-4 flex items-center justify-between flex-wrap gap-3">
          <div class="flex items-center gap-3">
            <div class="w-2.5 h-2.5 rounded-full bg-red-400"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-yellow-400"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-green-400"></div>
            <span class="text-white/60 text-xs font-mono ml-2">advertisingsystems.ai/report</span>
          </div>
          <a href="/report" target="_blank" class="inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white text-sm font-bold px-5 py-2 rounded-lg transition-colors">
            Open Full Interactive Report
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
          </a>
        </div>

        <!-- Stat preview grid -->
        <div class="p-8 bg-[#f5f5f7]">
          <p class="text-center text-sm font-semibold text-gray-500 mb-6">Preview of the 7-tab interactive report</p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
            {[
              { label: 'Total Ad Spend', value: '$432.95', sub: 'Apr 1–30, 2026', color: 'border-orange-200 bg-orange-50' },
              { label: 'Revenue Generated', value: '$9,525', sub: '+$2,069 halo', color: 'border-blue-200 bg-blue-50' },
              { label: 'Return on Ad Spend', value: '22:1', sub: '2× benchmark', color: 'border-emerald-200 bg-emerald-50' },
              { label: 'Net Profit', value: '$9,092', sub: 'after ad spend', color: 'border-purple-200 bg-purple-50' },
            ].map(s => (
              <div class={`rounded-xl border p-4 text-center ${s.color}`}>
                <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">{s.label}</div>
                <div class="text-2xl font-bold text-gray-900">{s.value}</div>
                <div class="text-xs text-gray-500 mt-1">{s.sub}</div>
              </div>
            ))}
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
            {[
              { label: 'Impressions', value: '8,527' },
              { label: 'Clicks', value: '307' },
              { label: 'Bookings', value: '34' },
              { label: 'Room Nights', value: '65' },
            ].map(s => (
              <div class="rounded-lg bg-white border border-gray-200 px-4 py-3 text-center">
                <div class="text-lg font-bold text-gray-900">{s.value}</div>
                <div class="text-xs text-gray-400 font-semibold mt-0.5">{s.label}</div>
              </div>
            ))}
          </div>
          <div class="text-center">
            <a href="/report" target="_blank" class="inline-flex items-center gap-2 bg-[#1d68b5] hover:bg-[#155a9f] text-white font-bold px-8 py-3.5 rounded-xl transition-colors text-sm">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              View full report — all 7 tabs, charts & AI recommendations
            </a>
            <p class="text-xs text-gray-400 mt-3">Opens in a new tab · 100% interactive · Tabs · Charts · Modals · AI insights</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What every report covers -->
  <section class="bg-white py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-8">
      <div class="text-center mb-14">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 tracking-tight mb-4">What you get every single month</h2>
        <p class="text-lg text-gray-500 max-w-2xl mx-auto">Not a spreadsheet. A fully interactive report that tells the story behind every dollar — delivered automatically.</p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>`,
            color: 'bg-blue-50 text-blue-600',
            title: 'ROAS & ROI breakdown',
            desc: 'See exactly how much revenue every dollar of ad spend generated — with clicked-path and exposure-halo split.',
          },
          {
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M3 4h18l-7 9v7l-4-2v-5z"/></svg>`,
            color: 'bg-purple-50 text-purple-600',
            title: 'Full booking funnel',
            desc: 'Impressions → Clicks → Bookings → Room nights → Revenue. Every step visualized with industry benchmarks.',
          },
          {
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M3 3v18h18"/><path d="M7 14l4-4 4 4 5-5"/></svg>`,
            color: 'bg-emerald-50 text-emerald-600',
            title: 'Daily performance trends',
            desc: 'Day-by-day spend and revenue charts reveal peak booking days and help spot patterns you can act on.',
          },
          {
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg>`,
            color: 'bg-amber-50 text-amber-600',
            title: 'Missed revenue & opportunity gap',
            desc: 'Know exactly how much revenue was left on the table due to budget caps — with a clear fix.',
          },
          {
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M12 2l3 6 6 1-4.5 4.5 1 6.5-5.5-3-5.5 3 1-6.5L3 9l6-1z"/></svg>`,
            color: 'bg-rose-50 text-rose-600',
            title: 'Reputation & review insights',
            desc: 'AI-analyzed guest reviews from Expedia, Booking.com, Google, TripAdvisor, and Yelp — with priority action items.',
          },
          {
            icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13l2 2 4-4"/></svg>`,
            color: 'bg-indigo-50 text-indigo-600',
            title: 'Concrete action plan',
            desc: 'Not just data — numbered, prioritized recommendations written specifically for your property\'s numbers.',
          },
        ].map(item => (
          <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100 hover:border-blue-100 hover:bg-blue-50/30 transition-all">
            <div class={`w-11 h-11 rounded-xl flex items-center justify-center mb-4 ${item.color}`} set:html={item.icon}></div>
            <h3 class="font-bold text-gray-900 mb-2">{item.title}</h3>
            <p class="text-sm text-gray-500 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Social proof numbers -->
  <section class="bg-gradient-to-br from-gray-900 to-gray-800 py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 text-center">
      <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-10">The numbers behind the report above</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 mb-12">
        {[
          { value: '$9,092', label: 'Net profit after ad spend', sub: 'in one month' },
          { value: '22:1', label: 'Return on ad spend', sub: '2× industry average' },
          { value: '11.07%', label: 'Click-to-book rate', sub: 'vs 3–5% benchmark' },
          { value: '2.04', label: 'Average ad rank', sub: 'top 2 sponsored slots' },
        ].map(stat => (
          <div>
            <div class="text-3xl sm:text-4xl font-bold text-white mb-1">{stat.value}</div>
            <div class="text-sm font-semibold text-gray-300 mb-0.5">{stat.label}</div>
            <div class="text-xs text-gray-500">{stat.sub}</div>
          </div>
        ))}
      </div>
      <p class="text-gray-400 text-sm mb-8 max-w-xl mx-auto">This is one property, one month. Imagine having this clarity across every channel, every month — automatically.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/book-demo" class="inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white font-bold px-8 py-4 rounded-xl transition-colors text-base">
          Get this for my property
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
        </a>
        <a href="http://app.advertisingsystems.ai/signup" class="inline-flex items-center justify-center gap-2 bg-white/10 hover:bg-white/20 text-white font-bold px-8 py-4 rounded-xl transition-colors text-base border border-white/20">
          Start free trial
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ strip -->
  <section class="bg-white py-16 border-t border-gray-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-8">
      <h2 class="text-2xl font-bold text-center text-gray-900 mb-10">Questions about the report</h2>
      <div class="space-y-4">
        {[
          {
            q: 'How often do I get this report?',
            a: 'Monthly. Every report covers the previous calendar month and is delivered automatically — no request needed.',
          },
          {
            q: 'Is this report personalized to my property?',
            a: 'Yes. Every number, chart, and recommendation is generated specifically for your hotel\'s campaign data, not a template.',
          },
          {
            q: 'What platforms does the report cover?',
            a: 'Currently Expedia TravelAds (live). Booking.com, Google Hotel Ads, and additional OTAs are coming. Reputation data pulls from Expedia, Booking.com, Google, TripAdvisor, Yelp, and Hotels.com.',
          },
          {
            q: 'Do I need to do anything with the report?',
            a: 'The Action Plan tab gives you numbered, specific steps. You can act on them yourself or let our team implement the recommendations.',
          },
        ].map(item => (
          <details class="group border border-gray-100 rounded-xl overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-4 font-semibold text-gray-900 hover:bg-gray-50 transition-colors list-none">
              {item.q}
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <div class="px-6 pb-5 text-sm text-gray-500 leading-relaxed border-t border-gray-100 pt-4">{item.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

</Layout>

