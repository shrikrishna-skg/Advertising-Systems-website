---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FAQSection from '../components/FAQSection.astro';
import { signupFaqs } from '../data/page-faqs';

/**
 * Signup — Wave 3, Terminal conversion. Single-purpose funnel page: one narrow
 * column, the intake form in a panel, no competing sections. All submit/PostHog
 * behaviour unchanged.
 */
const breadcrumbs = [{ name: 'Sign Up', href: '/signup' }];

const whatYouGet = [
  'Full access to all 5 modules — Campaign Intelligence, AI Optimization, Analytics, Automation, Budget Allocator',
  'Connect Google Ads, Meta Ads, and OTAs in one dashboard',
  'Secure signup with no password sent through the website',
  'Cancel anytime. No long-term contract.',
];
---

<Layout
  title="Create Your Account — Advertising Systems"
  description="Create your Advertising Systems account request. Unify Google, Meta, and OTA campaigns with AI optimization through a secure signup flow."
  breadcrumbs={breadcrumbs}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Sign Up — Advertising Systems',
    url: 'https://advertisingsystems.ai/signup',
    potentialAction: {
      '@type': 'CreateAction',
      name: 'Create Account',
      target: 'https://advertisingsystems.ai/signup'
    }
  }}
>
  <Navbar />
  <main class="terminal">
    <section class="s-hero" aria-labelledby="signup-heading">
      <div class="wrap s-col">
        <span class="badge-line"><i aria-hidden="true"></i> Secure signup — account created in the app</span>
        <h1 id="signup-heading">Start your <span class="s-accent">secure signup.</span></h1>
        <p class="lead">Create your account request here, then continue in the secure Advertising Systems app. Your password never touches this website.</p>

        <div class="panel-box s-panel">
          <div class="panel-hd"><h2>What you get</h2></div>
          <ul class="s-list" role="list">
            {whatYouGet.map((item) => <li>{item}</li>)}
          </ul>
        </div>

        <div class="panel-box s-panel">
          <div class="panel-hd"><h2>Account request</h2></div>
          <form id="signup-intent-form" class="s-form" action="/api/signup-intent" method="POST" data-app-signup-url="https://app.advertisingsystems.ai/signup">
            <div>
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" required maxlength="120" placeholder="Jane Smith" autocomplete="name" />
            </div>
            <div>
              <label for="email">Work Email</label>
              <input type="email" id="email" name="email" required maxlength="254" placeholder="jane@company.com" autocomplete="email" />
            </div>
            <div>
              <label for="company">Company</label>
              <input type="text" id="company" name="company" required maxlength="160" placeholder="Acme Corp" autocomplete="organization" />
            </div>
            <button type="submit" id="signup-intent-submit" class="btn btn-p s-submit">Continue to Secure Signup</button>
            <div id="signup-intent-message" class="s-alert" role="alert" hidden></div>
            <p class="s-fine">
              Your account and password are created inside the secure app. By continuing, you agree to our
              <a href="/terms">Terms of Service</a> and <a href="/privacy">Privacy Policy</a>.
            </p>
            <p class="s-login">Already have an account? <a href="https://app.advertisingsystems.ai/login">Log in</a></p>
          </form>
        </div>

        <p class="fine s-trust">Secure signup · No credit card required · Cancel anytime</p>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={signupFaqs} name="signup-faq" />
  </main>
  <Footer />

  <style>
    .s-hero {
      padding: 56px 0 64px;
      background:
        linear-gradient(var(--dot-grid-color) 1px, transparent 1px) 0 0 / 100% 34px,
        linear-gradient(90deg, var(--dot-grid-color) 1px, transparent 1px) 0 0 / 34px 100%,
        var(--surface-alt);
      border-bottom: 1px solid var(--border);
    }
    .s-col { max-width: 560px; }
    /* Display-text exception — same rule as the homepage rotator. */
    .s-accent { color: var(--acc-display, var(--acc-btn)); }

    .s-panel { margin-top: 22px; }
    .s-list { margin: 0; padding: 6px 0; list-style: none; }
    .s-list li {
      position: relative;
      padding: 9px 16px 9px 38px;
      font-size: 13.5px; color: var(--text-secondary); line-height: 1.5;
      border-bottom: 1px solid var(--border);
    }
    .s-list li:last-child { border-bottom: 0; }
    .s-list li::before {
      content: ""; position: absolute; left: 16px; top: 16px;
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--pos);
    }

    .s-form { padding: 18px 16px; display: grid; gap: 14px; }
    .s-form label {
      display: block;
      font-size: 10.5px; font-weight: 700; letter-spacing: 0.11em;
      text-transform: uppercase; color: var(--text-tertiary);
      margin-bottom: 6px;
    }
    .s-form input {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid var(--border);
      border-radius: 3px;
      background: var(--surface);
      color: var(--text-primary);
      font-family: inherit;
      font-size: 14.5px;
      transition: border-color 0.15s;
    }
    .s-form input::placeholder { color: var(--text-faint); }
    .s-form input:focus { outline: none; border-color: var(--acc); }
    .s-submit { width: 100%; }

    .s-alert {
      font-size: 13.5px; font-weight: 600;
      border: 1px solid var(--border); border-radius: 3px;
      padding: 10px 12px;
    }
    .s-alert.ok { color: var(--pos); border-color: var(--pos); background: var(--pos-tint); }
    .s-alert.err { color: var(--neg); border-color: var(--neg); background: var(--neg-tint); }

    .s-fine { font-size: 12px; color: var(--text-tertiary); text-align: center; line-height: 1.55; }
    .s-fine a, .s-login a { color: var(--acc); font-weight: 600; text-decoration: none; }
    .s-fine a:hover, .s-login a:hover { text-decoration: underline; }
    .s-login { font-size: 13.5px; font-weight: 600; color: var(--text-secondary); text-align: center; }
    .s-trust { text-align: center; }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      var form = document.getElementById('signup-intent-form');
      var submitBtn = document.getElementById('signup-intent-submit');
      var messageEl = document.getElementById('signup-intent-message');
      if (!form) return;
      function getClientSubmissionId(prefix) {
        if (window.crypto?.randomUUID) return prefix + '-' + window.crypto.randomUUID();
        return prefix + '-' + Date.now() + '-' + Math.random().toString(36).slice(2);
      }
      function getContext(defaultCta) {
        var params = new URLSearchParams(window.location.search);
        var sourcePage = params.get('source_page');
        return {
          landingPage: sourcePage ? (sourcePage.charAt(0) === '/' ? sourcePage : '/' + sourcePage) : window.location.pathname,
          referrer: document.referrer || undefined,
          cta: params.get('cta') || defaultCta,
          posthogDistinctId: window.posthog?.get_distinct_id?.() || undefined,
          utm: {
            source: params.get('utm_source') || undefined,
            medium: params.get('utm_medium') || undefined,
            campaign: params.get('utm_campaign') || undefined,
          },
        };
      }
      function setMessage(text, isError) {
        if (!messageEl) return;
        messageEl.textContent = text;
        messageEl.className = isError ? 's-alert err' : 's-alert ok';
        messageEl.hidden = false;
      }
      form.addEventListener('submit', async function(event) {
        event.preventDefault();
        if (submitBtn) submitBtn.disabled = true;
        if (messageEl) messageEl.hidden = true;
        var email = form.querySelector('#email')?.value?.trim();
        var company = form.querySelector('#company')?.value?.trim();
        var params = new URLSearchParams(window.location.search);
        var payload = {
          name: form.querySelector('#name')?.value?.trim(),
          email: email,
          company: company,
          plan: params.get('plan') || undefined,
          client_submission_id: getClientSubmissionId('signup'),
          context: getContext('Start Signup'),
        };
        try {
          var analyticsConsent = '';
          try { analyticsConsent = localStorage.getItem('ads_cookie_consent') === 'accepted' ? 'accepted' : ''; } catch (e) {}
          var res = await fetch(form.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Analytics-Consent': analyticsConsent,
            },
            body: JSON.stringify(payload),
          });
          var data = await res.json().catch(function() { return {}; });
          if (!res.ok) throw new Error(data.error || 'Something went wrong. Please try again.');
          if (email) window.posthog?.identify(email, { company: company || undefined });
          window.posthog?.capture('signup_form_submitted', {
            has_company: Boolean(company),
            plan: payload.plan,
            status: 'accepted',
          });
          setMessage(data.message || 'Signup started. Continue in the secure app.', false);
          window.setTimeout(function() {
            window.location.href = form.dataset.appSignupUrl || data.redirect_url || 'https://app.advertisingsystems.ai/signup';
          }, 900);
        } catch (error) {
          var message = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
          window.posthog?.capture('signup_form_errored', { error_message: message });
          setMessage(message, true);
          if (submitBtn) submitBtn.disabled = false;
        }
      });
    });
  </script>
</Layout>
