---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import { getDecisionGuide, getRelatedDecisionGuides } from '../../data/decision-guides';

const guide = getDecisionGuide(Astro.params.slug ?? '');

if (!guide) {
  return Astro.rewrite('/404');
}

const breadcrumbs = [
  { name: 'Decision Guides', href: '/decision-guides' },
  { name: guide.shortTitle, href: `/decision-guides/${guide.slug}` },
];

const relatedGuides = getRelatedDecisionGuides(guide.relatedSlugs);

/**
 * Hero-stat tones. Four of the five were raw Tailwind washes (a -600 label over
 * a 10% -500 wash), which measured around 3:1 on the dark ground and did not
 * move with the theme or the accent switch. They now resolve to the three
 * status tokens plus the accent — the only four meanings this site has.
 * Class names are not spelled out in this comment on purpose: Tailwind scans
 * comment text and would re-emit the dead utilities into the bundle.
 */
const toneClasses = {
  green: 'tone-pos',
  rose: 'tone-neg',
  amber: 'tone-warn',
  blue: 'tone-acc',
  violet: 'tone-acc',
};
---

<Layout
  breadcrumbs={[{ name: 'Home', href: '/' }, ...breadcrumbs]}
  title={guide.metaTitle}
  description={guide.metaDescription}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: guide.title,
    description: guide.excerpt,
    url: `https://advertisingsystems.ai/decision-guides/${guide.slug}`,
    author: {
      '@type': 'Organization',
      name: 'Advertising Systems',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Advertising Systems',
    },
  }}
>
  <Navbar />

  <main class="terminal">
    <Breadcrumb items={[{ name: 'Home', href: '/' }, ...breadcrumbs]} />
    <article>
      <PageHero
        badge={guide.eyebrow}
        title={guide.title}
        lead={guide.excerpt}
        primaryCta={{ text: guide.primaryCta.label, href: guide.primaryCta.href }}
        secondaryCta={{ text: guide.secondaryCta.label, href: guide.secondaryCta.href }}
      >
        <div class="hstats">
          {guide.heroStats.map((stat) => (
            <div class={`hstat ${toneClasses[stat.tone]}`}>
              <span class="hl">{stat.label}</span>
              <span class="hv num">{stat.value}</span>
              <span class="hc">{stat.caption}</span>
            </div>
          ))}
        </div>
      </PageHero>

      {guide.sections.map((section, sectionIndex) => (
        <section class:list={['sec', { soft: sectionIndex % 2 === 1 }]} aria-labelledby={`section-${sectionIndex}`}>
          <div class="wrap">
            <div class="sec-hd">
              <span class="no" aria-hidden="true">{String(sectionIndex + 1).padStart(2, '0')}</span>
              <div>
                <span class="eyebrow">{section.eyebrow}</span>
                <h2 id={`section-${sectionIndex}`}>{section.title}</h2>
                <p class="sub">{section.intro}</p>
              </div>
            </div>
            <div class="cardgrid">
              {section.cards.map((card) => (
                <div>
                  <div class="cn">{card.label}</div>
                  <h3>{card.title}</h3>
                  <p>{card.body}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      ))}

      {guide.table && (
        <section class="sec" aria-labelledby="guide-table-heading">
          <div class="wrap">
            <div class="sec-hd">
              <span class="no" aria-hidden="true">→</span>
              <div>
                <span class="eyebrow">Decision table</span>
                <h2 id="guide-table-heading">{guide.table.title}</h2>
                <p class="sub">{guide.table.intro}</p>
              </div>
            </div>
            <div class="panel-box scroll-x">
              <table class="bench" role="table">
                <thead>
                  <tr>{guide.table.columns.map((column) => <th>{column}</th>)}</tr>
                </thead>
                <tbody>
                  {guide.table.rows.map((row) => (
                    <tr>{row.map((cell, ci) => <td class={ci === 0 ? 'm' : ''}>{cell}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </section>
      )}

      <section class="sec soft" aria-labelledby="reporting-heading">
        <div class="wrap">
          <div class="sec-hd">
            <span class="no" aria-hidden="true">→</span>
            <div>
              <span class="eyebrow">Report layer</span>
              <h2 id="reporting-heading">The guide ends where the dashboard begins.</h2>
              <p class="sub">
                Channel education is useful, but the software has to prove whether the spend should
                continue, move, or stop.
              </p>
            </div>
          </div>
          <div class="cardgrid">
            {guide.proofMetrics.map((metric) => (
              <div>
                <div class="cn">{metric.label}</div>
                <h3>{metric.title}</h3>
                <p>{metric.body}</p>
              </div>
            ))}
          </div>
          <div class="cta-row">
            <a class="btn btn-l btn-sm" href="/sample-report">Sample report</a>
            <a class="btn btn-l btn-sm" href="/expedia-report">Expedia report</a>
          </div>
        </div>
      </section>

      <section class="sec" aria-labelledby="sources-heading">
        <div class="wrap">
          <div class="sec-hd">
            <span class="no" aria-hidden="true">§</span>
            <div>
              <span class="eyebrow">Research notes</span>
              <h2 id="sources-heading">Official sources used for this guide.</h2>
            </div>
          </div>
          <div class="srcs">
            {guide.sourceNotes.map((source) => (
              <a class="src" href={source.href} target="_blank" rel="noopener noreferrer">
                <div>
                  <h3>{source.label}</h3>
                  <p>{source.note}</p>
                </div>
                <span class="open">Open →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </article>

    {relatedGuides.length > 0 && (
      <section class="sec soft" aria-labelledby="related-guides-heading">
        <div class="wrap">
          <div class="sec-hd no-rail">
            <div><h2 id="related-guides-heading">Read next.</h2></div>
          </div>
          <div class="cardgrid">
            {relatedGuides.map((related) => (
              <a href={`/decision-guides/${related.slug}`} class="r-card">
                <div class="cn">{related.category}</div>
                <h3>{related.shortTitle}</h3>
                <p>{related.excerpt}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <CTABand />
  </main>

  <Footer />

  <style>
    .sec-hd.no-rail { grid-template-columns: 1fr; }
    .sec-hd .eyebrow { display: block; margin-bottom: 8px; }

    .hstats {
      display: grid; grid-template-columns: repeat(3, 1fr);
      margin-top: 30px;
      border-top: 1px solid var(--border); border-left: 1px solid var(--border);
      max-width: 62em;
    }
    .hstat {
      padding: 15px 16px;
      border-right: 1px solid var(--border); border-bottom: 1px solid var(--border);
      background: var(--surface-raised);
      border-left: 2px solid var(--border);
      min-width: 0;
    }
    .hstat.tone-pos { border-left-color: var(--pos); }
    .hstat.tone-neg { border-left-color: var(--neg); }
    .hstat.tone-warn { border-left-color: var(--warn); }
    .hstat.tone-acc { border-left-color: var(--acc); }
    .hl { display: block; font-size: 9.5px; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; color: var(--text-tertiary); }
    .hv { display: block; margin-top: 6px; font-size: 22px; font-weight: 800; letter-spacing: -0.025em; color: var(--text-primary); }
    .hc { display: block; margin-top: 5px; font-size: 12px; color: var(--text-tertiary); line-height: 1.45; }
    @media (max-width: 640px) { .hstats { grid-template-columns: 1fr; } }

    .srcs { border-top: 1px solid var(--border); }
    .src {
      display: flex; align-items: center; justify-content: space-between; gap: 20px;
      padding: 18px 0; border-bottom: 1px solid var(--border);
      text-decoration: none; transition: color 0.15s;
    }
    .src h3 { font-size: 15.5px; font-weight: 700; color: var(--text-primary); }
    .src p { margin-top: 5px; font-size: 13px; color: var(--text-tertiary); max-width: 52em; line-height: 1.5; }
    .src .open { font-size: 12.5px; font-weight: 700; color: var(--acc); white-space: nowrap; }
    .src:hover h3 { color: var(--acc); }

    .r-card { text-decoration: none; display: block; transition: background 0.15s; }
    a.r-card:hover { background: var(--surface); }
    a.r-card:hover h3 { color: var(--acc); }
    .r-card h3 { transition: color 0.15s; }
  </style>
</Layout>
