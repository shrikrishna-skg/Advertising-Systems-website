---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQSection from '../components/FAQSection.astro';
import { blogFaqs } from '../data/page-faqs';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import { blogPosts } from '../data/blog-posts';

const breadcrumbs = [{ name: 'Blog', href: '/blog' }];

const hotelPosts = blogPosts.filter((post) => post.learningTrack);
const archivePosts = blogPosts.filter((post) => !post.learningTrack);
const preferredCategories = ['Start Here', 'Demand Planning', 'OTA Advertising', 'Google Hotel Ads', 'Search & AI Discovery', 'Creative & Trust', 'Meta & Retargeting', 'Conversion Tracking', 'Reporting & ROAS', 'Case Studies'];
const categories = ['All', ...preferredCategories.filter((category) => hotelPosts.some((post) => post.category === category))];

/**
 * Category identity is a RULE, not a fill.
 *
 * The old helper returned a Tailwind -700 label over a 10% -500 wash. Those
 * steps are built for a white page: on `--surface-raised` in the shipped dark
 * theme the chips measured 2.05–2.43:1, below AA on all five. Rather than
 * re-tune five washes, category now shows as a 2px left rule plus a dot, and
 * the label itself uses text tokens — so recall across a 24-post library
 * survives and every contrast failure disappears by construction.
 */
const categoryRule = (color: string) => {
  switch (color) {
    case 'accent': return 'k-acc';
    case 'blue': return 'k-blue';
    case 'violet': return 'k-violet';
    case 'amber': return 'k-amber';
    case 'rose': return 'k-rose';
    default: return 'k-none';
  }
};

/**
 * Metric tone. THE BUG: `case 'green'` returned an accent-ramp step — and the
 * accent is ROSE — so every `tone: 'green'` metric on the site (including the
 * Read-time stat on all 24 posts) rendered dark red. Green means --pos, which
 * is what --pos is for. Blue was a second brand colour that this direction
 * does not have; it resolves to structure.
 */
const toneText = (tone = 'slate') => {
  switch (tone) {
    case 'green': return 't-pos';
    case 'rose': return 't-neg';
    case 'amber': return 't-warn';
    case 'violet': return 't-acc';
    default: return 't-plain';
  }
};

const proofCards = [
  {
    title: 'Sample Report',
    href: '/sample-report',
    label: 'Cross-channel',
    body: 'See how hotel spend, revenue, ROAS, platform mix, and campaign movement should look in one report.',
    metric: 'Hotel overview',
    tone: 'green',
  },
  {
    title: 'Expedia Report',
    href: '/expedia-report',
    label: 'XPR drill-in',
    body: 'Open the Expedia TravelAds report view built for OTA spend, bookings, revenue, and ROAS review.',
    metric: 'OTA detail',
    tone: 'blue',
  },
];
---

<Layout
  title="Hotel Advertising Learning Center | Advertising Systems Blog"
  description="Visual hotel advertising guides for owners, GMs, and revenue teams. Learn OTA ads, Google Hotel Ads, Meta retargeting, ROAS reporting, and budget automation."
  breadcrumbs={breadcrumbs}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Advertising Systems Hotel Advertising Learning Center',
    url: 'https://www.advertisingsystems.ai/blog',
    description: 'Visual hotel advertising guides and reports for hospitality teams.',
    publisher: {
      '@type': 'Organization',
      name: 'Advertising Systems'
    }
  }}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />

    <PageHero
      badge={`${hotelPosts.length} hotel learning modules`}
      title="Learn the report"
      titleAccent="before you buy the software."
      lead="Short visual guides for hotel owners, GMs and revenue teams who want to understand OTA ads, direct bookings, ROAS and budget automation without reading platform manuals."
      primaryCta={{ text: 'View sample report', href: '/sample-report' }}
      secondaryCta={{ text: 'Book a demo', href: '/book-demo' }}
    />

    <!-- 01 · What a report looks like -->
    <section class="sec" aria-labelledby="snapshot-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="snapshot-heading">What these modules are teaching you to read.</h2>
            <p class="sub">Every guide ends at the same place: a report an owner can act on without a translator.</p>
          </div>
        </div>

        <div class="snap">
          <div class="panel-box">
            <div class="panel-hd">
              <h3>Ad mix — owner view</h3>
              <span class="illus">Illustrative</span>
            </div>
            <div class="kpis">
              <div class="kpi"><span class="k">Spend</span><span class="v num">$255k</span></div>
              <div class="kpi"><span class="k">ROAS</span><span class="v num">4.8×</span></div>
              <div class="kpi"><span class="k">Revenue</span><span class="v num">$1.23M</span></div>
              <div class="kpi"><span class="k">Campaigns</span><span class="v num">3</span></div>
            </div>
            <div class="mixes">
              {[
                { name: 'Google Hotel Ads', value: '42%' },
                { name: 'Expedia TravelAds', value: '28%' },
                { name: 'Meta Retargeting', value: '18%' },
                { name: 'Booking Sponsored', value: '12%' },
              ].map((row) => (
                <div class="mix">
                  <span class="mn">{row.name}</span>
                  <span class="mb" aria-hidden="true"><i style={`width:${row.value}`}></i></span>
                  <span class="mv num">{row.value}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="proofs">
            {proofCards.map((card) => (
              <a href={card.href} class="proof">
                <span class="pl">{card.label}</span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
                <span class="pm">{card.metric} →</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 02 · Modules -->
    <section class="sec soft" aria-labelledby="learning-path-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="learning-path-heading">Hotel ads, in the order owners ask.</h2>
            <p class="sub">Each module is built to be scanned first — metrics, diagram, comparison — then acted on.</p>
          </div>
        </div>

        <div class="tools">
          <div class="filters" role="tablist" aria-label="Filter hotel advertising modules">
            {categories.map((cat) => (
              <button
                type="button"
                class="blog-filter"
                data-category={cat === 'All' ? '*' : cat}
                data-active={cat === 'All' ? 'true' : undefined}
              >
                {cat}
              </button>
            ))}
          </div>

          <div class="searchbox">
            <label for="blog-search" class="sr-only">Search blog articles</label>
            <input
              id="blog-search"
              type="search"
              autocomplete="off"
              placeholder="Search hotel ads, ROAS, Expedia…"
            />
            <button type="button" id="blog-search-clear" class="hidden" aria-label="Clear blog search">✕</button>
          </div>
        </div>
        <p id="blog-search-status" class="fine" aria-live="polite">Showing all hotel learning modules.</p>

        <div class="posts" id="blog-grid">
          {hotelPosts.map((post, index) => (
            <a
              href={`/blog/${post.slug}`}
              class={`blog-card ${categoryRule(post.color)}`}
              data-category={post.category}
              data-search={`${post.title} ${post.excerpt} ${post.category} ${post.learningTrack ?? ''} ${post.intent ?? ''} ${(post.heroStats ?? []).map((stat) => `${stat.label} ${stat.value} ${stat.caption ?? ''}`).join(' ')}`}
            >
              <div class="bc-hd">
                <span class="cat"><i aria-hidden="true"></i>{post.category}</span>
                <span class="idx num">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <h3>{post.title}</h3>
              <p class="bc-ex">{post.excerpt}</p>
              <div class="bc-stats">
                {(post.heroStats ?? []).slice(0, 3).map((stat) => (
                  <div class="bc-stat">
                    <span class={`bs-v num ${toneText(stat.tone)}`}>{stat.value}</span>
                    <span class="bs-l">{stat.label}</span>
                  </div>
                ))}
              </div>
              <div class="bc-ft">
                <span>{post.readTime}</span>
                <span class="rd">Read module →</span>
              </div>
            </a>
          ))}
        </div>

        <div id="blog-empty-state" class="hidden empty">
          <h3>No matching modules</h3>
          <p>Try a broader search — “Expedia”, “ROAS”, “Booking”, “Google” — or clear the selected category.</p>
        </div>
      </div>
    </section>

    {archivePosts.length > 0 && (
      <section id="archive-section" class="sec" aria-labelledby="archive-heading">
        <div class="wrap">
          <div class="sec-hd">
            <span class="no" aria-hidden="true">03</span>
            <div>
              <h2 id="archive-heading">Archive.</h2>
              <p class="sub">Product updates, case studies and broader strategy posts.</p>
            </div>
          </div>
          <div class="posts arch">
            {archivePosts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class={`archive-card blog-card ${categoryRule(post.color)}`}
                data-search={`${post.title} ${post.excerpt} ${post.category} ${post.author.name} ${post.author.role ?? ''}`}
              >
                <div class="bc-hd">
                  <span class="cat"><i aria-hidden="true"></i>{post.category}</span>
                </div>
                <h3>{post.title}</h3>
                <p class="bc-ex">{post.excerpt}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 04 · Newsletter -->
    <section class="sec soft" aria-labelledby="newsletter-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">04</span>
          <div>
            <h2 id="newsletter-heading">Hotel advertising notes, by email.</h2>
            <p class="sub">Short updates on OTA ads, ROAS reporting, budget automation and owner-ready reporting.</p>
          </div>
        </div>
        <form id="blog-newsletter-form" action="/api/newsletter" method="POST" class="nl" aria-label="Newsletter subscription form">
          <label for="newsletter-email" class="sr-only">Email address</label>
          <div class="nl-row">
            <input
              id="newsletter-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              maxlength="254"
              placeholder="you@company.com"
            />
            <button id="blog-newsletter-submit" type="submit" class="btn btn-p">Subscribe</button>
          </div>
          <div class="hidden" aria-hidden="true">
            <label for="newsletter-website">Website</label>
            <input id="newsletter-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <p id="blog-newsletter-message" class="hidden nl-msg" role="alert"></p>
        </form>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={blogFaqs} name="blog-faq" no="05" soft={false} />
    <CTABand />

    <script>
      const searchInput = document.getElementById('blog-search') as HTMLInputElement | null;
      const clearSearchButton = document.getElementById('blog-search-clear') as HTMLButtonElement | null;
      const searchStatus = document.getElementById('blog-search-status');
      const emptyState = document.getElementById('blog-empty-state');
      const archiveSection = document.getElementById('archive-section');
      const newsletterForm = document.getElementById('blog-newsletter-form') as HTMLFormElement | null;
      const newsletterSubmit = document.getElementById('blog-newsletter-submit') as HTMLButtonElement | null;
      const newsletterMessage = document.getElementById('blog-newsletter-message');
      const hotelCards = Array.from(document.querySelectorAll('.blog-card')) as HTMLElement[];
      const archiveCards = Array.from(document.querySelectorAll('.archive-card')) as HTMLElement[];
      const allSearchableCards = [...hotelCards, ...archiveCards];
      let activeCategory = '*';

      function normalize(value: string | null | undefined) {
        return (value ?? '').toLowerCase().replace(/\s+/g, ' ').trim();
      }

      function setCardVisible(card: HTMLElement, visible: boolean) {
        card.hidden = !visible;
      }

      function updateSearchClearButton(query: string) {
        if (!clearSearchButton) return;
        clearSearchButton.classList.toggle('hidden', query.length === 0);
        clearSearchButton.classList.toggle('inline-flex', query.length > 0);
      }

      function getClientSubmissionId(prefix: string) {
        if (window.crypto?.randomUUID) return `${prefix}-${window.crypto.randomUUID()}`;
        return `${prefix}-${Date.now()}-${Math.random().toString(36).slice(2)}`;
      }

      function getNewsletterContext() {
        const params = new URLSearchParams(window.location.search);
        const sourcePage = params.get('source_page');
        return {
          landingPage: sourcePage ? (sourcePage.charAt(0) === '/' ? sourcePage : '/' + sourcePage) : window.location.pathname,
          referrer: document.referrer || undefined,
          cta: params.get('cta') || 'Newsletter Subscribe',
          posthogDistinctId: window.posthog?.get_distinct_id?.() || undefined,
          utm: {
            source: params.get('utm_source') || undefined,
            medium: params.get('utm_medium') || undefined,
            campaign: params.get('utm_campaign') || undefined,
          },
        };
      }

      function setNewsletterMessage(text: string, isError: boolean) {
        if (!newsletterMessage) return;
        newsletterMessage.textContent = text;
        newsletterMessage.className = isError
          ? 'rounded-lg border border-[var(--neg)] bg-[var(--neg-tint)] p-3 text-sm font-semibold text-[var(--neg)]'
          : 'rounded-lg border border-[var(--pos-line)] bg-[var(--pos-tint)] p-3 text-sm font-semibold text-[var(--pos)]';
        newsletterMessage.classList.remove('hidden');
      }

      function applyBlogFilters() {
        const query = normalize(searchInput?.value);
        let visibleHotelCount = 0;
        let visibleArchiveCount = 0;

        hotelCards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          const matchesCategory = activeCategory === '*' || cardCategory === activeCategory;
          const searchableText = normalize(card.getAttribute('data-search'));
          const matchesSearch = query.length === 0 || searchableText.includes(query);
          const show = matchesCategory && matchesSearch;

          setCardVisible(card, show);
          if (show) visibleHotelCount += 1;
        });

        archiveCards.forEach((card) => {
          const searchableText = normalize(card.getAttribute('data-search'));
          const matchesSearch = query.length === 0 || searchableText.includes(query);

          setCardVisible(card, matchesSearch);
          if (matchesSearch) visibleArchiveCount += 1;
        });

        const totalVisible = visibleHotelCount + visibleArchiveCount;
        updateSearchClearButton(query);

        if (emptyState) {
          emptyState.classList.toggle('hidden', totalVisible > 0);
        }

        if (archiveSection) {
          archiveSection.classList.toggle('hidden', query.length > 0 && visibleArchiveCount === 0);
        }

        if (searchStatus) {
          if (query.length > 0) {
            searchStatus.textContent = `${totalVisible} result${totalVisible === 1 ? '' : 's'} for "${searchInput?.value.trim()}".`;
          } else if (activeCategory !== '*') {
            searchStatus.textContent = `${visibleHotelCount} module${visibleHotelCount === 1 ? '' : 's'} in ${activeCategory}.`;
          } else {
            searchStatus.textContent = 'Showing all hotel learning modules.';
          }
        }
      }

      document.querySelectorAll('.blog-filter').forEach((btn) => {
        btn.addEventListener('click', () => {
          activeCategory = btn.getAttribute('data-category') ?? '*';
          document.querySelectorAll('.blog-filter').forEach((b) => b.removeAttribute('data-active'));
          btn.setAttribute('data-active', '');
          applyBlogFilters();
        });
      });

      searchInput?.addEventListener('input', applyBlogFilters);
      searchInput?.addEventListener('search', applyBlogFilters);
      clearSearchButton?.addEventListener('click', () => {
        if (!searchInput) return;
        searchInput.value = '';
        searchInput.focus();
        applyBlogFilters();
      });

      newsletterForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (newsletterSubmit) newsletterSubmit.disabled = true;
        newsletterMessage?.classList.add('hidden');

        const emailInput = newsletterForm.querySelector('#newsletter-email') as HTMLInputElement | null;
        const honeypot = newsletterForm.querySelector('#newsletter-website') as HTMLInputElement | null;
        const email = emailInput?.value.trim() || '';
        try {
          let analyticsConsent = '';
          try { analyticsConsent = localStorage.getItem('ads_cookie_consent') === 'accepted' ? 'accepted' : ''; } catch (e) {}
          const response = await fetch(newsletterForm.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Analytics-Consent': analyticsConsent,
            },
            body: JSON.stringify({
              email,
              website: honeypot?.value.trim(),
              client_submission_id: getClientSubmissionId('newsletter'),
              context: getNewsletterContext(),
            }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || 'Could not subscribe this email.');

          if (email) window.posthog?.identify?.(email);
          window.posthog?.capture?.('newsletter_form_submitted', {
            status: 'accepted',
          });
          setNewsletterMessage(data.message || "You're subscribed.", false);
          newsletterForm.reset();
        } catch (error) {
          const message = error instanceof Error ? error.message : 'Could not subscribe this email.';
          window.posthog?.capture?.('newsletter_form_errored', { error_message: message });
          setNewsletterMessage(message, true);
        } finally {
          if (newsletterSubmit) newsletterSubmit.disabled = false;
        }
      });

      allSearchableCards.forEach((card) => {
        card.setAttribute('data-search', normalize(card.getAttribute('data-search')));
      });

      applyBlogFilters();
    </script>

  </main>
  <Footer />
  <style>
    /* Category rules — one hue each, from tokens, never as a text colour. */
    .k-acc  { --k: var(--acc); }
    .k-blue { --k: var(--text-tertiary); }
    .k-violet { --k: var(--acc); }
    .k-amber { --k: var(--warn); }
    .k-rose { --k: var(--neg); }
    .k-none { --k: var(--border); }

    .snap { display: grid; grid-template-columns: 1.25fr 1fr; gap: 20px; align-items: start; }
    @media (max-width: 900px) { .snap { grid-template-columns: 1fr; } }

    .kpis { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--border); }
    .kpi { padding: 14px 16px; border-right: 1px solid var(--border); min-width: 0; }
    .kpi:last-child { border-right: 0; }
    .kpi .k { display: block; font-size: 9.5px; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; color: var(--text-tertiary); }
    .kpi .v { display: block; margin-top: 5px; font-size: 20px; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); }
    @media (max-width: 640px) {
      .kpis { grid-template-columns: repeat(2, 1fr); }
      .kpi:nth-child(2) { border-right: 0; }
      .kpi:nth-child(-n+2) { border-bottom: 1px solid var(--border); }
    }

    .mixes { padding: 6px 16px 14px; }
    .mix { display: grid; grid-template-columns: 1fr 96px 40px; gap: 12px; align-items: center; padding: 9px 0; border-bottom: 1px solid var(--border); }
    .mix:last-child { border-bottom: 0; }
    .mn { font-size: 13px; color: var(--text-secondary); }
    .mb { display: block; height: 6px; background: var(--progress-track); border-radius: 1px; overflow: hidden; }
    .mb i { display: block; height: 100%; background: var(--acc); }
    .mv { font-size: 12.5px; font-weight: 700; color: var(--text-primary); text-align: right; }

    .proofs { display: grid; gap: 14px; }
    .proof {
      display: block; text-decoration: none; padding: 20px;
      border: 1px solid var(--border); border-radius: 4px; background: var(--surface-raised);
      transition: border-color 0.15s, background 0.15s;
    }
    .proof:hover { border-color: var(--acc); background: var(--surface-alt); }
    .pl { font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--acc); }
    .proof h3 { margin-top: 9px; font-size: 19px; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); }
    .proof p { margin-top: 8px; font-size: 13.5px; color: var(--text-tertiary); line-height: 1.55; }
    .pm { display: inline-block; margin-top: 14px; font-size: 12.5px; font-weight: 700; color: var(--acc); }

    .tools { display: flex; flex-wrap: wrap; gap: 12px; justify-content: space-between; align-items: flex-start; }
    .filters { display: flex; flex-wrap: wrap; gap: 7px; }
    .blog-filter {
      font-size: 12.5px; font-weight: 700; padding: 6px 12px;
      border: 1px solid var(--border); border-radius: 3px;
      background: var(--surface); color: var(--text-tertiary);
      cursor: pointer; font-family: inherit; transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .blog-filter:hover { color: var(--text-primary); background: var(--surface-alt); }
    .blog-filter[data-active] { background: var(--text-primary); color: var(--surface); border-color: var(--text-primary); }

    .searchbox { position: relative; min-width: 260px; flex: 1 1 260px; max-width: 360px; }
    .searchbox input {
      width: 100%; height: 36px; padding: 0 34px 0 12px;
      border: 1px solid var(--border); border-radius: 3px;
      background: var(--surface); color: var(--text-primary);
      font-size: 13px; font-weight: 600; font-family: inherit; outline: none;
    }
    .searchbox input::placeholder { color: var(--text-faint); font-weight: 500; }
    .searchbox input:focus { border-color: var(--acc); }
    .searchbox button {
      position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
      display: inline-flex; width: 24px; height: 24px; align-items: center; justify-content: center;
      border: 0; background: transparent; color: var(--text-tertiary);
      cursor: pointer; font-size: 12px; line-height: 1;
    }
    .searchbox button:hover { color: var(--text-primary); }

    .posts {
      display: grid; grid-template-columns: repeat(4, 1fr);
      margin-top: 22px;
      border-top: 1px solid var(--border); border-left: 1px solid var(--border);
    }
    .posts.arch { grid-template-columns: repeat(3, 1fr); }
    @media (max-width: 1100px) { .posts, .posts.arch { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px)  { .posts, .posts.arch { grid-template-columns: 1fr; } }

    .blog-card {
      display: flex; flex-direction: column;
      padding: 20px; text-decoration: none; min-width: 0;
      background: var(--surface-raised);
      border-right: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      border-left: 2px solid var(--k, var(--border));
      transition: background 0.15s;
    }
    .blog-card:hover { background: var(--surface-alt); }
    /* The filter script sets the `hidden` ATTRIBUTE on cards. An unlayered
       `display:flex` outranks the UA `[hidden]` rule, so filtering would have
       silently stopped working — state it explicitly. */
    .blog-card[hidden] { display: none; }
    .searchbox button.hidden { display: none; }
    .blog-card:hover h3 { color: var(--acc); }
    .bc-hd { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .cat {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--text-tertiary);
    }
    .cat i { width: 6px; height: 6px; border-radius: 50%; background: var(--k, var(--border)); }
    .idx { font-size: 11px; font-weight: 700; color: var(--text-tertiary); }
    .blog-card h3 {
      margin-top: 13px; font-size: 16.5px; font-weight: 800;
      letter-spacing: -0.02em; line-height: 1.28; color: var(--text-primary);
      transition: color 0.15s;
    }
    .bc-ex { margin-top: 9px; font-size: 13px; color: var(--text-tertiary); line-height: 1.55; }
