---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQSection from '../components/FAQSection.astro';
import { blogFaqs } from '../data/page-faqs';
import { blogPosts } from '../data/blog-posts';

const breadcrumbs = [{ name: 'Blog', href: '/blog' }];

const hotelPosts = blogPosts.filter((post) => post.learningTrack);
const archivePosts = blogPosts.filter((post) => !post.learningTrack);
const preferredCategories = ['Start Here', 'Demand Planning', 'OTA Advertising', 'Google Hotel Ads', 'Search & AI Discovery', 'Creative & Trust', 'Meta & Retargeting', 'Conversion Tracking', 'Reporting & ROAS', 'Case Studies'];
const categories = ['All', ...preferredCategories.filter((category) => hotelPosts.some((post) => post.category === category))];

const categoryColor = (color: string) => {
  switch (color) {
    case 'royal-green': return 'bg-royal-green-500/10 border-royal-green-500/20 text-royal-green-700';
    case 'blue': return 'bg-royal-blue-500/10 border-royal-blue-500/20 text-royal-blue-700';
    case 'violet': return 'bg-violet-500/10 border-violet-500/20 text-violet-700';
    case 'amber': return 'bg-amber-500/10 border-amber-500/20 text-amber-700';
    case 'rose': return 'bg-rose-500/10 border-rose-500/20 text-rose-700';
    default: return 'bg-[var(--surface-alt)] border-[var(--border)] text-[var(--text-tertiary)]';
  }
};

const toneText = (tone = 'slate') => {
  switch (tone) {
    case 'green': return 'text-royal-green-600';
    case 'blue': return 'text-royal-blue-600';
    case 'amber': return 'text-amber-600';
    case 'violet': return 'text-violet-600';
    case 'rose': return 'text-rose-600';
    default: return 'text-[var(--text-primary)]';
  }
};

const proofCards = [
  {
    title: 'Sample Report',
    href: '/sample-report',
    label: 'Cross-channel',
    body: 'See how hotel spend, revenue, ROAS, platform mix, and campaign movement should look in one report.',
    metric: 'Hotel overview',
    tone: 'green',
  },
  {
    title: 'Expedia Report',
    href: '/expedia-report',
    label: 'XPR drill-in',
    body: 'Open the Expedia TravelAds report view built for OTA spend, bookings, revenue, and ROAS review.',
    metric: 'OTA detail',
    tone: 'blue',
  },
];
---

<Layout
  title="Hotel Advertising Learning Center | Advertising Systems Blog"
  description="Visual hotel advertising guides for owners, GMs, and revenue teams. Learn OTA ads, Google Hotel Ads, Meta retargeting, ROAS reporting, and budget automation."
  breadcrumbs={breadcrumbs}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Advertising Systems Hotel Advertising Learning Center',
    url: 'https://advertisingsystems.ai/blog',
    description: 'Visual hotel advertising guides and reports for hospitality teams.',
    publisher: {
      '@type': 'Organization',
      name: 'Advertising Systems'
    }
  }}
>
  <Navbar />
  <Breadcrumb items={breadcrumbs} />
  <main>
    <section class="relative pt-32 pb-16 sm:pt-40 sm:pb-20 overflow-hidden" aria-labelledby="blog-heading">
      <div class="mesh-gradient absolute inset-0"></div>
      <div class="dot-grid absolute inset-0"></div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-[minmax(0,1fr)_420px] gap-10 lg:gap-14 items-center">
          <div class="max-w-3xl">
            <div class="reveal inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface-glass)] px-4 py-2 mb-7">
              <span class="w-2 h-2 rounded-full bg-royal-green-500"></span>
              <span class="text-sm font-semibold text-[var(--text-tertiary)]">{hotelPosts.length} hotel learning modules</span>
            </div>

            <p class="reveal text-sm font-bold text-royal-blue-600 uppercase tracking-[0.16em] mb-4">
              Hotel advertising learning center
            </p>
            <h1 id="blog-heading" class="reveal text-4xl sm:text-5xl lg:text-6xl font-bold text-[var(--text-primary)] leading-tight tracking-[-0.03em]">
              Learn the report before you buy the software.
            </h1>
            <p class="reveal mt-6 text-lg sm:text-xl text-[var(--text-tertiary)] max-w-2xl leading-relaxed">
              Short visual guides for hotel owners, GMs, and revenue teams who want to understand OTA ads, direct bookings, ROAS, and budget automation without reading platform manuals.
            </p>

            <div class="reveal mt-8 flex flex-col sm:flex-row gap-3">
              <a href="/sample-report" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-royal-green-500 text-white font-semibold text-base px-6 py-3.5 rounded-lg hover:bg-royal-green-600 transition-colors">
                View Sample Report
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <a href="/book-demo" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 btn-secondary font-semibold text-base px-6 py-3.5 rounded-lg">
                Book a Demo
              </a>
            </div>
          </div>

          <div class="reveal glass-strong rounded-2xl p-5 sm:p-6 border border-[var(--border)]">
            <div class="flex items-center justify-between gap-4 mb-5">
              <div>
                <p class="text-xs font-bold text-[var(--text-muted)] uppercase tracking-[0.12em]">Owner view</p>
                <h2 class="text-lg font-bold text-[var(--text-primary)] mt-1">Ad mix snapshot</h2>
              </div>
              <span class="text-xs font-bold rounded-full bg-royal-green-500/10 text-royal-green-700 px-3 py-1">Live report</span>
            </div>

            <div class="grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--border)]">
              <div class="bg-[var(--surface)] p-4">
                <p class="text-xs font-semibold text-[var(--text-muted)]">Spend</p>
                <p class="text-2xl font-bold text-[var(--text-primary)] mt-1">$255k</p>
              </div>
              <div class="bg-[var(--surface)] p-4">
                <p class="text-xs font-semibold text-[var(--text-muted)]">ROAS</p>
                <p class="text-2xl font-bold text-royal-blue-600 mt-1">4.8x</p>
              </div>
              <div class="bg-[var(--surface)] p-4">
                <p class="text-xs font-semibold text-[var(--text-muted)]">Revenue</p>
                <p class="text-2xl font-bold text-royal-green-600 mt-1">$1.23M</p>
              </div>
              <div class="bg-[var(--surface)] p-4">
                <p class="text-xs font-semibold text-[var(--text-muted)]">Campaigns</p>
                <p class="text-2xl font-bold text-amber-600 mt-1">3</p>
              </div>
            </div>

            <div class="mt-6 space-y-4">
              {[
                { name: 'Google Hotel Ads', value: '42%', color: 'bg-royal-blue-500' },
                { name: 'Expedia TravelAds', value: '28%', color: 'bg-amber-500' },
                { name: 'Meta Retargeting', value: '18%', color: 'bg-rose-500' },
                { name: 'Booking Sponsored', value: '12%', color: 'bg-violet-500' },
              ].map((row) => (
                <div>
                  <div class="flex items-center justify-between gap-4 text-sm font-semibold">
                    <span class="text-[var(--text-secondary)]">{row.name}</span>
                    <span class="text-[var(--text-primary)]">{row.value}</span>
                  </div>
                  <div class="mt-2 h-2 rounded-full bg-[var(--progress-track)] overflow-hidden">
                    <div class={`h-full rounded-full ${row.color}`} style={`width: ${row.value}`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-10" aria-label="Report previews">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-5">
          {proofCards.map((card) => (
            <a href={card.href} class="group block rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 sm:p-7 hover:border-royal-blue-500/30 hover:bg-royal-blue-500/5 transition-all">
              <div class="flex flex-col min-[420px]:flex-row min-[420px]:items-start min-[420px]:justify-between gap-4">
                <div>
                  <span class={`inline-flex text-xs font-bold px-2.5 py-1 rounded-full border ${card.tone === 'green' ? 'bg-royal-green-500/10 border-royal-green-500/20 text-royal-green-700' : 'bg-royal-blue-500/10 border-royal-blue-500/20 text-royal-blue-700'}`}>
                    {card.label}
                  </span>
                  <h2 class="mt-4 text-2xl font-bold text-[var(--text-primary)] tracking-[-0.02em]">{card.title}</h2>
                  <p class="mt-3 text-sm sm:text-base text-[var(--text-tertiary)] leading-relaxed">{card.body}</p>
                </div>
                <div class="shrink-0 w-14 h-14 rounded-xl border border-[var(--border)] bg-[var(--surface-alt)] flex items-center justify-center text-[var(--text-primary)] group-hover:text-royal-blue-600 transition-colors">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25m0 0h7.5m-7.5 0l3 3m-3-3l3-3m4.5 3H18A2.25 2.25 0 0020.25 14.25V3m-16.5 0h16.5m-16.5 0H3m17.25 0H21" />
                  </svg>
                </div>
              </div>
              <div class="mt-5 flex flex-col min-[420px]:flex-row min-[420px]:items-center min-[420px]:justify-between gap-3 min-[420px]:gap-4 pt-5 border-t border-[var(--border)]">
                <span class="text-sm font-bold text-[var(--text-primary)]">{card.metric}</span>
                <span class="inline-flex items-center gap-1 text-sm font-semibold text-royal-blue-600 group-hover:gap-2 transition-all">Open report -></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <div class="section-line"></div>

    <section class="py-16 sm:py-20" aria-labelledby="learning-path-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-9">
          <div>
            <p class="text-sm font-bold text-royal-blue-600 uppercase tracking-[0.16em] mb-3">Step-by-step modules</p>
            <h2 id="learning-path-heading" class="text-3xl sm:text-4xl font-bold text-[var(--text-primary)] tracking-[-0.03em]">
              Learn hotel ads in the order owners ask questions.
            </h2>
          </div>
          <p class="max-w-xl text-[var(--text-tertiary)] leading-relaxed">
            Each module is designed to be scanned first: metrics, diagrams, comparisons, then a report or demo action.
          </p>
        </div>

        <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(280px,360px)] gap-4 lg:items-start mb-8">
          <div class="flex flex-wrap gap-2" role="tablist" aria-label="Filter hotel advertising modules">
            {categories.map((cat) => (
              <button
                type="button"
                class="blog-filter px-4 py-2 rounded-full text-sm font-semibold transition-colors data-[active]:bg-[var(--surface-alt)] data-[active]:text-[var(--text-primary)] data-[active]:border-[var(--border)] border border-[var(--border)] text-[var(--text-tertiary)] hover:bg-[var(--surface-alt)] hover:text-[var(--text-primary)]"
                data-category={cat === 'All' ? '*' : cat}
                data-active={cat === 'All' ? 'true' : undefined}
              >
                {cat}
              </button>
            ))}
          </div>

          <div class="w-full">
            <label for="blog-search" class="sr-only">Search blog articles</label>
            <div class="relative">
              <svg class="pointer-events-none absolute left-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--text-muted)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
              </svg>
              <input
                id="blog-search"
                type="search"
                autocomplete="off"
                placeholder="Search hotel ads, ROAS, Expedia..."
                class="w-full rounded-full border border-[var(--border)] bg-[var(--surface)] py-3 pl-11 pr-12 text-sm font-semibold text-[var(--text-primary)] outline-none transition-colors placeholder:text-[var(--text-muted)] focus:border-royal-blue-500/60 focus:bg-royal-blue-500/5"
              />
              <button
                type="button"
                id="blog-search-clear"
                class="absolute right-3 top-1/2 hidden h-7 w-7 -translate-y-1/2 items-center justify-center rounded-full border border-[var(--border)] bg-[var(--surface-alt)] text-[var(--text-muted)] transition-colors hover:text-[var(--text-primary)]"
                aria-label="Clear blog search"
              >
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
            <p id="blog-search-status" class="mt-3 text-xs font-semibold text-[var(--text-muted)]" aria-live="polite">
              Showing all hotel learning modules.
            </p>
          </div>
        </div>

        <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-5" id="blog-grid">
          {hotelPosts.map((post, index) => (
            <a
              href={`/blog/${post.slug}`}
              class="blog-card group rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 hover:border-royal-blue-500/30 hover:bg-royal-blue-500/5 transition-all flex flex-col min-h-[360px]"
              data-category={post.category}
              data-search={`${post.title} ${post.excerpt} ${post.category} ${post.learningTrack ?? ''} ${post.intent ?? ''} ${(post.heroStats ?? []).map((stat) => `${stat.label} ${stat.value} ${stat.caption ?? ''}`).join(' ')}`}
            >
              <div class="flex flex-col min-[420px]:flex-row min-[420px]:items-start min-[420px]:justify-between gap-3">
                <span class={`inline-flex text-xs font-bold px-2.5 py-1 rounded-full border ${categoryColor(post.color)}`}>
                  {post.category}
                </span>
                <span class="text-xs font-bold text-[var(--text-muted)]">{String(index + 1).padStart(2, '0')}</span>
              </div>

              <h3 class="mt-5 text-xl font-bold text-[var(--text-primary)] leading-tight tracking-[-0.02em] group-hover:text-royal-blue-600 transition-colors">
                {post.title}
              </h3>
              <p class="mt-3 text-sm text-[var(--text-tertiary)] leading-relaxed">
                {post.excerpt}
              </p>

              <div class="mt-5 grid grid-cols-1 min-[420px]:grid-cols-3 gap-px overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--border)]">
                {(post.heroStats ?? []).slice(0, 3).map((stat) => (
                  <div class="bg-[var(--surface)] p-3 min-w-0">
                    <p class={`text-base font-bold truncate ${toneText(stat.tone)}`}>{stat.value}</p>
                    <p class="mt-1 text-[10px] font-semibold uppercase tracking-[0.08em] text-[var(--text-muted)] truncate">{stat.label}</p>
                  </div>
                ))}
              </div>

              <div class="mt-auto pt-6 flex items-center justify-between gap-3">
                <span class="text-xs font-semibold text-[var(--text-muted)]">{post.readTime}</span>
                <span class="inline-flex items-center gap-1 text-sm font-semibold text-royal-blue-600 group-hover:gap-2 transition-all">Read module -></span>
              </div>
            </a>
          ))}
        </div>

        <div id="blog-empty-state" class="hidden rounded-2xl border border-dashed border-[var(--border)] bg-[var(--surface)] p-8 text-center">
          <h3 class="text-xl font-bold text-[var(--text-primary)]">No matching blog modules</h3>
          <p class="mt-3 text-sm font-medium text-[var(--text-tertiary)]">
            Try a broader search like “Expedia”, “ROAS”, “Booking”, “Google”, or clear the selected category.
          </p>
        </div>
      </div>
    </section>

    {archivePosts.length > 0 && (
      <>
        <div class="section-line"></div>
        <section id="archive-section" class="py-16" aria-labelledby="archive-heading">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-7">
              <div>
                <p class="text-sm font-bold text-[var(--text-muted)] uppercase tracking-[0.16em] mb-3">More resources</p>
                <h2 id="archive-heading" class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)] tracking-[-0.02em]">Advertising Systems archive</h2>
              </div>
              <p class="max-w-lg text-sm text-[var(--text-tertiary)] leading-relaxed">
                Product updates, case studies, and broader ad strategy posts are still available below.
              </p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
              {archivePosts.map((post) => (
                <a
                  href={`/blog/${post.slug}`}
                  class="archive-card group rounded-xl border border-[var(--border)] bg-[var(--surface)] p-5 hover:border-royal-blue-500/30 hover:bg-royal-blue-500/5 transition-all"
                  data-search={`${post.title} ${post.excerpt} ${post.category} ${post.author.name} ${post.author.role ?? ''}`}
                >
                  <span class={`inline-flex text-xs font-bold px-2.5 py-1 rounded-full border ${categoryColor(post.color)}`}>
                    {post.category}
                  </span>
                  <h3 class="mt-4 text-lg font-bold text-[var(--text-primary)] group-hover:text-royal-blue-600 transition-colors leading-snug">
                    {post.title}
                  </h3>
                  <p class="mt-2 text-sm text-[var(--text-tertiary)] leading-relaxed">{post.excerpt}</p>
                </a>
              ))}
            </div>
          </div>
        </section>
      </>
    )}

    <div class="section-line"></div>

    <section class="py-16 sm:py-20" aria-labelledby="newsletter-heading">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-6 sm:p-8">
          <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(280px,360px)] gap-6 lg:items-end">
            <div>
              <p class="text-sm font-bold text-royal-blue-600 uppercase tracking-[0.16em] mb-3">AdvertisingSystems updates</p>
              <h2 id="newsletter-heading" class="text-2xl sm:text-3xl font-bold text-[var(--text-primary)] tracking-[-0.02em]">
                Get hotel advertising notes in your inbox.
              </h2>
              <p class="mt-3 text-sm sm:text-base text-[var(--text-tertiary)] leading-relaxed">
                Short updates on OTA ads, ROAS reporting, budget automation, and owner-ready reporting.
              </p>
            </div>
            <form id="blog-newsletter-form" action="/api/newsletter" method="POST" class="space-y-3" aria-label="Newsletter subscription form">
              <label for="newsletter-email" class="sr-only">Email address</label>
              <div class="flex flex-col sm:flex-row gap-3">
                <input
                  id="newsletter-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  maxlength="254"
                  placeholder="you@company.com"
                  class="min-w-0 flex-1 rounded-lg border border-[var(--border)] bg-[var(--surface-alt)] px-4 py-3 text-sm font-semibold text-[var(--text-primary)] outline-none transition-colors placeholder:text-[var(--text-muted)] focus:border-royal-blue-500/60"
                />
                <button
                  id="blog-newsletter-submit"
                  type="submit"
                  class="inline-flex items-center justify-center rounded-lg bg-royal-green-500 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-royal-green-600 disabled:cursor-not-allowed disabled:opacity-60"
                >
                  Subscribe
                </button>
              </div>
              <div class="hidden" aria-hidden="true">
                <label for="newsletter-website">Website</label>
                <input id="newsletter-website" name="website" type="text" tabindex="-1" autocomplete="off" />
              </div>
              <p id="blog-newsletter-message" class="hidden rounded-lg p-3 text-sm font-semibold" role="alert"></p>
            </form>
          </div>
        </div>
      </div>
    </section>

    <script>
      const searchInput = document.getElementById('blog-search') as HTMLInputElement | null;
      const clearSearchButton = document.getElementById('blog-search-clear') as HTMLButtonElement | null;
      const searchStatus = document.getElementById('blog-search-status');
      const emptyState = document.getElementById('blog-empty-state');
      const archiveSection = document.getElementById('archive-section');
      const newsletterForm = document.getElementById('blog-newsletter-form') as HTMLFormElement | null;
      const newsletterSubmit = document.getElementById('blog-newsletter-submit') as HTMLButtonElement | null;
      const newsletterMessage = document.getElementById('blog-newsletter-message');
      const hotelCards = Array.from(document.querySelectorAll('.blog-card')) as HTMLElement[];
      const archiveCards = Array.from(document.querySelectorAll('.archive-card')) as HTMLElement[];
      const allSearchableCards = [...hotelCards, ...archiveCards];
      let activeCategory = '*';

      function normalize(value: string | null | undefined) {
        return (value ?? '').toLowerCase().replace(/\s+/g, ' ').trim();
      }

      function setCardVisible(card: HTMLElement, visible: boolean) {
        card.hidden = !visible;
      }

      function updateSearchClearButton(query: string) {
        if (!clearSearchButton) return;
        clearSearchButton.classList.toggle('hidden', query.length === 0);
        clearSearchButton.classList.toggle('inline-flex', query.length > 0);
      }

      function getClientSubmissionId(prefix: string) {
        if (window.crypto?.randomUUID) return `${prefix}-${window.crypto.randomUUID()}`;
        return `${prefix}-${Date.now()}-${Math.random().toString(36).slice(2)}`;
      }

      function getNewsletterContext() {
        const params = new URLSearchParams(window.location.search);
        const sourcePage = params.get('source_page');
        return {
          landingPage: sourcePage ? (sourcePage.charAt(0) === '/' ? sourcePage : '/' + sourcePage) : window.location.pathname,
          referrer: document.referrer || undefined,
          cta: params.get('cta') || 'Newsletter Subscribe',
          posthogDistinctId: window.posthog?.get_distinct_id?.() || undefined,
          utm: {
            source: params.get('utm_source') || undefined,
            medium: params.get('utm_medium') || undefined,
            campaign: params.get('utm_campaign') || undefined,
          },
        };
      }

      function setNewsletterMessage(text: string, isError: boolean) {
        if (!newsletterMessage) return;
        newsletterMessage.textContent = text;
        newsletterMessage.className = isError
          ? 'rounded-lg border border-red-500/20 bg-red-500/10 p-3 text-sm font-semibold text-red-700'
          : 'rounded-lg border border-emerald-100 bg-emerald-50 p-3 text-sm font-semibold text-emerald-950';
        newsletterMessage.classList.remove('hidden');
      }

      function applyBlogFilters() {
        const query = normalize(searchInput?.value);
        let visibleHotelCount = 0;
        let visibleArchiveCount = 0;

        hotelCards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          const matchesCategory = activeCategory === '*' || cardCategory === activeCategory;
          const searchableText = normalize(card.getAttribute('data-search'));
          const matchesSearch = query.length === 0 || searchableText.includes(query);
          const show = matchesCategory && matchesSearch;

          setCardVisible(card, show);
          if (show) visibleHotelCount += 1;
        });

        archiveCards.forEach((card) => {
          const searchableText = normalize(card.getAttribute('data-search'));
          const matchesSearch = query.length === 0 || searchableText.includes(query);

          setCardVisible(card, matchesSearch);
          if (matchesSearch) visibleArchiveCount += 1;
        });

        const totalVisible = visibleHotelCount + visibleArchiveCount;
        updateSearchClearButton(query);

        if (emptyState) {
          emptyState.classList.toggle('hidden', totalVisible > 0);
        }

        if (archiveSection) {
          archiveSection.classList.toggle('hidden', query.length > 0 && visibleArchiveCount === 0);
        }

        if (searchStatus) {
          if (query.length > 0) {
            searchStatus.textContent = `${totalVisible} result${totalVisible === 1 ? '' : 's'} for "${searchInput?.value.trim()}".`;
          } else if (activeCategory !== '*') {
            searchStatus.textContent = `${visibleHotelCount} module${visibleHotelCount === 1 ? '' : 's'} in ${activeCategory}.`;
          } else {
            searchStatus.textContent = 'Showing all hotel learning modules.';
          }
        }
      }

      document.querySelectorAll('.blog-filter').forEach((btn) => {
        btn.addEventListener('click', () => {
          activeCategory = btn.getAttribute('data-category') ?? '*';
          document.querySelectorAll('.blog-filter').forEach((b) => b.removeAttribute('data-active'));
          btn.setAttribute('data-active', '');
          applyBlogFilters();
        });
      });

      searchInput?.addEventListener('input', applyBlogFilters);
      searchInput?.addEventListener('search', applyBlogFilters);
      clearSearchButton?.addEventListener('click', () => {
        if (!searchInput) return;
        searchInput.value = '';
        searchInput.focus();
        applyBlogFilters();
      });

      newsletterForm?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (newsletterSubmit) newsletterSubmit.disabled = true;
        newsletterMessage?.classList.add('hidden');

        const emailInput = newsletterForm.querySelector('#newsletter-email') as HTMLInputElement | null;
        const honeypot = newsletterForm.querySelector('#newsletter-website') as HTMLInputElement | null;
        const email = emailInput?.value.trim() || '';
        try {
          let analyticsConsent = '';
          try { analyticsConsent = localStorage.getItem('ads_cookie_consent') === 'accepted' ? 'accepted' : ''; } catch (e) {}
          const response = await fetch(newsletterForm.action, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Analytics-Consent': analyticsConsent,
            },
            body: JSON.stringify({
              email,
              website: honeypot?.value.trim(),
              client_submission_id: getClientSubmissionId('newsletter'),
              context: getNewsletterContext(),
            }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || 'Could not subscribe this email.');

          if (email) window.posthog?.identify?.(email);
          window.posthog?.capture?.('newsletter_form_submitted', {
            status: 'accepted',
          });
          setNewsletterMessage(data.message || "You're subscribed.", false);
          newsletterForm.reset();
        } catch (error) {
          const message = error instanceof Error ? error.message : 'Could not subscribe this email.';
          window.posthog?.capture?.('newsletter_form_errored', { error_message: message });
          setNewsletterMessage(message, true);
        } finally {
          if (newsletterSubmit) newsletterSubmit.disabled = false;
        }
      });

      allSearchableCards.forEach((card) => {
        card.setAttribute('data-search', normalize(card.getAttribute('data-search')));
      });

      applyBlogFilters();
    </script>

    <div class="section-line"></div>

    <FAQSection title="Common questions" faqs={blogFaqs} name="blog-faq" />

    <div class="section-line"></div>

    <section class="relative py-24 sm:py-28 overflow-hidden" aria-labelledby="blog-cta-heading">
      <div class="dot-grid absolute inset-0"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-sm font-bold text-royal-blue-600 uppercase tracking-[0.16em] mb-4">Ready to map this to your hotel?</p>
        <h2 id="blog-cta-heading" class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[var(--text-primary)] leading-tight tracking-[-0.03em]">
          Bring your channels into one owner-ready report.
        </h2>
        <p class="mt-6 text-lg text-[var(--text-tertiary)] max-w-2xl mx-auto leading-relaxed">
          Walk through your Google, Meta, Expedia, and Booking.com advertising mix with a real report view.
        </p>

        <div class="mt-9 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/book-demo" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-royal-green-500 text-white font-semibold text-base px-8 py-3.5 rounded-lg hover:bg-royal-green-600 transition-colors">
            Book a Demo
          </a>
          <a href="/expedia-report" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 btn-secondary font-semibold text-base px-8 py-3.5 rounded-lg">
            Open Expedia Report
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
