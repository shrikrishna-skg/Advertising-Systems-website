---
import { readFileSync } from 'fs';
import { join } from 'path';

// Read the Expedia report HTML and strip the outer html/head/body tags so we can inject it cleanly.
const raw = readFileSync(join(process.cwd(), 'public/sample-report-embed.html'), 'utf-8');
const blockedPatterns = [/navigator\.geolocation/, /chrome\.runtime/, /new Function/, /eval\(/];
if (blockedPatterns.some((pattern) => pattern.test(raw))) {
  throw new Error('Unsafe script pattern found in public/sample-report-embed.html');
}

const bodyMatch = raw.match(/<body[^>]*>([\s\S]*)<\/body>/i);
const bodyContent = bodyMatch ? bodyMatch[1] : raw;

const styleMatches = [...raw.matchAll(/<style[^>]*>([\s\S]*?)<\/style>/gi)];
const styles = styleMatches.map((m) => m[0]).join('\n');

const chartScript = raw.includes('chart.js') ? '<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>' : '';

const fontLink = raw.includes('fonts.googleapis.com')
  ? '<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800;9..40,900&display=swap" rel="stylesheet">'
  : '';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="light only" />
  <title>Expedia Ads Report — Select-Service Hotel · April 2026 | Advertising Systems</title>
  <meta name="description" content="Real Expedia TravelAds report from a managed select-service hotel, April 2026 (property withheld). $432 ad spend → $9,525 revenue → 22:1 ROAS. See the full booking funnel, daily trends, AI recommendations, and reputation insights." />
  <link rel="canonical" href="https://www.advertisingsystems.ai/expedia-report" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://www.advertisingsystems.ai/expedia-report" />
  <meta property="og:title" content="Expedia Ads Report — Select-Service Hotel · April 2026 | Advertising Systems" />
  <meta property="og:description" content="Real Expedia TravelAds report from a managed select-service hotel, April 2026 (property withheld). $432 ad spend → $9,525 revenue → 22:1 ROAS." />
  <meta property="og:image" content="https://www.advertisingsystems.ai/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Advertising Systems" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Expedia Ads Report — Select-Service Hotel · April 2026 | Advertising Systems" />
  <meta name="twitter:image" content="https://www.advertisingsystems.ai/og-image.png" />
  <Fragment set:html={fontLink} />
  <Fragment set:html={chartScript} />
  <Fragment set:html={styles} />
  <style>
    body { margin: 0; padding: 0; }
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": "https://www.advertisingsystems.ai/expedia-report#article",
    "headline": "Expedia Ads Report — Select-Service Hotel · April 2026",
    "description": "Expedia TravelAds performance report from a managed select-service hotel, April 2026 (property withheld): spend, booking funnel, daily trends and recommended actions.",
    "image": "https://www.advertisingsystems.ai/og-image.png",
    "datePublished": "2026-05-01",
    "dateModified": "2026-08-15",
    "inLanguage": "en",
    "isPartOf": { "@id": "https://www.advertisingsystems.ai/#website" },
    "author": { "@id": "https://www.advertisingsystems.ai/#organization" },
    "publisher": { "@id": "https://www.advertisingsystems.ai/#organization" },
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.advertisingsystems.ai/expedia-report" }
  }
  </script>
</head>
<body>
  <Fragment set:html={bodyContent} />
</body>
</html>
