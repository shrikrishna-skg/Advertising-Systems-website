---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';

const breadcrumbs = [{ name: 'Privacy Policy', href: '/privacy' }];
---

<Layout
  title="Privacy Policy — Advertising Systems | Your Data & How We Use It"
  description="What data we collect, how we use it, and how we protect it. Your privacy and control over your information."
  breadcrumbs={breadcrumbs}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />
    <PageHero
      title="Privacy Policy."
      lead="In short: we use your data to run and improve the product, we don't sell it to third parties, and you can request access or deletion anytime. Details below."
      fine="Last updated: March 2026"
    />

    <section class="sec">
      <div class="wrap">
        <div class="legal">

        <section>
          <h2>1. Data We Collect</h2>
          <p>Multisystems Inc. ("we," "us," or "Advertising Systems") collects the following categories of information:</p>
          <ul>
            <li><strong>Account Information:</strong> Name, email address, company name, and billing details you provide during registration.</li>
            <li><strong>Usage Data:</strong> Pages visited, features used, campaign configurations, and interaction logs within the platform.</li>
            <li><strong>Device &amp; Technical Data:</strong> IP address, browser type, operating system, and device identifiers.</li>
            <li><strong>Third-Party Data:</strong> Advertising performance metrics synced from connected platforms (Google Ads, Meta Ads, etc.).</li>
          </ul>
        </section>

        <section>
          <h2>2. How We Use Your Data</h2>
          <ul>
            <li>To provide, maintain, and improve the Advertising Systems platform.</li>
            <li>To personalize your experience and deliver AI-powered optimization recommendations.</li>
            <li>To process payments and manage your subscription.</li>
            <li>To communicate service updates, security alerts, and product announcements.</li>
            <li>To analyze aggregate usage patterns and improve platform performance.</li>
          </ul>
        </section>

        <section>
          <h2>3. Data Sharing</h2>
          <p>We do not sell your personal data. We may share information with:</p>
          <ul>
            <li><strong>Service Providers:</strong> Infrastructure partners (hosting, payment processing) who process data on our behalf under strict agreements.</li>
            <li><strong>Connected Platforms:</strong> Ad networks you authorize us to connect with, solely to manage your campaigns.</li>
            <li><strong>Legal Compliance:</strong> When required by law, regulation, or valid legal process.</li>
          </ul>
        </section>

        <section>
          <h2>4. Cookies &amp; Tracking</h2>
          <p>
            We use essential cookies to keep you signed in and analytics cookies to understand how the platform is used. Marketing cookies are only set with your consent. For full details, see our <a href="/cookies">Cookie Policy</a>.
          </p>
        </section>

        <section>
          <h2>5. Your Rights</h2>
          <p>Depending on your jurisdiction, you may have the right to:</p>
          <ul>
            <li>Access, correct, or delete your personal data.</li>
            <li>Export your data in a portable format.</li>
            <li>Withdraw consent for optional data processing.</li>
            <li>Object to or restrict certain processing activities.</li>
            <li>Lodge a complaint with your local data protection authority.</li>
          </ul>
        </section>

        <section>
          <h2>6. Contact Us</h2>
          <p>
            For privacy-related inquiries, contact our Data Protection team at
            <a href="mailto:privacy@advertisingsystems.ai">privacy@advertisingsystems.ai</a>
            or write to: Multisystems Inc., Privacy Team, 548 Market St, Suite 35435, San Francisco, CA 94104.
          </p>
        </section>

        </div>
        <p class="fine"><a href="/faq">Read the FAQ →</a> <span> or </span> <a href="/contact">contact us</a></p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
