---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import FAQSection from '../../components/FAQSection.astro';
import { featureSubpageFaqs } from '../../data/page-faqs';

/**
 * AI Optimization Engine — Terminal conversion.
 *
 * COPY / HONESTY: the old mockup ended in a "Performance Impact" strip reading
 * −40% CPA, +38% Budget Efficiency, 12 New Audiences. Those are the same
 * outcome claims the Wave 3 honesty pass deleted from features/index ("40%
 * lower CPA"), re-appearing here as tiles. An "Illustrative" chip on the
 * browser frame does not cover a strip labelled Performance Impact.
 * Replaced with the decision-log pattern the homepage already uses: what the
 * engine DID, with its reason and its amount — verifiable in kind, not a
 * result we cannot stand behind.
 *
 * The retained figures ("every 15 minutes", "50,000+ signals per account") are
 * existing site copy from src/data/faq.ts, not new assertions.
 */
const painPoints = [
  {
    n: '01',
    title: 'Bidding by gut feel',
    desc: 'Hundreds of keywords, audiences and placements, reviewed when someone has time. The market moves between reviews.',
  },
  {
    n: '02',
    title: 'Budget stuck in the wrong campaign',
    desc: 'The underperformer keeps its daily cap while the best campaign runs out of budget by 2pm. Nothing moves until a human notices.',
  },
  {
    n: '03',
    title: 'Segments nobody has time to find',
    desc: 'The signal for a profitable audience is already in your account data. Finding it by hand across millions of impressions is not a job.',
  },
];

const capabilities = [
  {
    n: '01',
    title: 'Autonomous bidding',
    desc: 'Bids move on a 15-minute cycle across every keyword, audience and placement — inside guardrails you set, not instead of them.',
  },
  {
    n: '02',
    title: 'Budget reallocation',
    desc: 'Spend shifts from underperformers to the campaigns earning it, across channels, without waiting for a weekly review.',
  },
  {
    n: '03',
    title: 'Audience discovery',
    desc: 'Models surface converting segments out of the behavioural signals already in your connected accounts.',
  },
  {
    n: '04',
    title: 'Approval workflow',
    desc: 'Run it autonomously or hold every decision for review. The engine proposes; you decide how much rope it gets.',
  },
];

const engineState = [
  { k: 'Decision interval', v: '15 min' },
  { k: 'Signals per account', v: '50,000+' },
  { k: 'Decisions logged today', v: '847' },
  { k: 'Guardrail breaches', v: '0' },
];

const log = [
  { t: '01:48', src: 'GOOGLE ADS', body: 'Bid raised on <b>"hotel deals europe"</b> — converting below target CPA at current position.', amt: '−22% CPA', dir: 'up' },
  { t: '02:14', src: 'PORTFOLIO', body: 'Moved $340 from <b>Q1 Search</b> to <b>Retargeting — Cart</b> on 7-day trailing ROAS.', amt: '$340', dir: '' },
  { t: '03:40', src: 'META', body: 'Segment surfaced: <b>luxury travel, 35–54, mobile</b>. Held for approval, not launched.', amt: 'Review', dir: '' },
  { t: '04:02', src: 'MICROSOFT', body: 'Placement excluded — spend without a conversion across the last 14 days.', amt: '+$120/wk', dir: 'up' },
  { t: '05:31', src: 'EXPEDIA', body: 'Property bid held at tier 2 — incremental cost per booking above the guardrail.', amt: 'Hold', dir: '' },
];

const relatedFeatures = [
  { n: '01', title: 'Campaign Intelligence', href: '/features/campaign-management', fact: 'One dashboard, every channel' },
  { n: '03', title: 'Performance Analytics', href: '/features/analytics', fact: 'Attribution to booking revenue' },
  { n: '04', title: 'Automation Studio', href: '/features/automation', fact: 'Rules run around the clock' },
  { n: '05', title: 'Budget Allocator', href: '/features/budget-intelligence', fact: 'Cross-channel reallocation' },
];
---

<Layout
  breadcrumbs={[{ name: 'Features', href: '/features' }, { name: 'AI Optimization', href: '/features/ai-optimization' }]}
  title="AI Optimization Engine — Autonomous Campaigns | Advertising Systems"
  description="Autonomous bidding, budget reallocation and audience discovery. The engine works bids and budgets every 15 minutes inside guardrails you set."
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={[{ name: 'Features', href: '/features' }, { name: 'AI Optimization', href: '/features/ai-optimization' }]} />

    <PageHero
      badge="Module 02 of 5"
      title="AI Optimization Engine."
      titleAccent="Bids and budgets, worked continuously."
      lead="Bids, budgets, targeting and placements adjust on a 15-minute cycle inside guardrails you set — with an approval workflow when you want the final word."
      primaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      secondaryCta={{ text: 'See pricing', href: '/pricing' }}
    />

    <!-- 01 · The problem -->
    <section class="sec" aria-labelledby="pain-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="pain-heading">The market moves between reviews.</h2>
            <p class="sub">Optimisation done on a human schedule is optimisation done late.</p>
          </div>
        </div>
        <div class="cardgrid pain">
          {painPoints.map((point) => (
            <div>
              <div class="cn">{point.n}</div>
              <h3>{point.title}</h3>
              <p>{point.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 · The log -->
    <section class="sec soft" aria-labelledby="mockup-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="mockup-heading">Every decision, with its reason and its amount.</h2>
            <p class="sub">
              An autonomous engine is only worth running if you can read back what it did. Nothing
              happens to your budget overnight that you cannot audit the next morning.
            </p>
          </div>
        </div>

        <div class="panel-box">
          <div class="panel-hd">
            <h3>Optimization log — last 24 hours</h3>
            <span class="illus">Illustrative</span>
          </div>

          <div class="kpis">
            {engineState.map((item) => (
              <div class="kpi">
                <span class="k">{item.k}</span>
                <span class="v num">{item.v}</span>
              </div>
            ))}
          </div>

          {log.map(({ t, src, body, amt, dir }) => (
            <div class="log-row">
              <span class="t num">{t}</span>
              <span class="src">{src}</span>
              <p set:html={body}></p>
              <span class={dir ? `amt ${dir} num` : 'amt num'}>{amt}</span>
            </div>
          ))}
        </div>
        <p class="fine">Guardrails, approval mode and the log are the same three things on every connected channel.</p>
      </div>
    </section>

    <!-- 03 · Capabilities -->
    <section class="sec" aria-labelledby="capabilities-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div>
            <h2 id="capabilities-heading">What the module does.</h2>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {capabilities.map((cap) => (
            <div>
              <div class="cn">{cap.n}</div>
              <h3>{cap.title}</h3>
              <p>{cap.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 · The rest of the stack -->
    <section class="sec soft" aria-labelledby="related-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">04</span>
          <div>
            <h2 id="related-heading">The other four modules.</h2>
            <p class="sub">Same connected accounts, same ledger — nothing needs reconciling between them.</p>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {relatedFeatures.map((feature) => (
            <a href={feature.href} class="r-card">
              <div class="cn">{feature.n}</div>
              <h3>{feature.title}</h3>
              <span class="r-fact">{feature.fact}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={featureSubpageFaqs} name="ai-faq" no="05" soft={false} />
    <CTABand />
  </main>
  <Footer />

  <style>
    .pain .cn { color: var(--neg); }

    .kpis {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-bottom: 1px solid var(--border);
    }
    .kpi { padding: 14px 16px; border-right: 1px solid var(--border); min-width: 0; }
    .kpi:last-child { border-right: 0; }
    .kpi .k {
      display: block;
      font-size: 9.5px; font-weight: 700; letter-spacing: 0.11em;
      text-transform: uppercase; color: var(--text-tertiary);
    }
    .kpi .v {
      display: block; margin-top: 5px;
      font-size: 21px; font-weight: 800; letter-spacing: -0.02em;
      color: var(--text-primary);
    }
    @media (max-width: 640px) {
      .kpis { grid-template-columns: repeat(2, 1fr); }
      .kpi:nth-child(2) { border-right: 0; }
      .kpi:nth-child(-n+2) { border-bottom: 1px solid var(--border); }
    }

    /* Same row grammar as the homepage decision log — one pattern site-wide. */
    .log-row {
      display: grid;
      grid-template-columns: 66px 128px 1fr auto;
      gap: 16px;
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
      align-items: center;
    }
    .log-row:last-child { border-bottom: 0; }
    .log-row .t { font-size: 11.5px; color: var(--text-tertiary); }
    .log-row .src { font-size: 11px; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary); }
    .log-row p { color: var(--text-secondary); line-height: 1.5; }
    .log-row p :global(b) { color: var(--text-primary); font-weight: 700; }
    .log-row .amt { font-weight: 700; white-space: nowrap; color: var(--text-primary); }
    .log-row .amt.up { color: var(--pos); }
    @media (max-width: 640px) {
      .log-row { grid-template-columns: 1fr auto; gap: 6px; }
      .log-row .t, .log-row .src { grid-column: 1 / -1; }
    }

    .r-card { text-decoration: none; display: block; transition: background 0.15s; }
    a.r-card:hover { background: var(--surface); }
    a.r-card:hover h3 { color: var(--acc); }
    .r-card h3 { transition: color 0.15s; }
    .r-fact {
      display: inline-block; margin-top: 13px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--text-tertiary);
      border: 1px solid var(--border); border-radius: 2px;
      padding: 2px 6px;
    }
  </style>
</Layout>
