---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import FAQSection from '../../components/FAQSection.astro';
import { featureSubpageFaqs } from '../../data/page-faqs';

/**
 * Performance Analytics — Terminal conversion.
 *
 * The old mockup carried a fake gradient bar chart with no axis, no scale and
 * no data behind it. Deleted rather than restyled: the attribution table says
 * the same thing and can be read. Deltas now carry --pos/--neg by whether the
 * move is GOOD, not by its sign — an 8.1% fall in spend is a gain, and
 * colouring it red because it points down is how a blotter stops being read.
 */
const painPoints = [
  {
    n: '01',
    title: 'Reporting by CSV',
    desc: 'Five exports, one merge, a pivot table, and a number that is already a day old by the time anyone sees it.',
  },
  {
    n: '02',
    title: 'Attribution black box',
    desc: 'Every platform claims the same booking. Added up, the channels report more conversions than you actually had.',
  },
  {
    n: '03',
    title: 'Anomalies found late',
    desc: 'A CPC that triples overnight is obvious in hindsight. Without an alert it is found at the weekly review, four days of spend later.',
  },
];

const capabilities = [
  {
    n: '01',
    title: 'Revenue attribution',
    desc: 'Conversions de-duplicated across channels and tied back to booking revenue, so channel numbers add up to the total you actually took.',
  },
  {
    n: '02',
    title: 'Live dashboards',
    desc: 'Every channel, campaign and ad group on the same refresh, with the same column definitions on each.',
  },
  {
    n: '03',
    title: 'Anomaly alerts',
    desc: 'Alerts that name the campaign, the metric and the amount — CPC spikes, conversion drops, pacing that will overspend by Friday.',
  },
  {
    n: '04',
    title: 'Custom reports',
    desc: 'Report builder with scheduled delivery to email or Slack, exportable for owners and asset managers who want the source rows.',
  },
];

const kpis = [
  { k: 'Attributed revenue', v: '$182,450', d: '+24.3%', good: true },
  { k: 'Total spend', v: '$34,820', d: '−8.1%', good: true },
  { k: 'Blended ROAS', v: '5.24×', d: '+35.2%', good: true },
  { k: 'Conversions', v: '1,847', d: '+18.7%', good: true },
];

const channels = [
  { ch: 'Google Ads', spend: '$14,200', rev: '$82,100', roas: '5.78×', share: 45 },
  { ch: 'Meta Ads', spend: '$12,400', rev: '$64,350', roas: '5.19×', share: 35 },
  { ch: 'Booking.com', spend: '$8,220', rev: '$36,000', roas: '4.38×', share: 20 },
];

const relatedFeatures = [
  { n: '01', title: 'Campaign Intelligence', href: '/features/campaign-management', fact: 'One dashboard, every channel' },
  { n: '02', title: 'AI Optimization Engine', href: '/features/ai-optimization', fact: 'Adjusts every 15 minutes' },
  { n: '04', title: 'Automation Studio', href: '/features/automation', fact: 'Rules run around the clock' },
  { n: '05', title: 'Budget Allocator', href: '/features/budget-intelligence', fact: 'Cross-channel reallocation' },
];
---

<Layout
  breadcrumbs={[{ name: 'Features', href: '/features' }, { name: 'Performance Analytics', href: '/features/analytics' }]}
  title="Performance Analytics & Attribution | Advertising Systems"
  description="Cross-channel attribution back to booking revenue, live dashboards and anomaly alerts that name the campaign, the metric and the amount."
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={[{ name: 'Features', href: '/features' }, { name: 'Performance Analytics', href: '/features/analytics' }]} />

    <PageHero
      badge="Module 03 of 5"
      title="Performance Analytics."
      titleAccent="Attribution back to booking revenue."
      lead="One set of numbers every channel agrees with — de-duplicated conversions, live dashboards, and alerts that name the campaign and the amount."
      primaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      secondaryCta={{ text: 'See pricing', href: '/pricing' }}
    />

    <!-- 01 · The problem -->
    <section class="sec" aria-labelledby="pain-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="pain-heading">Every platform claims the same booking.</h2>
            <p class="sub">Reporting that cannot be reconciled is reporting nobody acts on.</p>
          </div>
        </div>
        <div class="cardgrid pain">
          {painPoints.map((point) => (
            <div>
              <div class="cn">{point.n}</div>
              <h3>{point.title}</h3>
              <p>{point.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 · The screen -->
    <section class="sec soft" aria-labelledby="mockup-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="mockup-heading">One number per channel, and they add up.</h2>
            <p class="sub">Channel revenue that sums to the total, because the overlap is removed before it is reported.</p>
          </div>
        </div>

        <div class="panel-box">
          <div class="panel-hd">
            <h3>Attribution — last 30 days</h3>
            <span class="illus">Illustrative</span>
          </div>

          <div class="kpis">
            {kpis.map((kpi) => (
              <div class="kpi">
                <span class="k">{kpi.k}</span>
                <span class="v num">{kpi.v}</span>
                <span class={kpi.good ? 'd num up' : 'd num'}>{kpi.d}</span>
              </div>
            ))}
          </div>

          <div class="scroll-x">
            <table class="bench">
              <thead>
                <tr>
                  <th>Channel</th>
                  <th class="r">Spend</th>
                  <th class="r">Attributed revenue</th>
                  <th class="r">ROAS</th>
                  <th>Share of revenue</th>
                </tr>
              </thead>
              <tbody>
                {channels.map((row) => (
                  <tr>
                    <td class="m">{row.ch}</td>
                    <td class="r">{row.spend}</td>
                    <td class="r">{row.rev}</td>
                    <td class="r m">{row.roas}</td>
                    <td>
                      <span class="bar" aria-hidden="true"><i style={`width:${row.share}%`}></i></span>
                      <span class="bar-v num">{row.share}%</span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <p class="fine">The one report we publish with real numbers is the <a href="/#case">verified Expedia export</a> — reconciled line by line against its own daily series.</p>
      </div>
    </section>

    <!-- 03 · Capabilities -->
    <section class="sec" aria-labelledby="capabilities-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div>
            <h2 id="capabilities-heading">What the module does.</h2>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {capabilities.map((cap) => (
            <div>
              <div class="cn">{cap.n}</div>
              <h3>{cap.title}</h3>
              <p>{cap.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 · The rest of the stack -->
    <section class="sec soft" aria-labelledby="related-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">04</span>
          <div>
            <h2 id="related-heading">The other four modules.</h2>
            <p class="sub">Same connected accounts, same ledger — nothing needs reconciling between them.</p>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {relatedFeatures.map((feature) => (
            <a href={feature.href} class="r-card">
              <div class="cn">{feature.n}</div>
              <h3>{feature.title}</h3>
              <span class="r-fact">{feature.fact}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={featureSubpageFaqs} name="analytics-faq" no="05" soft={false} />
    <CTABand />
  </main>
  <Footer />

  <style>
    .pain .cn { color: var(--neg); }

    .kpis {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-bottom: 1px solid var(--border);
    }
    .kpi { padding: 14px 16px; border-right: 1px solid var(--border); min-width: 0; }
    .kpi:last-child { border-right: 0; }
    .kpi .k {
      display: block;
      font-size: 9.5px; font-weight: 700; letter-spacing: 0.11em;
      text-transform: uppercase; color: var(--text-tertiary);
    }
    .kpi .v {
      display: block; margin-top: 5px;
      font-size: 21px; font-weight: 800; letter-spacing: -0.02em;
      color: var(--text-primary);
    }
    .kpi .d { display: block; margin-top: 3px; font-size: 11.5px; font-weight: 700; color: var(--text-tertiary); }
    .kpi .d.up { color: var(--pos); }
    @media (max-width: 640px) {
      .kpis { grid-template-columns: repeat(2, 1fr); }
      .kpi:nth-child(2) { border-right: 0; }
      .kpi:nth-child(-n+2) { border-bottom: 1px solid var(--border); }
    }

    /* Share bar — a ruled track, not a gradient pill. */
    .bar {
      display: inline-block; vertical-align: middle;
      width: 96px; height: 6px; margin-right: 9px;
      background: var(--progress-track);
      border-radius: 1px; overflow: hidden;
    }
    .bar i { display: block; height: 100%; background: var(--acc); }
    .bar-v { font-size: 12px; color: var(--text-tertiary); font-weight: 700; }

    .r-card { text-decoration: none; display: block; transition: background 0.15s; }
    a.r-card:hover { background: var(--surface); }
    a.r-card:hover h3 { color: var(--acc); }
    .r-card h3 { transition: color 0.15s; }
    .r-fact {
      display: inline-block; margin-top: 13px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--text-tertiary);
      border: 1px solid var(--border); border-radius: 2px;
      padding: 2px 6px;
    }
    .fine a { color: var(--acc); font-weight: 600; }
  </style>
</Layout>
