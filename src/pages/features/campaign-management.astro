---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import FAQSection from '../../components/FAQSection.astro';
import { featureSubpageFaqs } from '../../data/page-faqs';

/**
 * Campaign Intelligence — Terminal conversion.
 *
 * The Wave 3 pass only added `.terminal` to <main>; the body stayed on glass
 * cards, mesh grounds and centered headings, so the page read as a different
 * site from /features. Rebuilt on the same primitives features/index uses:
 * PageHero, .sec/.sec-hd, .cardgrid, .panel-box + table.bench, CTABand.
 *
 * COPY: the hero badge claimed "Launch 14 campaigns across 3 channels in 20
 * minutes" as fact. That figure exists on the homepage as an ILLUSTRATIVE
 * example-account readout (EngineCapabilities), chipped as such. A hero badge
 * has no chip and no frame, so it now states a capability instead.
 */
const painPoints = [
  {
    n: '01',
    title: 'Tab-switching tax',
    desc: 'Google Ads, Meta Business Suite, the OTA extranets and a spreadsheet — four logins to answer one question about yesterday.',
  },
  {
    n: '02',
    title: 'Launch bottleneck',
    desc: 'Every campaign is set up once per platform: the same creative pasted three times, the same targeting re-entered three times.',
  },
  {
    n: '03',
    title: 'Status blindness',
    desc: 'Nothing tells you a campaign stalled. You find out at the weekly review, after the budget has already gone.',
  },
];

const capabilities = [
  {
    n: '01',
    title: 'Cross-channel sync',
    desc: 'Google Ads, Meta and OTA campaigns run from one interface. A change made here is written back to the platform that owns it.',
  },
  {
    n: '02',
    title: 'Bulk launcher',
    desc: 'Build once, launch across platforms in one action. Templated setups carry the targeting and creative with them.',
  },
  {
    n: '03',
    title: 'Live status monitor',
    desc: 'Every campaign\'s state, spend and pacing on one screen, with alerts that name the campaign and the amount.',
  },
  {
    n: '04',
    title: 'Template library',
    desc: 'Save a campaign structure that worked and re-launch it as a starting point rather than rebuilding it from memory.',
  },
];

const rows = [
  { name: 'Summer Brand Push', ch: 'Google Ads', st: 'live', spend: '$1,240', conv: '34', roas: '5.2×', up: true },
  { name: 'Retargeting — Cart', ch: 'Meta Ads', st: 'live', spend: '$890', conv: '28', roas: '6.1×', up: true },
  { name: 'Hotel Promo — EU', ch: 'Booking.com', st: 'live', spend: '$1,450', conv: '19', roas: '3.8×', up: false },
  { name: 'Lookalike — US', ch: 'Meta Ads', st: 'review', spend: '$638', conv: '8', roas: '2.4×', up: false },
  { name: 'Q1 Search — Brand', ch: 'Google Ads', st: 'paused', spend: '$0', conv: '0', roas: '—', up: false },
];

const kpis = [
  { k: 'Active campaigns', v: '14' },
  { k: 'Spend today', v: '$4,218' },
  { k: 'Conversions', v: '89' },
  { k: 'Blended ROAS', v: '4.7×' },
];

const relatedFeatures = [
  { n: '02', title: 'AI Optimization Engine', href: '/features/ai-optimization', fact: 'Adjusts every 15 minutes' },
  { n: '03', title: 'Performance Analytics', href: '/features/analytics', fact: 'Attribution to booking revenue' },
  { n: '04', title: 'Automation Studio', href: '/features/automation', fact: 'Rules run around the clock' },
  { n: '05', title: 'Budget Allocator', href: '/features/budget-intelligence', fact: 'Cross-channel reallocation' },
];
---

<Layout
  breadcrumbs={[{ name: 'Features', href: '/features' }, { name: 'Campaign Intelligence', href: '/features/campaign-management' }]}
  title="Campaign Intelligence — Unified Ad Management | Advertising Systems"
  description="One command center for every ad platform. Launch, manage, and monitor campaigns across Google, Meta, and OTAs from a single dashboard."
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={[{ name: 'Features', href: '/features' }, { name: 'Campaign Intelligence', href: '/features/campaign-management' }]} />

    <PageHero
      badge="Module 01 of 5"
      title="Campaign Intelligence."
      titleAccent="One screen for every channel."
      lead="Launch, manage and monitor Google Ads, Meta, Microsoft and OTA campaigns from a single dashboard — instead of opening four platforms to answer one question."
      primaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      secondaryCta={{ text: 'See pricing', href: '/pricing' }}
    />

    <!-- 01 · The problem -->
    <section class="sec" aria-labelledby="pain-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="pain-heading">Four logins to answer one question.</h2>
            <p class="sub">What running multi-platform campaigns without a command layer actually costs.</p>
          </div>
        </div>
        <div class="cardgrid pain">
          {painPoints.map((point) => (
            <div>
              <div class="cn">{point.n}</div>
              <h3>{point.title}</h3>
              <p>{point.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 · The screen -->
    <section class="sec soft" aria-labelledby="mockup-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="mockup-heading">Your entire ad operation, one screen.</h2>
            <p class="sub">Every connected channel on the same ledger — same columns, same definitions, no reconciliation step.</p>
          </div>
        </div>

        <div class="panel-box">
          <div class="panel-hd">
            <h3>Campaigns — all channels</h3>
            <span class="illus">Illustrative</span>
          </div>

          <div class="kpis">
            {kpis.map((kpi) => (
              <div class="kpi">
                <span class="k">{kpi.k}</span>
                <span class="v num">{kpi.v}</span>
              </div>
            ))}
          </div>

          <div class="scroll-x">
            <table class="bench">
              <thead>
                <tr>
                  <th>Campaign</th>
                  <th>Channel</th>
                  <th>Status</th>
                  <th class="r">Spend</th>
                  <th class="r">Conv.</th>
                  <th class="r">ROAS</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((row) => (
                  <tr>
                    <td class="m">{row.name}</td>
                    <td>{row.ch}</td>
                    <td><span class={`st st-${row.st}`}>{row.st === 'live' ? 'Live' : row.st === 'review' ? 'Review' : 'Paused'}</span></td>
                    <td class="r">{row.spend}</td>
                    <td class="r">{row.conv}</td>
                    <td class={row.up ? 'r up' : 'r m'}>{row.roas}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 · Capabilities -->
    <section class="sec" aria-labelledby="capabilities-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div>
            <h2 id="capabilities-heading">What the module does.</h2>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {capabilities.map((cap) => (
            <div>
              <div class="cn">{cap.n}</div>
              <h3>{cap.title}</h3>
              <p>{cap.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 · The rest of the stack -->
    <section class="sec soft" aria-labelledby="related-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">04</span>
          <div>
            <h2 id="related-heading">The other four modules.</h2>
            <p class="sub">Same connected accounts, same ledger — nothing needs reconciling between them.</p>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {relatedFeatures.map((feature) => (
            <a href={feature.href} class="r-card">
              <div class="cn">{feature.n}</div>
              <h3>{feature.title}</h3>
              <span class="r-fact">{feature.fact}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={featureSubpageFaqs} name="campaign-faq" no="05" soft={false} />
    <CTABand />
  </main>
  <Footer />

  <style>
    /* Pain rail: the problem number carries --neg so the section reads as cost
       without importing a second red into the palette. */
    .pain .cn { color: var(--neg); }

    /* KPI strip above the table — same hairline logic as .cardgrid. */
    .kpis {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-bottom: 1px solid var(--border);
    }
    .kpi {
      padding: 14px 16px;
      border-right: 1px solid var(--border);
      min-width: 0;
    }
    .kpi:last-child { border-right: 0; }
    .kpi .k {
      display: block;
      font-size: 9.5px; font-weight: 700; letter-spacing: 0.11em;
      text-transform: uppercase; color: var(--text-tertiary);
    }
    .kpi .v {
      display: block; margin-top: 5px;
      font-size: 21px; font-weight: 800; letter-spacing: -0.02em;
      color: var(--text-primary);
    }
    @media (max-width: 640px) {
      .kpis { grid-template-columns: repeat(2, 1fr); }
      .kpi:nth-child(2) { border-right: 0; }
      .kpi:nth-child(-n+2) { border-bottom: 1px solid var(--border); }
    }

    /* Status chips. Were raw Tailwind yellow/grey steps — 2.76:1 and 2.39:1 on
       the light card, both below AA — and theme-blind besides. Now the status
       tokens, which are contrast-checked in both themes.
       Class names are deliberately NOT spelled out here: Tailwind scans comment
       text and would re-emit the dead utility into the bundle. */
    .st {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 11px; font-weight: 700;
      border: 1px solid var(--border); border-radius: 2px;
      padding: 2px 7px; white-space: nowrap;
      color: var(--text-tertiary);
    }
    .st::before {
      content: ''; width: 5px; height: 5px; border-radius: 50%;
      background: currentColor;
    }
    .st-live { color: var(--pos); border-color: var(--pos-line); }
    .st-review { color: var(--warn); border-color: var(--warn); }

    /* Related-module cards reuse .cardgrid cells; only link behaviour is local. */
    .r-card { text-decoration: none; display: block; transition: background 0.15s; }
    a.r-card:hover { background: var(--surface); }
    a.r-card:hover h3 { color: var(--acc); }
    .r-card h3 { transition: color 0.15s; }
    .r-fact {
      display: inline-block; margin-top: 13px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--text-tertiary);
      border: 1px solid var(--border); border-radius: 2px;
      padding: 2px 6px;
    }
  </style>
</Layout>
