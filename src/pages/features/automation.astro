---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import FAQSection from '../../components/FAQSection.astro';
import { featureSubpageFaqs } from '../../data/page-faqs';

/**
 * Automation Studio — Terminal conversion.
 *
 * COPY / HONESTY: "saves 12 hours per week" was in the meta DESCRIPTION — the
 * SERP snippet, where no Illustrative chip can reach — and repeated in the
 * closing CTA and as a "Time Saved · 12h" tile. The Wave 3 honesty pass
 * explicitly removed "12 hours saved per week" from the hero badges of these
 * pages and from the features/index stats band; it survived here in three
 * places. All three now state what the module does, not what it saves.
 *
 * The IF/AND/THEN rule chips were a raw Tailwind amber step — 2.02:1 on the
 * light card, the worst contrast measurement on the site. Now structure tokens.
 * (Class names are not spelled out in these comments: Tailwind scans comment
 * text and would re-emit the dead utility into the bundle.)
 */
const painPoints = [
  {
    n: '01',
    title: 'The same work every morning',
    desc: 'Pause the underperformers, nudge the budgets, rotate the tired creative. Same list, every day, before the actual job starts.',
  },
  {
    n: '02',
    title: 'Reaction time measured in days',
    desc: 'A campaign starts losing money on Tuesday and is caught at Friday\'s review. The rule that would have caught it takes a minute to write.',
  },
  {
    n: '03',
    title: 'Nights and weekends',
    desc: 'Campaigns keep spending when nobody is watching. Most of the damage a bad Saturday does is done before anyone opens a dashboard.',
  },
];

const capabilities = [
  {
    n: '01',
    title: 'Rule builder',
    desc: 'Conditions on any metric the platform reports — CPA, ROAS, spend, impressions, pacing — combined with AND/OR, no scripting.',
  },
  {
    n: '02',
    title: 'Trigger actions',
    desc: 'Pause a campaign, move a budget, change a bid, raise an alert. Actions execute against the platform that owns the campaign.',
  },
  {
    n: '03',
    title: 'Scheduling engine',
    desc: 'Dayparting, weekly budget cycles, seasonal adjustments and scheduled launches, expressed as time conditions on the same rules.',
  },
  {
    n: '04',
    title: 'Alerts with the reason attached',
    desc: 'Email or Slack when a rule fires, naming the rule, the campaign and what was changed — not just that something happened.',
  },
];

const ruleState = [
  { k: 'Active rules', v: '18' },
  { k: 'Actions today', v: '47' },
  { k: 'Channels covered', v: '6' },
  { k: 'Silent failures', v: '0' },
];

const rules = [
  {
    name: 'Pause high-CPA campaigns',
    conds: ['CPA > $25', 'Spend > $200'],
    then: 'Pause campaign',
    meta: 'Triggered 3× today · last 2 hours ago · all channels',
  },
  {
    name: 'Scale winners',
    conds: ['ROAS > 5×', 'Conversions > 10'],
    then: 'Increase budget 20%',
    meta: 'Triggered 5× today · last 45 min ago · Google Ads, Meta',
  },
  {
    name: 'Weekend budget guard',
    conds: ['Day = Sat/Sun', 'CPA rises 30%+'],
    then: 'Reduce budget 50% + alert',
    meta: 'Triggered 1× this week · last Saturday 03:14 · all channels',
  },
];

const relatedFeatures = [
  { n: '01', title: 'Campaign Intelligence', href: '/features/campaign-management', fact: 'One dashboard, every channel' },
  { n: '02', title: 'AI Optimization Engine', href: '/features/ai-optimization', fact: 'Adjusts every 15 minutes' },
  { n: '03', title: 'Performance Analytics', href: '/features/analytics', fact: 'Attribution to booking revenue' },
  { n: '05', title: 'Budget Allocator', href: '/features/budget-intelligence', fact: 'Cross-channel reallocation' },
];
---

<Layout
  breadcrumbs={[{ name: 'Features', href: '/features' }, { name: 'Automation Studio', href: '/features/automation' }]}
  title="Automation Studio — Rules-Based Campaigns | Advertising Systems"
  description="Set the rules, let the system run. Conditions on any metric, actions that execute across Google, Meta, Microsoft and OTA campaigns, and an alert naming what changed."
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={[{ name: 'Features', href: '/features' }, { name: 'Automation Studio', href: '/features/automation' }]} />

    <PageHero
      badge="Module 04 of 5"
      title="Automation Studio."
      titleAccent="Set the rules. Let the system run."
      lead="Conditions, triggers and actions you define once, running against every connected channel around the clock — with the rule that fired named in the alert."
      primaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      secondaryCta={{ text: 'See pricing', href: '/pricing' }}
    />

    <!-- 01 · The problem -->
    <section class="sec" aria-labelledby="pain-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="pain-heading">The work that repeats.</h2>
            <p class="sub">Every one of these is a rule somebody has been running manually.</p>
          </div>
        </div>
        <div class="cardgrid pain">
          {painPoints.map((point) => (
            <div>
              <div class="cn">{point.n}</div>
              <h3>{point.title}</h3>
              <p>{point.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 · The rules -->
    <section class="sec soft" aria-labelledby="mockup-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="mockup-heading">If this, then that — across every channel.</h2>
            <p class="sub">
              A rule reads the same whether it acts on Google Ads or an OTA extranet. One condition
              language, one action list, one log.
            </p>
          </div>
        </div>

        <div class="panel-box">
          <div class="panel-hd">
            <h3>Rules — active</h3>
            <span class="illus">Illustrative</span>
          </div>

          <div class="kpis">
            {ruleState.map((item) => (
              <div class="kpi">
                <span class="k">{item.k}</span>
                <span class="v num">{item.v}</span>
              </div>
            ))}
          </div>

          {rules.map((rule) => (
            <div class="rule">
              <div class="rule-hd">
                <span class="rule-name">{rule.name}</span>
                <span class="st st-live">Active</span>
              </div>
              <div class="rule-flow">
                {rule.conds.map((cond, i) => (
                  <span class="tok"><em>{i === 0 ? 'IF' : 'AND'}</em> {cond}</span>
                ))}
                <span class="tok tok-then"><em>THEN</em> {rule.then}</span>
              </div>
              <p class="rule-meta">{rule.meta}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 03 · Capabilities -->
    <section class="sec" aria-labelledby="capabilities-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div>
            <h2 id="capabilities-heading">What the module does.</h2>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {capabilities.map((cap) => (
            <div>
              <div class="cn">{cap.n}</div>
              <h3>{cap.title}</h3>
              <p>{cap.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 · The rest of the stack -->
    <section class="sec soft" aria-labelledby="related-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">04</span>
          <div>
            <h2 id="related-heading">The other four modules.</h2>
            <p class="sub">Same connected accounts, same ledger — nothing needs reconciling between them.</p>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {relatedFeatures.map((feature) => (
            <a href={feature.href} class="r-card">
              <div class="cn">{feature.n}</div>
              <h3>{feature.title}</h3>
              <span class="r-fact">{feature.fact}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={featureSubpageFaqs} name="automation-faq" no="05" soft={false} />
    <CTABand />
  </main>
  <Footer />

  <style>
    .pain .cn { color: var(--neg); }

    .kpis {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-bottom: 1px solid var(--border);
    }
    .kpi { padding: 14px 16px; border-right: 1px solid var(--border); min-width: 0; }
    .kpi:last-child { border-right: 0; }
    .kpi .k {
      display: block;
      font-size: 9.5px; font-weight: 700; letter-spacing: 0.11em;
      text-transform: uppercase; color: var(--text-tertiary);
    }
    .kpi .v {
      display: block; margin-top: 5px;
      font-size: 21px; font-weight: 800; letter-spacing: -0.02em;
      color: var(--text-primary);
    }
    @media (max-width: 640px) {
      .kpis { grid-template-columns: repeat(2, 1fr); }
      .kpi:nth-child(2) { border-right: 0; }
      .kpi:nth-child(-n+2) { border-bottom: 1px solid var(--border); }
    }

    .rule { padding: 16px; border-bottom: 1px solid var(--border); }
    .rule:last-child { border-bottom: 0; }
    .rule-hd { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .rule-name { font-size: 14.5px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.015em; }
    .rule-flow { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }
    .tok {
      display: inline-flex; align-items: baseline; gap: 7px;
      font-size: 12.5px; color: var(--text-secondary);
      border: 1px solid var(--border); border-radius: 3px;
      padding: 5px 10px; background: var(--surface-alt);
      font-variant-numeric: tabular-nums;
    }
    .tok em {
      font-style: normal; font-size: 9.5px; font-weight: 800;
      letter-spacing: 0.12em; color: var(--text-tertiary);
    }
    .tok-then { border-color: var(--text-primary); color: var(--text-primary); font-weight: 700; }
    .tok-then em { color: var(--text-primary); }
    .rule-meta { margin-top: 11px; font-size: 12px; color: var(--text-tertiary); }

    .st {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 11px; font-weight: 700;
      border: 1px solid var(--border); border-radius: 2px;
      padding: 2px 7px; white-space: nowrap;
      color: var(--text-tertiary);
    }
    .st::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
    .st-live { color: var(--pos); border-color: var(--pos-line); }

    .r-card { text-decoration: none; display: block; transition: background 0.15s; }
    a.r-card:hover { background: var(--surface); }
    a.r-card:hover h3 { color: var(--acc); }
    .r-card h3 { transition: color 0.15s; }
    .r-fact {
      display: inline-block; margin-top: 13px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--text-tertiary);
      border: 1px solid var(--border); border-radius: 2px;
      padding: 2px 6px;
    }
  </style>
</Layout>
