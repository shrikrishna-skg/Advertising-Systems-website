---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import FAQSection from '../../components/FAQSection.astro';
import { featureSubpageFaqs } from '../../data/page-faqs';

/**
 * Budget Allocator — Terminal conversion.
 *
 * The allocation bar was four raw Tailwind hues (blue/violet/amber) — the one
 * place on these pages where colour actually CARRIES meaning, and the one
 * place it was theme-blind. Rebuilt as a ruled stack in accent tints, which
 * survives both themes and the green accent switch.
 */
const painPoints = [
  {
    n: '01',
    title: 'Budget split by habit',
    desc: 'Last year\'s split, carried forward. Nothing in it reflects what each channel returned last month.',
  },
  {
    n: '02',
    title: 'Best campaign capped by noon',
    desc: 'The campaign earning 6× hits its daily cap while a 2× campaign still has budget left to spend by midnight.',
  },
  {
    n: '03',
    title: 'Nobody has time to rebalance',
    desc: 'Reallocation is a Monday job at best. Between Mondays, the split is wrong in a way everyone can see and nobody can fix.',
  },
];

const capabilities = [
  {
    n: '01',
    title: 'Cross-channel distribution',
    desc: 'Total budget distributed across channels and campaigns on live performance and diminishing-returns curves, not a fixed percentage split.',
  },
  {
    n: '02',
    title: 'Channel scoring',
    desc: 'Each channel carries a score built from ROAS, CPA, conversion volume and trajectory — so a reallocation can be explained, not just applied.',
  },
  {
    n: '03',
    title: 'Spend forecasting',
    desc: 'Model a budget change and see the projected effect before committing it. Compare scenarios side by side.',
  },
  {
    n: '04',
    title: 'Reallocation alerts',
    desc: 'Every shift is announced with its reasoning and its amount. Approve them, or let them apply and read the log.',
  },
];

const totals = [
  { k: 'Monthly budget', v: '$50,000' },
  { k: 'Projected revenue', v: '$260,000' },
  { k: 'Reallocations this month', v: '23' },
  { k: 'Held for approval', v: '2' },
];

const channels = [
  { ch: 'Google Ads', alloc: '$21,000', pct: 42, score: '94', roas: '5.8×', delta: '+$2,400', up: true },
  { ch: 'Meta Ads', alloc: '$16,500', pct: 33, score: '87', roas: '5.1×', delta: '+$1,800', up: true },
  { ch: 'Booking.com', alloc: '$9,000', pct: 18, score: '72', roas: '4.2×', delta: '−$600', up: false },
  { ch: 'Reserve', alloc: '$3,500', pct: 7, score: '—', roas: '—', delta: 'Held', up: false },
];

const moves = [
  { t: '2h ago', body: 'Shifted <b>$1,200</b> from Booking.com to Google Ads — trailing 7-day ROAS gap above threshold.' },
  { t: '5h ago', body: 'Released <b>$800</b> from reserve into Meta Ads — pacing short with 6 days left in the cycle.' },
  { t: '1d ago', body: 'Held <b>$400</b> back from Microsoft Ads — conversion volume below the minimum for a reliable read.' },
];

const relatedFeatures = [
  { n: '01', title: 'Campaign Intelligence', href: '/features/campaign-management', fact: 'One dashboard, every channel' },
  { n: '02', title: 'AI Optimization Engine', href: '/features/ai-optimization', fact: 'Adjusts every 15 minutes' },
  { n: '03', title: 'Performance Analytics', href: '/features/analytics', fact: 'Attribution to booking revenue' },
  { n: '04', title: 'Automation Studio', href: '/features/automation', fact: 'Rules run around the clock' },
];
---

<Layout
  breadcrumbs={[{ name: 'Features', href: '/features' }, { name: 'Budget Allocator', href: '/features/budget-intelligence' }]}
  title="Budget Allocator — AI Budget Distribution | Advertising Systems"
  description="Cross-channel budget distribution that moves spend toward the campaigns earning it, with a score behind every shift and an approval step when you want one."
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={[{ name: 'Features', href: '/features' }, { name: 'Budget Allocator', href: '/features/budget-intelligence' }]} />

    <PageHero
      badge="Module 05 of 5"
      title="Budget Allocator."
      titleAccent="Every dollar in its best channel."
      lead="Cross-channel distribution that moves spend toward what is earning it — with a score behind every shift, and an approval step whenever you want the final word."
      primaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      secondaryCta={{ text: 'See pricing', href: '/pricing' }}
    />

    <!-- 01 · The problem -->
    <section class="sec" aria-labelledby="pain-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="pain-heading">The split is wrong between Mondays.</h2>
            <p class="sub">A budget set once a month is a budget that is right once a month.</p>
          </div>
        </div>
        <div class="cardgrid pain">
          {painPoints.map((point) => (
            <div>
              <div class="cn">{point.n}</div>
              <h3>{point.title}</h3>
              <p>{point.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 · The allocation -->
    <section class="sec soft" aria-labelledby="mockup-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="mockup-heading">The split, and why it is that split.</h2>
            <p class="sub">Allocation, score and the last move that changed it — on one screen, in one place.</p>
          </div>
        </div>

        <div class="panel-box">
          <div class="panel-hd">
            <h3>Allocation — current cycle</h3>
            <span class="illus">Illustrative</span>
          </div>

          <div class="kpis">
            {totals.map((item) => (
              <div class="kpi">
                <span class="k">{item.k}</span>
                <span class="v num">{item.v}</span>
              </div>
            ))}
          </div>

          <div class="allocbar-wrap">
            <div class="allocbar" role="img" aria-label="Budget split: Google Ads 42%, Meta Ads 33%, Booking.com 18%, reserve 7%">
              {channels.map((c, i) => (
                <span class={`seg seg-${i}`} style={`width:${c.pct}%`}></span>
              ))}
            </div>
            <div class="legend">
              {channels.map((c, i) => (
                <span class="lg"><i class={`sw seg-${i}`}></i>{c.ch} {c.pct}%</span>
              ))}
            </div>
          </div>

          <div class="scroll-x">
            <table class="bench">
              <thead>
                <tr>
                  <th>Channel</th>
                  <th class="r">Allocated</th>
                  <th class="r">Score</th>
                  <th class="r">ROAS</th>
                  <th class="r">Change this month</th>
                </tr>
              </thead>
              <tbody>
                {channels.map((row) => (
                  <tr>
                    <td class="m">{row.ch}</td>
                    <td class="r">{row.alloc}</td>
                    <td class="r m">{row.score}</td>
                    <td class="r">{row.roas}</td>
                    <td class={row.up ? 'r up' : 'r'}>{row.delta}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="moves">
            <div class="moves-hd">Recent reallocations</div>
            {moves.map((m) => (
              <div class="move">
                <p set:html={m.body}></p>
                <span class="t">{m.t}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 03 · Capabilities -->
    <section class="sec" aria-labelledby="capabilities-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div>
            <h2 id="capabilities-heading">What the module does.</h2>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {capabilities.map((cap) => (
            <div>
              <div class="cn">{cap.n}</div>
              <h3>{cap.title}</h3>
              <p>{cap.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 · The rest of the stack -->
    <section class="sec soft" aria-labelledby="related-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">04</span>
          <div>
            <h2 id="related-heading">The other four modules.</h2>
            <p class="sub">Same connected accounts, same ledger — nothing needs reconciling between them.</p>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {relatedFeatures.map((feature) => (
            <a href={feature.href} class="r-card">
              <div class="cn">{feature.n}</div>
              <h3>{feature.title}</h3>
              <span class="r-fact">{feature.fact}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={featureSubpageFaqs} name="budget-faq" no="05" soft={false} />
    <CTABand />
  </main>
  <Footer />

  <style>
    .pain .cn { color: var(--neg); }

    .kpis {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border-bottom: 1px solid var(--border);
    }
    .kpi { padding: 14px 16px; border-right: 1px solid var(--border); min-width: 0; }
    .kpi:last-child { border-right: 0; }
    .kpi .k {
      display: block;
      font-size: 9.5px; font-weight: 700; letter-spacing: 0.11em;
      text-transform: uppercase; color: var(--text-tertiary);
    }
    .kpi .v {
      display: block; margin-top: 5px;
      font-size: 21px; font-weight: 800; letter-spacing: -0.02em;
      color: var(--text-primary);
    }
    @media (max-width: 640px) {
      .kpis { grid-template-columns: repeat(2, 1fr); }
      .kpi:nth-child(2) { border-right: 0; }
      .kpi:nth-child(-n+2) { border-bottom: 1px solid var(--border); }
    }

    /* Allocation bar. Four steps of ONE colour, not four different hues: the
       direction has a single accent, and the segments are already labelled. */
    .allocbar-wrap { padding: 16px; border-bottom: 1px solid var(--border); }
    .allocbar {
      display: flex; height: 14px; overflow: hidden;
      border: 1px solid var(--border); border-radius: 2px;
      background: var(--progress-track);
    }
    .seg { display: block; height: 100%; }
    .seg-0 { background: var(--acc); }
    .seg-1 { background: color-mix(in oklab, var(--acc) 68%, transparent); }
    .seg-2 { background: color-mix(in oklab, var(--acc) 40%, transparent); }
    .seg-3 { background: var(--text-tertiary); }
    .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 11px; font-size: 11.5px; color: var(--text-tertiary); }
    .lg { display: inline-flex; align-items: center; gap: 7px; }
    .sw { width: 9px; height: 9px; border-radius: 1px; display: inline-block; }

    .moves { padding: 4px 0; }
    .moves-hd {
      padding: 12px 16px 8px;
      font-size: 9.5px; font-weight: 700; letter-spacing: 0.11em;
      text-transform: uppercase; color: var(--text-tertiary);
    }
    .move {
      display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
      padding: 10px 16px; border-top: 1px solid var(--border);
      font-size: 13px; color: var(--text-secondary);
    }
    .move p :global(b) { color: var(--text-primary); font-weight: 700; }
    .move .t { font-size: 11.5px; color: var(--text-tertiary); white-space: nowrap; }

    .r-card { text-decoration: none; display: block; transition: background 0.15s; }
    a.r-card:hover { background: var(--surface); }
    a.r-card:hover h3 { color: var(--acc); }
    .r-card h3 { transition: color 0.15s; }
    .r-fact {
      display: inline-block; margin-top: 13px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--text-tertiary);
      border: 1px solid var(--border); border-radius: 2px;
      padding: 2px 6px;
    }
  </style>
</Layout>
