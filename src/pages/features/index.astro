---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import FAQSection from '../../components/FAQSection.astro';
import { featuresIndexFaqs } from '../../data/page-faqs';

/**
 * Features index — Wave 3, Terminal conversion.
 *
 * HONESTY PASS: the old module cards carried outcome chips ("40% lower CPA",
 * "5.2x avg ROAS", "$180K attributed revenue", "12hrs saved") and a stats band
 * ($12M+/30%/$480K+) — none verifiable in the repo. Modules now carry
 * capability facts; the proof slot points at the verified export instead.
 */
const allFeatures = [
  {
    n: '01',
    title: 'Campaign Intelligence',
    desc: 'Unified command center for every ad platform. Launch, manage, and monitor campaigns across Google, Meta, and OTAs from a single dashboard.',
    href: '/features/campaign-management',
    fact: 'One dashboard, every channel',
  },
  {
    n: '02',
    title: 'AI Optimization Engine',
    desc: 'Autonomous bidding, budget reallocation, and audience discovery powered by machine learning across 50,000+ signals per account.',
    href: '/features/ai-optimization',
    fact: 'Adjusts every 15 minutes',
  },
  {
    n: '03',
    title: 'Performance Analytics',
    desc: 'Real-time dashboards, cross-channel attribution, and anomaly alerts. From data to decisions in seconds.',
    href: '/features/analytics',
    fact: 'Attribution to booking revenue',
  },
  {
    n: '04',
    title: 'Automation Studio',
    desc: 'Rules-based campaign automation. Set conditions, triggers, and actions — then let the system execute while you strategize.',
    href: '/features/automation',
    fact: 'Rules run around the clock',
  },
  {
    n: '05',
    title: 'Budget Allocator',
    desc: 'AI-driven cross-channel budget distribution that shifts spend to your best-performing campaigns in real time.',
    href: '/features/budget-intelligence',
    fact: 'Cross-channel reallocation',
  },
];

const withoutWith = [
  { without: 'Switching between 5+ ad platforms daily', with: 'One dashboard for every channel' },
  { without: 'Manual bid adjustments guessing game', with: 'AI optimizes bids automatically' },
  { without: 'Spreadsheets for cross-channel reporting', with: 'Real-time unified analytics' },
  { without: 'Hours spent on repetitive campaign tasks', with: 'Automation handles it in seconds' },
  { without: 'Budget spread thin across channels blindly', with: 'AI allocates to top performers instantly' },
];
---

<Layout
  breadcrumbs={[{ name: 'Features', href: '/features' }]}
  title="Features — Campaigns, AI Optimization, Analytics | Advertising Systems"
  description="One platform for campaigns, AI optimization, analytics, automation, and budget allocation. See what each module does and how it helps you."
>
  <Navbar />
  <main class="terminal">
    <PageHero
      badge="5 integrated modules"
      title="Everything you need to"
      titleAccent="master advertising."
      lead="Five integrated modules that replace your entire ad tech stack — from campaign creation to revenue attribution."
      primaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      secondaryCta={{ text: 'See pricing', href: '/pricing' }}
    />

    <!-- 01 · Modules -->
    <section class="sec" aria-labelledby="modules-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="modules-heading">Five modules, one ledger.</h2>
            <p class="sub">Every module reads and writes the same connected accounts, so nothing needs reconciling.</p>
          </div>
        </div>
        <div class="cardgrid">
          {allFeatures.map((feature) => (
            <a href={feature.href} class="f-card">
              <div class="cn">{feature.n}</div>
              <h3>{feature.title}</h3>
              <p>{feature.desc}</p>
              <span class="f-fact">{feature.fact}</span>
            </a>
          ))}
          <div class="f-card f-card-cta">
            <div class="cn">→</div>
            <h3>See them together</h3>
            <p>The demo runs all five modules on live example data in 30 minutes.</p>
            <a class="f-fact f-fact-link" href="/book-demo">Book a demo</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 · Before / after -->
    <section class="sec soft" aria-labelledby="comparison-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div><h2 id="comparison-heading">Before and after.</h2></div>
        </div>
        <div class="panel-box scroll-x">
          <table class="bench" role="table">
            <thead>
              <tr><th>Without Advertising Systems</th><th>With it</th></tr>
            </thead>
            <tbody>
              {withoutWith.map((row) => (
                <tr>
                  <td class="ba-without">{row.without}</td>
                  <td class="ba-with">{row.with}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 03 · Proof -->
    <section class="sec" aria-labelledby="proof-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div>
            <h2 id="proof-heading">Proof, not promises.</h2>
            <p class="sub">
              We publish one verified case: a real 30-day Expedia TravelAds export for a managed
              property, reconciled against its own daily series — spend, bookings, room nights and
              revenue, line by line.
            </p>
          </div>
        </div>
        <p class="fine"><a href="/#case">Read the verified export on the homepage →</a></p>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={featuresIndexFaqs} name="features-faq" />
    <CTABand />
  </main>
  <Footer />

  <style>
    .f-card { text-decoration: none; display: block; transition: background 0.15s; }
    a.f-card:hover { background: var(--surface-alt); }
    a.f-card:hover h3 { color: var(--acc); }
    .f-card h3 { transition: color 0.15s; }
    .f-fact {
      display: inline-block;
      margin-top: 13px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--text-tertiary);
      border: 1px solid var(--border); border-radius: 2px;
      padding: 2px 6px;
    }
    .f-fact-link { color: var(--acc); border-color: var(--acc-line); text-decoration: none; }
    .f-fact-link:hover { color: var(--acc-hover); }
    .f-card-cta { background: var(--surface-alt); }

    .ba-without { color: var(--text-tertiary); }
    .ba-without::before { content: "✕"; color: var(--neg); font-weight: 700; margin-right: 10px; }
    .ba-with { color: var(--text-primary); font-weight: 600; }
    .ba-with::before { content: "✓"; color: var(--pos); font-weight: 700; margin-right: 10px; }

    .fine a { color: var(--acc); font-weight: 600; }
  </style>
</Layout>
