---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import FAQSection from '../components/FAQSection.astro';
import { integrationsFaqs } from '../data/page-faqs';

/**
 * Integrations — Wave 4, Terminal conversion.
 *
 * HONESTY PASS: the old grid presented TikTok, Airbnb, TripAdvisor, Adobe
 * Analytics and Salesforce as flat peers of Google Ads — no status anywhere.
 * Live vs early access vs planned now comes from the same source of truth as
 * the rest of the site (src/data/faq.ts): live = Google Ads, Meta, Expedia
 * TravelAds, Microsoft/Bing, YouTube, Google Analytics; early access =
 * Booking.com, Reddit; everything else = planned, reviewed during onboarding.
 */
const breadcrumbs = [{ name: 'Integrations', href: '/integrations' }];

type Status = 'live' | 'early' | 'planned';
const STATUS_LABEL: Record<Status, string> = {
  live: 'Live',
  early: 'Early access',
  planned: 'Planned',
};

const integrationGroups: { category: string; items: { name: string; letter: string; status: Status }[] }[] = [
  {
    category: 'Ad Platforms',
    items: [
      { name: 'Google Ads', letter: 'G', status: 'live' },
      { name: 'Meta Ads', letter: 'M', status: 'live' },
      { name: 'Microsoft / Bing Ads', letter: 'B', status: 'live' },
      { name: 'YouTube', letter: 'Y', status: 'live' },
      { name: 'Reddit Ads', letter: 'R', status: 'early' },
      { name: 'TikTok Ads', letter: 'T', status: 'planned' },
    ],
  },
  {
    category: 'Online Travel Agencies',
    items: [
      { name: 'Expedia TravelAds', letter: 'E', status: 'live' },
      { name: 'Booking.com', letter: 'B', status: 'early' },
      { name: 'Airbnb', letter: 'A', status: 'planned' },
      { name: 'TripAdvisor', letter: 'T', status: 'planned' },
    ],
  },
  {
    category: 'Analytics & CRM',
    items: [
      { name: 'Google Analytics', letter: 'GA', status: 'live' },
      { name: 'Adobe Analytics', letter: 'AA', status: 'planned' },
      { name: 'Salesforce', letter: 'SF', status: 'planned' },
    ],
  },
];
---

<Layout
  title="Integrations — Connect Your Ad Platforms | Advertising Systems"
  description="Connect Google Ads, Meta, Expedia TravelAds, Microsoft, YouTube and Google Analytics today — Booking.com and Reddit in early access. See what is live or planned."
  breadcrumbs={breadcrumbs}
>
  <Navbar />
  <main class="terminal">
    <PageHero
      badge="Every connection, honestly labelled"
      title="Connect your"
      titleAccent="stack."
      lead="One dashboard for the platforms you already use. Every integration below states what it is: live today, early access, or planned — nothing is presented as more than it is."
      primaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      secondaryCta={{ text: 'Request an integration', href: '/contact' }}
      fine="OAuth connection for supported platforms · Data syncs every 15 minutes · No CSV imports"
    />

    <!-- 01 · Integration groups -->
    <section class="sec" aria-labelledby="groups-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="groups-heading">What connects, and what it's called.</h2>
            <p class="sub">
              <b>Live</b> works on accounts today. <b>Early access</b> is enabled per account during
              onboarding. <b>Planned</b> is reviewed during onboarding and stays labelled planned
              until it is live on your account.
            </p>
          </div>
        </div>

        {integrationGroups.map((group) => (
          <div class="ig-group">
            <h3 class="ig-cat">{group.category}</h3>
            <div class="cardgrid ig-grid">
              {group.items.map((item) => (
                <div class="ig-card">
                  <span class="ig-letter" aria-hidden="true">{item.letter}</span>
                  <div class="ig-txt">
                    <p class="ig-name">{item.name}</p>
                    <span class={`ig-st ig-st-${item.status}`}><i aria-hidden="true"></i>{STATUS_LABEL[item.status]}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}

        <p class="fine">
          Growth, Scale and Enterprise plans include REST API access for custom connections (CRM,
          BI, internal tools). Using something not listed? <a href="/contact">Tell us what you use</a> —
          we'll review it during onboarding.
        </p>
      </div>
    </section>

    <!-- 02 · How connecting works -->
    <section class="sec soft" aria-labelledby="how-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="how-heading">Connect in minutes.</h2>
            <p class="sub">OAuth with supported platforms — no CSV imports, no IT ticket, no custom dev work. Data syncs every 15 minutes, and you can see the last sync time in the dashboard.</p>
          </div>
        </div>
        <div class="cardgrid">
          <div><div class="cn">01</div><h3>Authorize</h3><p>Sign in to the ad platform through OAuth. Your password never passes through Advertising Systems.</p></div>
          <div><div class="cn">02</div><h3>Select accounts</h3><p>Choose which ad accounts report into the workspace. Plans scale by accounts under management.</p></div>
          <div><div class="cn">03</div><h3>One ledger</h3><p>Connected accounts report into a single ledger with one set of rules — no reconciling six definitions of "conversion".</p></div>
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={integrationsFaqs} name="integrations-faq" />
    <CTABand />
  </main>
  <Footer />

  <style>
    .ig-group { margin-bottom: 34px; }
    .ig-group:last-of-type { margin-bottom: 0; }
    .ig-cat {
      font-size: 11px; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--text-tertiary);
      margin-bottom: 12px;
    }
    .ig-card { display: flex; align-items: center; gap: 14px; }
    .ig-letter {
      width: 40px; height: 40px; flex-shrink: 0;
      display: grid; place-items: center;
      border: 1px solid var(--border); border-radius: 3px;
      background: var(--surface-alt);
      font-size: 14px; font-weight: 800; color: var(--text-primary);
    }
    .ig-txt { min-width: 0; }
    .ig-name { font-size: 14px; font-weight: 700; color: var(--text-primary); }
    .ig-st {
      margin-top: 4px;
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .ig-st i { width: 5px; height: 5px; border-radius: 50%; background: currentColor; font-style: normal; }
    .ig-st-live { color: var(--pos); }
    .ig-st-early { color: var(--warn); }
    .ig-st-planned { color: var(--text-tertiary); }
    .fine a { color: var(--acc); font-weight: 600; }
  </style>
</Layout>
