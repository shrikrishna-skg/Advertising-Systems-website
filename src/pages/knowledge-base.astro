---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import FAQSection from '../components/FAQSection.astro';
import { knowledgeBaseFaqs } from '../data/page-faqs';

/**
 * Knowledge Base — Terminal conversion.
 *
 * DEAD LINKS: every card and every article on this page was an `<a href="#">` —
 * 24 links that scroll to the top of the page. A link that goes nowhere is a
 * worse promise than no link, so the topics are listed as text until the
 * articles exist, and the two routes that DO exist (FAQ, contact) carry the
 * traffic. Restore the anchors article by article as each one ships.
 */
const breadcrumbs = [{ name: 'Knowledge Base', href: '/knowledge-base' }];

const categories = [
  {
    n: '01',
    title: 'Getting started',
    description: 'Account setup, onboarding walkthrough, and launching your first campaign.',
    articles: ['Quick start guide', 'Account setup', 'Your first campaign'],
  },
  {
    n: '02',
    title: 'Campaign management',
    description: 'Creating, editing, duplicating, and running bulk operations on campaigns.',
    articles: ['Create a campaign', 'Bulk editing', 'Campaign templates'],
  },
  {
    n: '03',
    title: 'AI & optimization',
    description: 'Automated bidding strategies, budget allocation, and audience optimization.',
    articles: ['Smart bidding', 'Budget optimizer', 'Audience insights'],
  },
  {
    n: '04',
    title: 'Analytics & reporting',
    description: 'Custom dashboards, scheduled exports, and multi-touch attribution.',
    articles: ['Dashboard builder', 'Scheduled reports', 'Attribution models'],
  },
  {
    n: '05',
    title: 'Integrations',
    description: 'Connecting Google Ads, Meta, OTAs, and using the Advertising Systems API.',
    articles: ['Google Ads setup', 'Meta Ads setup', 'API reference'],
  },
  {
    n: '06',
    title: 'Account & billing',
    description: 'Subscription plans, invoices, team management, and permissions.',
    articles: ['Manage your plan', 'Invoices & receipts', 'Team roles'],
  },
];
---

<Layout
  title="Knowledge Base — Advertising Systems | Guides & How-To"
  description="Guides for setup, campaigns, AI optimization, analytics, integrations and billing — plus the fastest routes to a human when a guide is not enough."
  breadcrumbs={breadcrumbs}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />

    <PageHero
      title="Knowledge base."
      lead="What the platform does, how to set it up, and what to check when a number looks wrong. Written for the person who has to run this on a Tuesday."
      primaryCta={{ text: 'Read the FAQ', href: '/faq' }}
      secondaryCta={{ text: 'Contact support', href: '/contact' }}
      fine="Guides are being written module by module. Until one is published, the FAQ and support are the fastest route."
    />

    <!-- 01 · Topics -->
    <section class="sec" aria-labelledby="topics-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="topics-heading">Browse by topic.</h2>
          </div>
        </div>
        <div class="cardgrid">
          {categories.map((category) => (
            <div>
              <div class="cn">{category.n}</div>
              <h3>{category.title}</h3>
              <p>{category.description}</p>
              <ul class="arts">
                {category.articles.map((article) => <li>{article}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={knowledgeBaseFaqs} name="kb-faq" no="02" soft={true} />
    <CTABand />
  </main>
  <Footer />

  <style>
    .arts { margin-top: 14px; border-top: 1px solid var(--border); }
    .arts li {
      padding: 7px 0 0;
      font-size: 12.5px;
      color: var(--text-tertiary);
      display: flex;
      gap: 8px;
    }
    .arts li::before { content: "·"; color: var(--acc); font-weight: 700; }
  </style>
</Layout>
