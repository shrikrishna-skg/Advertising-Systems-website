---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';

const breadcrumbs = [{ name: 'Terms of Service', href: '/terms' }];
---

<Layout
  title="Terms of Service — Advertising Systems | Agreement & Use of Platform"
  description="Terms and conditions for using Advertising Systems. Your rights, our obligations, and acceptable use."
  breadcrumbs={breadcrumbs}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />
    <PageHero
      title="Terms of Service."
      lead="In short: by using Advertising Systems you agree to these terms. You can cancel anytime; we'll treat your data as described in our Privacy Policy."
      fine="Last updated: March 2026"
    />

    <section class="sec">
      <div class="wrap">
        <div class="legal">

        <section>
          <h2>1. Acceptance of Terms</h2>
          <p>
            By accessing or using Advertising Systems (the "Service"), operated by Multisystems Inc., you agree to be bound by these Terms of Service. If you are using the Service on behalf of an organization, you represent that you have authority to bind that organization to these terms.
          </p>
        </section>

        <section>
          <h2>2. Service Description</h2>
          <p>
            Advertising Systems is an AI-powered advertising management platform that enables users to manage, optimize, and analyze digital advertising campaigns across multiple channels including Google Ads, Meta Ads, Microsoft Ads, and online travel agencies. The Service includes campaign management tools, automated bidding, analytics dashboards, and integration capabilities.
          </p>
        </section>

        <section>
          <h2>3. User Obligations</h2>
          <ul>
            <li>Provide accurate and complete registration information.</li>
            <li>Maintain the confidentiality of your account credentials.</li>
            <li>Comply with all applicable advertising platform policies and regulations.</li>
            <li>Not use the Service for any unlawful, fraudulent, or harmful purpose.</li>
            <li>Not attempt to reverse-engineer, decompile, or access the source code of the platform.</li>
            <li>Not exceed authorized usage limits or abuse API access.</li>
          </ul>
        </section>

        <section>
          <h2>4. Payment Terms</h2>
          <p>
            Paid subscriptions are billed monthly or annually in advance. All fees are non-refundable except where required by law. Key payment terms:
          </p>
          <ul>
            <li>Prices are in USD and exclude applicable taxes.</li>
            <li>We may adjust pricing with 30 days' prior notice.</li>
            <li>Failed payments may result in service suspension after a 7-day grace period.</li>
            <li>Signup requests do not create charges until a paid plan is selected and payment details are submitted.</li>
          </ul>
        </section>

        <section>
          <h2>5. Limitation of Liability</h2>
          <p>
            To the maximum extent permitted by law, Multisystems Inc. shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising from your use of the Service. Our total aggregate liability shall not exceed the amount you paid for the Service in the twelve months preceding the claim. The Service is provided "as is" without warranties of any kind, express or implied.
          </p>
        </section>

        <section>
          <h2>6. Termination</h2>
          <p>
            Either party may terminate the agreement at any time:
          </p>
          <ul>
            <li>You may cancel your subscription through your account settings. Cancellation takes effect at the end of your current billing period.</li>
            <li>We may suspend or terminate your access for violation of these terms, with notice where practicable.</li>
            <li>Upon termination, you may export your data within 30 days. After that period, we may delete your data in accordance with our retention policies.</li>
          </ul>
        </section>

        <section>
          <h2>7. Contact</h2>
          <p>
            Questions about these terms? Contact us at
            <a href="mailto:legal@advertisingsystems.ai">legal@advertisingsystems.ai</a>.
          </p>
        </section>

        </div>
        <p class="fine"><a href="/faq">Read the FAQ →</a> <span> or </span> <a href="/contact">contact us</a></p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
