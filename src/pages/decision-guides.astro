---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import { decisionGuides } from '../data/decision-guides';

const breadcrumbs = [{ name: 'Decision Guides', href: '/decision-guides' }];

const pillars = [
  {
    label: 'Step 1',
    title: 'Find the demand problem',
    body: 'Start with dates, occupancy, traveler intent, and channel gaps before deciding where to spend.',
  },
  {
    label: 'Step 2',
    title: 'Buy visibility with guardrails',
    body: 'Use Expedia, Booking, Google, or Meta only when the channel has a clear job and budget limit.',
  },
  {
    label: 'Step 3',
    title: 'Prove incremental revenue',
    body: 'Judge the channel by booked revenue, room nights, ROAS, and whether it helped the right stay dates.',
  },
];
---

<Layout
  breadcrumbs={[{ name: 'Home', href: '/' }, ...breadcrumbs]}
  title="Hotel Advertising Decision Guides | Advertising Systems"
  description="Decision guides for hotel advertising across Expedia TravelAds, Booking Sponsored Listings, Google Ads, Meta Ads, manual reporting, and OTA demand planning."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Hotel Advertising Decision Guides',
    description: 'Practical hotel advertising guides for OTA, search, social, and reporting decisions.',
    url: 'https://www.advertisingsystems.ai/decision-guides',
  }}
>
  <Navbar />

  <main class="terminal">
    <Breadcrumb items={[{ name: 'Home', href: '/' }, ...breadcrumbs]} />

    <PageHero
      badge="Hotel advertising decision guides"
      title="Know where to spend"
      titleAccent="before you spend more."
      lead="Visual guides for hotel owners, GMs and revenue teams deciding when Expedia, Booking, Google, Meta and OTA advertising should get budget — and when they should not."
      primaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      secondaryCta={{ text: 'View the Expedia report', href: '/expedia-report' }}
    />

    <!-- 01 · The method -->
    <section class="sec" aria-labelledby="method-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="method-heading">Three steps, in this order.</h2>
            <p class="sub">Every guide below follows the same sequence, because doing them out of order is how budget gets spent on the wrong channel.</p>
          </div>
        </div>
        <div class="cardgrid">
          {pillars.map((pillar, i) => (
            <div>
              <div class="cn">{String(i + 1).padStart(2, '0')}</div>
              <h3>{pillar.title}</h3>
              <p>{pillar.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 · Library -->
    <section class="sec soft" aria-labelledby="guide-library-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="guide-library-heading">OTA visibility, channel choice, reporting proof.</h2>
            <p class="sub">
              Each guide explains what the platform does, how visibility is earned, what changes near the
              top of search, and how the decision gets reported afterwards.
            </p>
          </div>
        </div>

        <div class="guides">
          {decisionGuides.map((guide) => (
            <article class="guide">
              <div class="guide-hd">
                <span class="cat">{guide.category}</span>
                <span class="eyb">{guide.eyebrow}</span>
              </div>
              <h3><a href={`/decision-guides/${guide.slug}`}>{guide.title}</a></h3>
              <p class="ex">{guide.excerpt}</p>
              <div class="stats">
                {guide.heroStats.map((stat) => (
                  <div class="stat">
                    <span class="sl">{stat.label}</span>
                    <span class="sv num">{stat.value}</span>
                    <span class="sc">{stat.caption}</span>
                  </div>
                ))}
              </div>
              <a class="rd" href={`/decision-guides/${guide.slug}`}>Read guide →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <CTABand />
  </main>

  <Footer />

  <style>
    .guides { border-top: 1px solid var(--border); }
    .guide { padding: 26px 0; border-bottom: 1px solid var(--border); }
    .guide-hd { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
    .cat, .eyb {
      font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--text-tertiary);
    }
    .cat { color: var(--acc); }
    .guide h3 { margin-top: 12px; font-size: 22px; font-weight: 800; letter-spacing: -0.025em; }
    .guide h3 a { color: var(--text-primary); text-decoration: none; }
    .guide h3 a:hover { color: var(--acc); }
    .guide .ex { margin-top: 10px; font-size: 14.5px; color: var(--text-secondary); max-width: 46em; line-height: 1.55; }
    .stats {
      display: grid; grid-template-columns: repeat(3, 1fr);
      margin-top: 18px;
      border-top: 1px solid var(--border); border-left: 1px solid var(--border);
    }
    .stat {
      padding: 13px 15px;
      border-right: 1px solid var(--border); border-bottom: 1px solid var(--border);
      background: var(--surface-raised);
      min-width: 0;
    }
    .sl { display: block; font-size: 9.5px; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; color: var(--text-tertiary); }
    .sv { display: block; margin-top: 5px; font-size: 18px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.02em; }
    .sc { display: block; margin-top: 4px; font-size: 11.5px; color: var(--text-tertiary); line-height: 1.4; }
    .rd { display: inline-block; margin-top: 16px; font-size: 13.5px; font-weight: 700; color: var(--acc); text-decoration: none; }
    .rd:hover { color: var(--acc-hover); }
    @media (max-width: 640px) { .stats { grid-template-columns: 1fr; } }
  </style>
</Layout>
