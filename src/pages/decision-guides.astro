---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { decisionGuides, futureDecisionGuideIdeas } from '../data/decision-guides';

const breadcrumbs = [{ name: 'Decision Guides', href: '/decision-guides' }];

const pillars = [
  {
    label: 'Step 1',
    title: 'Find the demand problem',
    body: 'Start with dates, occupancy, traveler intent, and channel gaps before deciding where to spend.',
  },
  {
    label: 'Step 2',
    title: 'Buy visibility with guardrails',
    body: 'Use Expedia, Booking, Google, or Meta only when the channel has a clear job and budget limit.',
  },
  {
    label: 'Step 3',
    title: 'Prove incremental revenue',
    body: 'Judge the channel by booked revenue, room nights, ROAS, and whether it helped the right stay dates.',
  },
];
---

<Layout
  breadcrumbs={[{ name: 'Home', href: '/' }, ...breadcrumbs]}
  title="Hotel Advertising Decision Guides | Advertising Systems"
  description="Decision guides for hotel advertising across Expedia TravelAds, Booking Sponsored Listings, Google Ads, Meta Ads, manual reporting, and OTA demand planning."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Hotel Advertising Decision Guides',
    description: 'Practical hotel advertising guides for OTA, search, social, and reporting decisions.',
    url: 'https://advertisingsystems.ai/decision-guides',
  }}
>
  <Navbar />
  <Breadcrumb items={[{ name: 'Home', href: '/' }, ...breadcrumbs]} />

  <main>
    <section class="relative pt-28 pb-16 sm:pt-40 sm:pb-20 md:pt-48 md:pb-24 overflow-hidden" aria-labelledby="decision-guides-heading">
      <div class="mesh-gradient absolute inset-0"></div>
      <div class="dot-grid absolute inset-0"></div>

      <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
          <div class="reveal inline-flex items-center gap-2 glass rounded-full px-4 py-2 sm:px-5 mb-6 sm:mb-8">
            <span class="w-2 h-2 bg-royal-green-500 rounded-full animate-pulse shrink-0"></span>
            <span class="text-xs sm:text-sm font-medium text-[var(--text-tertiary)]">Hotel advertising decision guides</span>
          </div>

          <h1 id="decision-guides-heading" class="reveal text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-[var(--text-primary)] leading-tight tracking-[-0.03em]">
            Know where to spend before you spend more.
          </h1>
          <p class="reveal mt-6 text-lg sm:text-xl font-medium text-[var(--text-secondary)] max-w-3xl leading-relaxed">
            Simple visual guides for hotel owners, GMs, and revenue teams deciding when Expedia, Booking, Google, Meta, and OTA advertising should receive budget.
          </p>

          <div class="reveal mt-10 flex flex-col sm:flex-row gap-3">
            <a href="/book-demo" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-royal-green-500 text-white font-semibold px-6 py-3 rounded-lg hover:bg-royal-green-600 transition-colors">
              Book a Demo
            </a>
            <a href="/expedia-report" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 btn-secondary font-semibold px-6 py-3 rounded-lg">
              View Expedia Report
            </a>
          </div>
        </div>

        <div class="reveal mt-14 grid sm:grid-cols-3 gap-4">
          {pillars.map((pillar) => (
            <article class="glass rounded-2xl p-6">
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--text-muted)]">{pillar.label}</p>
              <h2 class="mt-4 text-lg font-bold text-[var(--text-primary)]">{pillar.title}</h2>
              <p class="mt-3 text-sm font-medium text-[var(--text-tertiary)] leading-relaxed">{pillar.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="section-line"></div>

    <section class="py-24" aria-labelledby="guide-library-heading">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <p class="reveal text-sm font-bold uppercase tracking-[0.16em] text-[var(--text-muted)]">Guide library</p>
          <h2 id="guide-library-heading" class="reveal mt-3 text-3xl sm:text-4xl font-bold text-[var(--text-primary)] tracking-[-0.03em]">
            OTA visibility, channel choice, and reporting proof
          </h2>
          <p class="reveal mt-4 text-lg font-medium text-[var(--text-tertiary)] leading-relaxed">
            Each guide explains what the platform does, how visibility is earned, what changes near the top of search, and how Advertising Systems reports the decision.
          </p>
        </div>

        <div class="reveal mt-12 grid md:grid-cols-2 gap-6">
          {decisionGuides.map((guide) => (
            <article class="glass hover-glow rounded-2xl p-7 flex flex-col min-w-0">
              <div class="flex items-center justify-between gap-4">
                <span class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--text-muted)]">{guide.category}</span>
                <span class="text-xs font-semibold text-[var(--text-tertiary)]">{guide.eyebrow}</span>
              </div>
              <h3 class="mt-5 text-2xl font-bold text-[var(--text-primary)] tracking-[-0.02em]">{guide.title}</h3>
              <p class="mt-4 text-sm font-medium text-[var(--text-tertiary)] leading-relaxed">{guide.excerpt}</p>
              <div class="mt-6 grid sm:grid-cols-3 gap-3">
                {guide.heroStats.map((stat) => (
                  <div class="rounded-xl border border-[var(--border)] bg-[var(--surface-alt)] p-4">
                    <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-[var(--text-muted)]">{stat.label}</p>
                    <p class="mt-2 text-lg font-bold text-[var(--text-primary)]">{stat.value}</p>
                    <p class="mt-1 text-xs font-medium text-[var(--text-tertiary)] leading-snug">{stat.caption}</p>
                  </div>
                ))}
              </div>
              <a href={`/decision-guides/${guide.slug}`} class="mt-7 inline-flex w-fit items-center gap-2 text-sm font-bold text-[var(--text-primary)] hover:opacity-70 transition-opacity">
                Read guide
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <div class="section-line"></div>

    <section class="py-24" aria-labelledby="future-guides-heading">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-10 items-start">
          <div>
            <p class="reveal text-sm font-bold uppercase tracking-[0.16em] text-[var(--text-muted)]">Next guide queue</p>
            <h2 id="future-guides-heading" class="reveal mt-3 text-3xl sm:text-4xl font-bold text-[var(--text-primary)] tracking-[-0.03em]">
              More pages we can add next
            </h2>
            <p class="reveal mt-4 text-lg font-medium text-[var(--text-tertiary)] leading-relaxed">
              These should become pages once the first Expedia and Booking guide set is live and we can see what users click.
            </p>
          </div>

          <div class="reveal grid sm:grid-cols-2 gap-4">
            {futureDecisionGuideIdeas.map((idea) => (
              <div class="glass rounded-xl p-5">
                <p class="text-sm font-bold text-[var(--text-primary)]">{idea}</p>
                <p class="mt-2 text-xs font-medium text-[var(--text-tertiary)] leading-relaxed">Future decision guide topic</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
