---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';

const breadcrumbs = [{ name: 'Cookie Policy', href: '/cookies' }];
---

<Layout
  title="Cookie Policy — Advertising Systems | How We Use Cookies"
  description="What cookies we use, why, and how you can manage your preferences. Essential, analytics, and marketing cookies."
  breadcrumbs={breadcrumbs}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />
    <PageHero
      title="Cookie Policy."
      lead="We use cookies to run the site, keep you signed in and improve the product. Optional cookies are only set with your consent, and you can change that at any time."
      fine="Last updated: March 2026"
    />

    <section class="sec">
      <div class="wrap">
        <div class="legal">

        <section>
          <h2>What Are Cookies?</h2>
          <p>
            Cookies are small text files stored on your device when you visit a website. They help the site remember your preferences, keep you signed in, and understand how you interact with the platform. Advertising Systems uses cookies and similar technologies (local storage, session storage) to deliver a seamless experience.
          </p>
        </section>

        <section>
          <h2>Essential Cookies</h2>
          <p>
            These cookies are required for the platform to function and cannot be disabled.
          </p>
          <div class="panel-box scroll-x">
            <table class="bench">
              <thead>
                <tr>
                  <th>Cookie</th>
                  <th>Purpose</th>
                  <th>Duration</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="m mono">as_session</td>
                  <td>Maintains your authenticated session</td>
                  <td>Session</td>
                </tr>
                <tr>
                  <td class="m mono">as_csrf</td>
                  <td>Protects against cross-site request forgery</td>
                  <td>Session</td>
                </tr>
                <tr>
                  <td class="m mono">as_preferences</td>
                  <td>Stores UI preferences (theme, language)</td>
                  <td>1 year</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section>
          <h2>Analytics Cookies</h2>
          <p>
            We use analytics cookies to understand how users interact with our platform, which features are most popular, and where users encounter issues. This data is aggregated and anonymized. We use privacy-focused analytics and do not create individual user profiles for advertising purposes.
          </p>
        </section>

        <section>
          <h2>Marketing Cookies</h2>
          <p>
            Marketing cookies are only set with your explicit consent. They help us measure the effectiveness of our own advertising campaigns and may be used to show you relevant information about Advertising Systems on third-party sites. You can opt out of marketing cookies at any time through your cookie preferences.
          </p>
        </section>

        <section>
          <h2>Managing Cookies</h2>
          <p>
            You can control cookies in several ways:
          </p>
          <ul>
            <li><strong>Cookie Banner:</strong> Use the cookie consent banner shown on your first visit to accept or decline optional cookies.</li>
            <li><strong>Browser Settings:</strong> Most browsers allow you to block or delete cookies through their settings menu.</li>
            <li><strong>Account Settings:</strong> Logged-in users can manage cookie preferences from their account dashboard.</li>
          </ul>
          <p>
            Note: Disabling essential cookies may prevent the platform from functioning correctly.
          </p>
        </section>

        <section>
          <h2>Third-Party Cookies</h2>
          <p>
            Some third-party services integrated into the platform (such as payment processors or support chat) may set their own cookies. These are governed by the respective third party's cookie policies. We review our third-party partners regularly to ensure they meet our privacy standards.
          </p>
        </section>

          </div>
        <p class="fine">Questions about our cookie practices? <a href="mailto:privacy@advertisingsystems.ai">privacy@advertisingsystems.ai</a> <span> or </span> <a href="/contact">contact us</a></p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
