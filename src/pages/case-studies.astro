---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import VerifiedCase from '../components/VerifiedCase.astro';
import CTABand from '../components/CTABand.astro';
import FAQSection from '../components/FAQSection.astro';
import { caseStudiesFaqs } from '../data/page-faqs';

/**
 * Case studies — Wave 4, Terminal conversion.
 *
 * HONESTY PASS — this page was rebuilt, not restyled. The old version carried
 * three fictional companies (TravelCorp, MetroRetail, GlobalTech) with invented
 * results (340% ROAS, 52% CPA cut, "8 channels" including TikTok, which is not
 * an integration), under the headline "Real teams. Real results." and an FAQ
 * asserting the numbers were verified. All of it is gone. The page now carries
 * the ONE case that reconciles — the 30-day Expedia TravelAds export — and says
 * plainly why there is only one.
 */
const breadcrumbs = [{ name: 'Case Studies', href: '/case-studies' }];
---

<Layout
  title="Case Studies — Advertising Systems | Verified Platform Data"
  description="One property, thirty days, every number straight from the Expedia TravelAds export — reconciled line by line. We publish verified cases only."
  breadcrumbs={breadcrumbs}
>
  <Navbar />
  <main class="terminal">
    <PageHero
      badge="Verified casework"
      title="We publish what we can"
      titleAccent="prove."
      lead="No composite customers, no rounded-up multiples. Every case on this page is a real platform export, reconciled against its own daily series. Today that is one case — more appear as they clear the same bar."
      primaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      secondaryCta={{ text: 'How we verify', href: '#standard' }}
    />

    <VerifiedCase number="01" />

    <!-- 02 · The verification standard -->
    <section class="sec soft" id="standard" aria-labelledby="standard-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="standard-heading">What it takes to appear on this page.</h2>
            <p class="sub">Three rules, applied to every case — including the one above.</p>
          </div>
        </div>
        <div class="cardgrid">
          <div>
            <div class="cn">01</div>
            <h3>Platform export, not screenshots</h3>
            <p>The source is the ad platform's own data export. Headline figures are recomputed from the daily series, never copied from a summary panel — the export above contained seven internal errors we corrected that way.</p>
          </div>
          <div>
            <div class="cn">02</div>
            <h3>Named only with written consent</h3>
            <p>Until a property consents in writing, it is identified by segment and market only. A withheld name changes nothing about the numbers.</p>
          </div>
          <div>
            <div class="cn">03</div>
            <h3>Limits stated with the results</h3>
            <p>Single property, single channel, one window — and platform ROAS definitions differ by channel. Every case states what it does not show.</p>
          </div>
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={caseStudiesFaqs} name="case-studies-faq" />
    <CTABand />
  </main>
  <Footer />
</Layout>
