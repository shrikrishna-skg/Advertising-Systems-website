---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHero from '../components/PageHero.astro';
import FAQSection from '../components/FAQSection.astro';
import { securityFaqs } from '../data/page-faqs';

/**
 * Security — Terminal conversion.
 *
 * FAQSection was nested inside this page's own max-width container, so it was
 * double-constrained once it became a full-width `.sec`. It is now a sibling of
 * the other sections, like every other converted page.
 *
 * The icon per card is dropped rather than restyled: six line icons on six
 * cards were decoration carrying no information the heading did not already
 * carry, and the direction spends its ink on rules and numbers.
 */
const breadcrumbs = [{ name: 'Security', href: '/security' }];

/**
 * HONESTY PASS, 2026-08-16 (owner ruling: the SOC 2 claim was not true).
 *
 * Removed outright — each asserts an artefact or a build a buyer can ask to
 * see, and there is nothing behind them:
 *   · "SOC 2 Type II · independently audited" — the whole card, plus the meta
 *     description and the FAQ answer that repeated it. This is the one claim on
 *     the site that enterprise procurement actually verifies.
 *   · "hardware security module" — specific hardware, not something you have by
 *     default. Now states the property that IS true: separate keys, and platform
 *     passwords never stored, because the connections are OAuth.
 *   · "SSO/SAML for enterprise plans" — a feature, not a posture.
 *   · "Choose where your data is stored" — asserted regional isolation as a
 *     shipped capability; the FAQ already said only that it "may be available".
 *
 * What is left is what holds without a certificate: how the connection works,
 * who can reach production, and what we commit to when something goes wrong.
 * Restore any card the moment the artefact behind it exists.
 */
const controls = [
  {
    n: '01',
    title: 'Data encryption',
    desc: 'Encrypted in transit with TLS and at rest with AES-256. API tokens and OAuth credentials are stored encrypted, under keys separate from the application data.',
  },
  {
    n: '02',
    title: 'We never hold your passwords',
    desc: 'Ad platforms are connected over OAuth, so your Google, Meta and Microsoft credentials are never sent to us and never stored. Revoke our access from the platform at any time.',
  },
  {
    n: '03',
    title: 'Access controls',
    desc: 'Role-based permissions inside your workspace, and multi-factor authentication required on every account with production access on our side.',
  },
  {
    n: '04',
    title: 'Least privilege',
    desc: 'Production access is restricted to the people whose job requires it, granted per task rather than standing, and reviewed as the team changes.',
  },
  {
    n: '05',
    title: 'Your data is not the product',
    desc: 'We do not sell your data, share it with other customers, use it to target advertising, or train models on it. It is used to run your account and nothing else.',
  },
  {
    n: '06',
    title: 'Incident response',
    desc: 'A documented plan with named escalation ownership. Affected customers are notified within 72 hours, and every incident gets a written post-incident review.',
  },
];
---

<Layout
  title="Security — Advertising Systems | How We Protect Your Data"
  description="How we keep your accounts and campaign data safe: OAuth-only connections, encryption in transit and at rest, least-privilege production access, and our incident response commitments."
  breadcrumbs={breadcrumbs}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />

    <PageHero
      title="Security."
      titleAccent="Your accounts, and the keys to them."
      lead="Connecting an ad account means handing over spending authority. These are the controls that sit behind that decision."
      fine="Last updated: March 2026"
    />

    <!-- 01 · Controls -->
    <section class="sec" aria-labelledby="controls-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="controls-heading">The controls, stated plainly.</h2>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {controls.map((c) => (
            <div>
              <div class="cn">{c.n}</div>
              <h3>{c.title}</h3>
              <p>{c.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 · Responsible disclosure -->
    <section class="sec soft" aria-labelledby="disclosure-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="disclosure-heading">Responsible disclosure.</h2>
          </div>
        </div>
        <div class="legal">
          <section>
            <p>
              If you find a vulnerability, report it and we will work with you. We acknowledge reports
              within 2 business days and will not pursue legal action against researchers who follow
              these guidelines.
            </p>
            <ul>
              <li>Email your findings to <a href="mailto:security@advertisingsystems.ai">security@advertisingsystems.ai</a>.</li>
              <li>Provide enough detail for us to reproduce and address the issue.</li>
              <li>Allow reasonable time to investigate and remediate before public disclosure.</li>
              <li>Do not access, modify or delete other users' data.</li>
            </ul>
          </section>
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={securityFaqs} name="security-faq" no="03" soft={false} />

    <section class="sec soft">
      <div class="wrap">
        <p class="fine">Questions about security or compliance? <a href="/contact">Contact us →</a></p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
