---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PricingCards from '../components/PricingCards.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';

const breadcrumbs = [{ name: 'Pricing Intelligence', href: '/pricing-intelligence' }];

const whyClarity = [
  {
    title: 'No hidden fees',
    body: 'One price covers your plan. We don’t charge per click, per campaign, or per integration. What you see is what you pay.',
  },
  {
    title: 'Predictable spend',
    body: 'Scale your ad accounts without surprise line items. Upgrade when you’re ready; we don’t lock you into long-term contracts.',
  },
  {
    title: 'Full transparency',
    body: 'Every plan includes the same core: AI optimization, real-time analytics, and support. No feature paywalls inside your tier.',
  },
];

const includedInAll = [
  'Unlimited campaigns across supported connected accounts',
  'AI bid and budget optimization',
  'Real-time dashboards and revenue attribution',
  'Email and chat support',
  'Guided onboarding for connected ad accounts',
];

const pricingFaqs = [
  {
    question: 'Are there any hidden fees?',
    answer: 'No. Your subscription is all-in. We don’t charge per click, per campaign, or per integration. Setup is included; there are no onboarding or implementation fees.',
  },
  {
    question: 'Can I change plans later?',
    answer: 'Yes. You can upgrade or downgrade anytime. Changes take effect at the start of your next billing cycle. We’ll prorate if you upgrade mid-cycle.',
  },
  {
    question: 'What if I need more than 15 ad accounts?',
    answer: 'Enterprise is for unlimited ad accounts and custom rollout needs. Book an Enterprise demo so we can review account scope, integrations, billing, and support requirements before quoting.',
  },
  {
    question: 'Is there a long-term contract?',
    answer: 'No. All plans are month-to-month. Cancel anytime. We believe you’ll stay because the product earns its keep, not because you’re locked in.',
  },
  {
    question: 'How can I evaluate the platform?',
    answer: 'Choose the plan you are considering and book a demo. The demo form keeps that plan selected so we can walk through connected ad account needs, pricing fit, and onboarding path before you commit.',
  },
];
---

<Layout
  breadcrumbs={[{ name: 'Home', href: '/' }, ...breadcrumbs]}
  title="Pricing Intelligence — Transparent Plans | Advertising Systems"
  description="One price. No hidden fees, no per-click charges. See what you get in every plan and how our pricing scales with your growth."
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={[{ name: 'Home', href: '/' }, ...breadcrumbs]} />

    <PageHero
      title="Pricing that"
      titleAccent="scales with you."
      lead="One price per plan. No per-click fee, no per-campaign fee, no per-integration fee, and no line item that appears at the end of the month."
      primaryCta={{ text: 'See the plans', href: '#plans' }}
      secondaryCta={{ text: 'Book a demo', href: '/book-demo' }}
    />

    <!-- 01 · Why -->
    <section class="sec" aria-labelledby="why-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="why-heading">Why we keep it simple.</h2>
            <p class="sub">You should be able to predict next month's invoice from this month's.</p>
          </div>
        </div>
        <div class="cardgrid">
          {whyClarity.map((item, i) => (
            <div>
              <div class="cn">{String(i + 1).padStart(2, '0')}</div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 · Included -->
    <section class="sec soft" aria-labelledby="included-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="included-heading">In every plan, including the smallest.</h2>
            <p class="sub">The tier changes scale, not capability. There are no features locked behind a higher plan.</p>
          </div>
        </div>
        <ul class="incl">
          {includedInAll.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <!-- 03 · Plans -->
    <section id="plans" class="sec" aria-labelledby="plans-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div>
            <h2 id="plans-heading">Choose the plan that fits.</h2>
            <p class="sub">Month to month. Upgrade or downgrade at the start of the next cycle; upgrades mid-cycle are prorated.</p>
          </div>
        </div>
        <PricingCards />
        <p class="fine">Enterprise covers unlimited ad accounts and custom rollout — <a href="/book-demo">book a scoping call</a>.</p>
      </div>
    </section>

    <!-- 04 · FAQ -->
    <section class="sec soft" aria-labelledby="faq-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">04</span>
          <div><h2 id="faq-heading">Questions about the bill.</h2></div>
        </div>
        <div class="faq">
          {pricingFaqs.map((faq, i) => (
            <details name="pricing-faq" open={i === 0}>
              <summary>{faq.question}</summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
        <p class="fine">Still have questions? <a href="/contact">Contact us →</a></p>
      </div>
    </section>

    <CTABand />
  </main>
  <Footer />

  <style>
    .incl { border-top: 1px solid var(--border); max-width: 56em; }
    .incl li {
      display: flex; gap: 12px; align-items: baseline;
      padding: 13px 0; border-bottom: 1px solid var(--border);
      font-size: 15px; color: var(--text-secondary);
    }
    .incl li::before { content: "\2713"; color: var(--pos); font-weight: 700; }
  </style>
</Layout>
