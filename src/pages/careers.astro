---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQSection from '../components/FAQSection.astro';
import { careersFaqs } from '../data/page-faqs';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';

const breadcrumbs = [{ name: 'Careers', href: '/careers' }];

const benefits = [
  { n: '01', title: 'Remote-first', desc: 'Work from anywhere. Great work happens where you are, not where the office is.' },
  { n: '02', title: 'Meaningful equity', desc: 'Real ownership in the company you are building, not a rounding error in a grant letter.' },
  { n: '03', title: 'Health & wellness', desc: 'Comprehensive health, dental and vision cover, plus a wellness stipend.' },
  { n: '04', title: 'Learning budget', desc: 'An annual stipend for courses, conferences and books — anything that compounds.' },
];

const culture = [
  { n: '01', title: 'Ship with purpose', desc: 'Every feature has to name the customer problem it solves before it gets built.' },
  { n: '02', title: 'Radical transparency', desc: 'Open books, open roadmap, open communication — the same standard the product holds.' },
  { n: '03', title: 'People first', desc: 'Sustainable pace. Nobody does their best work on their fourth consecutive late night.' },
];
---

<Layout
  title="Careers — Advertising Systems | Join the Team"
  description="Join the team building the future of advertising technology at Multisystems. Explore open positions and learn about our culture."
  breadcrumbs={breadcrumbs}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Careers at Advertising Systems',
    url: 'https://www.advertisingsystems.ai/careers',
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', 'h2']
    }
  }}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />

    <PageHero
      badge="We're hiring"
      title="Join the team building"
      titleAccent="the future of advertising."
      lead="Multisystems is assembling engineers, data scientists and operators to solve advertising's measurement problem — starting with the half of it nobody can currently see."
      primaryCta={{ text: 'Send your résumé', href: 'mailto:careers@multisystems.ai' }}
      secondaryCta={{ text: 'About us', href: '/about' }}
      fine="No specific openings are listed right now — we still read everything that arrives."
    />

    <!-- 01 · Culture -->
    <section class="sec" aria-labelledby="culture-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="culture-heading">How we work.</h2>
            <p class="sub">
              We move fast, ship often and measure everything — at a pace that can be sustained past
              the first quarter.
            </p>
          </div>
        </div>
        <div class="cardgrid">
          {culture.map((item) => (
            <div>
              <div class="cn">{item.n}</div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 02 · Open positions -->
    <section class="sec soft" aria-labelledby="positions-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="positions-heading">Open positions.</h2>
          </div>
        </div>
        <div class="panel-box">
          <div class="panel-hd">
            <h3>Roles — currently listed</h3>
            <span class="illus">0 open</span>
          </div>
          <div class="empty">
            <p>
              Nothing is listed at the moment. We are still open to hearing from people who would
              obviously be a fit — tell us what you would work on first and why.
            </p>
            <div class="cta-row">
              <a class="btn btn-p btn-sm" href="mailto:careers@multisystems.ai">careers@multisystems.ai</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 · Benefits -->
    <section class="sec" aria-labelledby="benefits-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div>
            <h2 id="benefits-heading">What comes with the job.</h2>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {benefits.map((benefit) => (
            <div>
              <div class="cn">{benefit.n}</div>
              <h3>{benefit.title}</h3>
              <p>{benefit.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={careersFaqs} name="careers-faq" no="04" soft={true} />
    <CTABand />
  </main>
  <Footer />

  <style>
    .empty { padding: 26px 18px; }
    .empty p { font-size: 14.5px; color: var(--text-secondary); max-width: 44em; line-height: 1.6; }
  </style>
</Layout>
