---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import FAQSection from '../../components/FAQSection.astro';
import { vsPageFaqs } from '../../data/page-faqs';

const breadcrumbs = [{ name: 'vs Google Ads', href: '/vs/google-ads' }];

const features = [
  { name: 'Multi-platform support', us: true, them: false },
  { name: 'Cross-channel attribution', us: true, them: false },
  { name: 'Unified budget management', us: true, them: false },
  { name: 'AI audience discovery', us: true, them: 'partial' },
  { name: 'OTA integration', us: true, them: false },
  { name: 'Single dashboard for all channels', us: true, them: false },
  { name: 'Google Ads management', us: true, them: true },
  { name: 'Meta Ads management', us: true, them: false },
  { name: 'Automated cross-channel reporting', us: true, them: false },
  { name: 'AI bid optimization', us: true, them: 'partial' },
];

const advantages = [
  {
    title: 'Multi-Channel, Not Single-Channel',
    desc: 'Google Ads only manages Google. Advertising Systems unifies Google, Meta, OTAs, and more into one intelligent platform.',
    icon: 'multi',
  },
  {
    title: 'Unified Analytics',
    desc: 'Stop piecing together data from siloed platforms. Get cross-channel attribution and a single source of truth for all ad performance.',
    icon: 'analytics',
  },
  {
    title: 'AI Cross-Channel Optimization',
    desc: 'Our AI shifts budgets across all channels in real time, not just within Google. Maximize ROAS across your entire ad portfolio.',
    icon: 'ai',
  },
  {
    title: 'OTA Integration Built In',
    desc: 'For hospitality and travel businesses, Advertising Systems integrates OTA channels alongside paid ads for total visibility.',
    icon: 'ota',
  },
];

const comparisons = [
  { label: 'Channel Coverage', us: 'Google, Meta, OTAs & more', them: 'Google only' },
  { label: 'Analytics', us: 'Unified cross-channel attribution', them: 'Siloed Google-only data' },
  { label: 'AI Optimization', us: 'Cross-channel AI optimization', them: 'Platform-limited Smart Bidding' },
];
---

<Layout
  title="Advertising Systems vs Google Ads Only | Compare"
  description="Compare Advertising Systems with Google Ads alone: multi-channel management, unified analytics, and cross-channel AI vs single-platform tools."
  breadcrumbs={breadcrumbs}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Advertising Systems vs Google Ads Manager',
    description: 'Compare Advertising Systems with using Google Ads alone. See how multi-channel management, unified analytics, and cross-channel AI outperform single-platform tools.',
    url: 'https://advertisingsystems.ai/vs/google-ads',
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', 'h2', '.lead']
    }
  }}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />

    <PageHero
      badge="Comparison"
      title="Advertising Systems"
      titleAccent="vs Google Ads alone."
      lead="Google Ads is the best tool in the world for managing Google Ads. It has no opinion about the other half of your spend."
      primaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      secondaryCta={{ text: 'See pricing', href: '/pricing' }}
    />

    <!-- 01 · The short version -->
    <section class="sec" aria-labelledby="summary-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div><h2 id="summary-heading">The short version.</h2></div>
        </div>
        <div class="panel-box scroll-x">
          <table class="bench">
            <thead>
              <tr><th>&nbsp;</th><th>Advertising Systems</th><th>Google Ads</th></tr>
            </thead>
            <tbody>
              {comparisons.map((item) => (
                <tr>
                  <td class="m">{item.label}</td>
                  <td class="cmp-us">{item.us}</td>
                  <td class="cmp-them">{item.them}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 02 · Feature by feature -->
    <section class="sec soft" aria-labelledby="table-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div><h2 id="table-heading">Feature by feature.</h2></div>
        </div>
        <div class="panel-box scroll-x">
          <table class="bench">
            <thead>
              <tr><th>Capability</th><th class="c">Advertising Systems</th><th class="c">Google Ads</th></tr>
            </thead>
            <tbody>
              {features.map((f) => (
                <tr>
                  <td>{f.name}</td>
                  <td class="c">{f.us === true ? <span class="yes">Yes</span> : <span class="no-">No</span>}</td>
                  <td class="c">{f.them === true ? <span class="yes">Yes</span> : f.them === 'partial' ? <span class="part">Partial</span> : <span class="no-">No</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 03 · Why -->
    <section class="sec" aria-labelledby="advantages-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div><h2 id="advantages-heading">What the difference buys you.</h2></div>
        </div>
        <div class="cardgrid cols-2">
          {advantages.map((adv, i) => (
            <div>
              <div class="cn">{String(i + 1).padStart(2, '0')}</div>
              <h3>{adv.title}</h3>
              <p>{adv.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={vsPageFaqs} name="vs-google-faq" no="04" soft={true} />

    <section class="band" aria-labelledby="cta-heading">
      <div class="wrap">
        <h2 id="cta-heading">Keep Google Ads. Stop managing it alone.</h2>
        <p>Google Ads stays in the stack — it just stops being a separate screen with its own numbers.</p>
        <div class="cta-row">
          <a class="btn btn-p" href="/book-demo">Book a demo</a>
          <a class="btn btn-l" href="/pricing">Compare plans</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <style>
    .cmp-us { color: var(--text-primary); font-weight: 600; }
    .cmp-us::before { content: "\2713"; color: var(--pos); font-weight: 700; margin-right: 9px; }
    .cmp-them { color: var(--text-tertiary); }
    .cmp-them::before { content: "\2715"; color: var(--neg); font-weight: 700; margin-right: 9px; }
    .yes { color: var(--pos); font-weight: 700; }
    .no- { color: var(--text-tertiary); }
    .part {
      font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--warn); border: 1px solid var(--warn); border-radius: 2px; padding: 2px 6px;
    }
  </style>
</Layout>
