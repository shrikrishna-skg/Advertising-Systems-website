---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import FAQSection from '../../components/FAQSection.astro';
import { vsPageFaqs } from '../../data/page-faqs';

const breadcrumbs = [{ name: 'vs Meta Ads', href: '/vs/meta-ads' }];

const features = [
  { name: 'Multi-platform support', us: true, them: false },
  { name: 'Cross-platform attribution', us: true, them: false },
  { name: 'Unified budget management', us: true, them: false },
  { name: 'AI audience discovery', us: true, them: 'partial' },
  { name: 'OTA integration', us: true, them: false },
  { name: 'Single dashboard for all channels', us: true, them: false },
  { name: 'Google Ads management', us: true, them: false },
  { name: 'Facebook & Instagram Ads', us: true, them: true },
  { name: 'Automated cross-channel reporting', us: true, them: false },
  { name: 'AI bid optimization', us: true, them: 'partial' },
  { name: 'Search ads management', us: true, them: false },
  { name: 'Cross-channel budget shifting', us: true, them: false },
];

const advantages = [
  {
    title: 'All Channels, Not Just Meta',
    desc: 'Meta Ads Manager only covers Facebook and Instagram. Advertising Systems unifies Meta, Google, OTAs, and more under one roof.',
    icon: 'multi',
  },
  {
    title: 'Cross-Platform Attribution',
    desc: 'Meta metrics only tell you about Meta. Get true cross-platform attribution to understand how all channels work together to drive conversions.',
    icon: 'analytics',
  },
  {
    title: 'AI That Sees the Full Picture',
    desc: 'Meta Advantage+ optimizes within Meta only. Our AI optimizes across all channels simultaneously, shifting budget to wherever ROAS is highest.',
    icon: 'ai',
  },
  {
    title: 'Beyond Social Advertising',
    desc: 'Customers discover your brand through search, social, and OTAs. Manage the entire journey from one platform instead of switching between tools.',
    icon: 'journey',
  },
];

const comparisons = [
  { label: 'Channel Coverage', us: 'Google, Meta, OTAs & more', them: 'Facebook & Instagram only' },
  { label: 'Attribution', us: 'Cross-platform full-funnel', them: 'Meta-only metrics' },
  { label: 'AI Optimization', us: 'Cross-channel AI optimization', them: 'Advantage+ (Meta-only)' },
];
---

<Layout
  title="Advertising Systems vs Meta Ads Only | Compare"
  description="Compare Advertising Systems with using Meta Ads Manager alone. See how multi-channel management and cross-platform attribution outperform single-platform tools."
  breadcrumbs={breadcrumbs}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Advertising Systems vs Meta Ads Manager',
    description: 'Compare Advertising Systems with using Meta Ads Manager alone. See how multi-channel management and cross-platform attribution outperform single-platform tools.',
    url: 'https://advertisingsystems.ai/vs/meta-ads',
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', 'h2', '.lead']
    }
  }}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />

    <PageHero
      badge="Comparison"
      title="Advertising Systems"
      titleAccent="vs Meta Ads alone."
      lead="Meta Ads Manager reports on Facebook and Instagram. Your booking came from somewhere in a path that crossed both, and Meta cannot see the rest of it."
      primaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      secondaryCta={{ text: 'See pricing', href: '/pricing' }}
    />

    <!-- 01 · The short version -->
    <section class="sec" aria-labelledby="summary-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div><h2 id="summary-heading">The short version.</h2></div>
        </div>
        <div class="panel-box scroll-x">
          <table class="bench">
            <thead>
              <tr><th>&nbsp;</th><th>Advertising Systems</th><th>Meta Ads</th></tr>
            </thead>
            <tbody>
              {comparisons.map((item) => (
                <tr>
                  <td class="m">{item.label}</td>
                  <td class="cmp-us">{item.us}</td>
                  <td class="cmp-them">{item.them}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 02 · Feature by feature -->
    <section class="sec soft" aria-labelledby="table-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div><h2 id="table-heading">Feature by feature.</h2></div>
        </div>
        <div class="panel-box scroll-x">
          <table class="bench">
            <thead>
              <tr><th>Capability</th><th class="c">Advertising Systems</th><th class="c">Meta Ads</th></tr>
            </thead>
            <tbody>
              {features.map((f) => (
                <tr>
                  <td>{f.name}</td>
                  <td class="c">{f.us === true ? <span class="yes">Yes</span> : <span class="no-">No</span>}</td>
                  <td class="c">{f.them === true ? <span class="yes">Yes</span> : f.them === 'partial' ? <span class="part">Partial</span> : <span class="no-">No</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 03 · Why -->
    <section class="sec" aria-labelledby="advantages-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div><h2 id="advantages-heading">What the difference buys you.</h2></div>
        </div>
        <div class="cardgrid cols-2">
          {advantages.map((adv, i) => (
            <div>
              <div class="cn">{String(i + 1).padStart(2, '0')}</div>
              <h3>{adv.title}</h3>
              <p>{adv.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={vsPageFaqs} name="vs-meta-faq" no="04" soft={true} />

    <section class="band" aria-labelledby="cta-heading">
      <div class="wrap">
        <h2 id="cta-heading">Keep Meta. Stop reconciling it by hand.</h2>
        <p>Meta stays in the stack — measured against every other channel on the same definitions.</p>
        <div class="cta-row">
          <a class="btn btn-p" href="/book-demo">Book a demo</a>
          <a class="btn btn-l" href="/pricing">Compare plans</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <style>
    .cmp-us { color: var(--text-primary); font-weight: 600; }
    .cmp-us::before { content: "\2713"; color: var(--pos); font-weight: 700; margin-right: 9px; }
    .cmp-them { color: var(--text-tertiary); }
    .cmp-them::before { content: "\2715"; color: var(--neg); font-weight: 700; margin-right: 9px; }
    .yes { color: var(--pos); font-weight: 700; }
    .no- { color: var(--text-tertiary); }
    .part {
      font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--warn); border: 1px solid var(--warn); border-radius: 2px; padding: 2px 6px;
    }
  </style>
</Layout>
