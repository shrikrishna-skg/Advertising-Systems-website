---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import FAQSection from '../../components/FAQSection.astro';
import { vsPageFaqs } from '../../data/page-faqs';

const breadcrumbs = [{ name: 'vs Manual Management', href: '/vs/manual' }];

const features = [
  { name: 'Cross-channel management', us: true, them: false },
  { name: 'AI-powered bidding', us: true, them: false },
  { name: 'Automated reporting', us: true, them: false },
  { name: 'Budget optimization', us: true, them: false },
  { name: 'Continuous campaign monitoring', us: true, them: false },
  { name: 'Anomaly detection & alerts', us: true, them: false },
  { name: 'Real-time analytics', us: true, them: false },
  { name: 'Cross-channel attribution', us: true, them: false },
  { name: 'OTA integration', us: true, them: false },
  { name: 'Scalable campaign launch', us: true, them: false },
];

const advantages = [
  {
    title: 'Automation Over Spreadsheets',
    desc: 'Replace manual spreadsheet tracking with intelligent automation that manages campaigns across every channel simultaneously.',
    icon: 'automation',
  },
  {
    title: 'AI Optimization vs Guesswork',
    desc: 'Stop guessing which bids and budgets work. Our AI analyzes 50,000+ data points to make decisions backed by real performance data.',
    icon: 'ai',
  },
  {
    title: 'Real-Time vs Monthly Reports',
    desc: 'Why wait for month-end reports? Get live dashboards with instant anomaly alerts so you can act on performance shifts immediately.',
    icon: 'analytics',
  },
  {
    title: 'Continuous Monitoring, Zero Effort',
    desc: 'Your campaigns run around the clock — your management should too. AI monitors and adjusts while you focus on strategy.',
    icon: 'monitor',
  },
];

const comparisons = [
  { label: 'Campaign Management', us: 'AI-powered automation', them: 'Manual spreadsheets' },
  { label: 'Optimization', us: 'Machine learning across 50K+ data points', them: 'Gut feeling & guesswork' },
  { label: 'Reporting', us: 'Real-time dashboards & alerts', them: 'Monthly manual reports' },
];
---

<Layout
  title="Advertising Systems vs Manual Advertising Management | Compare"
  description="See how Advertising Systems replaces manual advertising management with AI-powered automation, real-time analytics, and cross-channel optimization."
  breadcrumbs={breadcrumbs}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Advertising Systems vs Manual Campaign Management',
    description: 'See how Advertising Systems replaces manual advertising management with AI-powered automation, real-time analytics, and cross-channel optimization.',
    url: 'https://www.advertisingsystems.ai/vs/manual',
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['h1', 'h2', '.lead']
    }
  }}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />

    <PageHero
      badge="Comparison"
      title="Advertising Systems"
      titleAccent="vs managing it by hand."
      lead="Manual management is not wrong — it is just bounded by how many hours there are, and by the fact that nothing happens between the times someone is looking."
      primaryCta={{ text: 'Book a demo', href: '/book-demo' }}
      secondaryCta={{ text: 'See pricing', href: '/pricing' }}
    />

    <!-- 01 · The short version -->
    <section class="sec" aria-labelledby="summary-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div><h2 id="summary-heading">The short version.</h2></div>
        </div>
        <div class="panel-box scroll-x">
          <table class="bench">
            <thead>
              <tr><th>&nbsp;</th><th>Advertising Systems</th><th>Manual</th></tr>
            </thead>
            <tbody>
              {comparisons.map((item) => (
                <tr>
                  <td class="m">{item.label}</td>
                  <td class="cmp-us">{item.us}</td>
                  <td class="cmp-them">{item.them}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 02 · Feature by feature -->
    <section class="sec soft" aria-labelledby="table-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div><h2 id="table-heading">Feature by feature.</h2></div>
        </div>
        <div class="panel-box scroll-x">
          <table class="bench">
            <thead>
              <tr><th>Capability</th><th class="c">Advertising Systems</th><th class="c">Manual</th></tr>
            </thead>
            <tbody>
              {features.map((f) => (
                <tr>
                  <td>{f.name}</td>
                  <td class="c">{f.us === true ? <span class="yes">Yes</span> : <span class="no-">No</span>}</td>
                  <td class="c">{f.them === true ? <span class="yes">Yes</span> : f.them === 'partial' ? <span class="part">Partial</span> : <span class="no-">No</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 03 · Why -->
    <section class="sec" aria-labelledby="advantages-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div><h2 id="advantages-heading">What the difference buys you.</h2></div>
        </div>
        <div class="cardgrid cols-2">
          {advantages.map((adv, i) => (
            <div>
              <div class="cn">{String(i + 1).padStart(2, '0')}</div>
              <h3>{adv.title}</h3>
              <p>{adv.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FAQSection title="Common questions" faqs={vsPageFaqs} name="vs-manual-faq" no="04" soft={true} />

    <section class="band" aria-labelledby="cta-heading">
      <div class="wrap">
        <h2 id="cta-heading">Keep the judgement. Drop the tab-switching.</h2>
        <p>The decisions that need a human keep one. The rest stop waiting for Monday.</p>
        <div class="cta-row">
          <a class="btn btn-p" href="/book-demo">Book a demo</a>
          <a class="btn btn-l" href="/pricing">Compare plans</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <style>
    .cmp-us { color: var(--text-primary); font-weight: 600; }
    .cmp-us::before { content: "\2713"; color: var(--pos); font-weight: 700; margin-right: 9px; }
    .cmp-them { color: var(--text-tertiary); }
    .cmp-them::before { content: "\2715"; color: var(--neg); font-weight: 700; margin-right: 9px; }
    .yes { color: var(--pos); font-weight: 700; }
    .no- { color: var(--text-tertiary); }
    .part {
      font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--warn); border: 1px solid var(--warn); border-radius: 2px; padding: 2px 6px;
    }
  </style>
</Layout>
