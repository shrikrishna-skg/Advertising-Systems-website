---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQSection from '../components/FAQSection.astro';
import PageHero from '../components/PageHero.astro';
import CTABand from '../components/CTABand.astro';
import { otaAdvertisingFaqs } from '../data/page-faqs';
import { otaPlatforms, otaPainPoints, otaCapabilities, otaStats, otaMarketInsights } from '../data/ota';

const breadcrumbs = [
  { name: 'OTA Advertising', href: '/ota-advertising' },
];

/**
 * The platform letter-tiles are gone, not restyled. They were ten raw Tailwind
 * fills (a brand colour per OTA) which is exactly the thing this direction does
 * not do: one accent, everything else structure. The platform name and its ad
 * model carry the same information without importing ten more colours.
 */
---

<Layout
  breadcrumbs={breadcrumbs}
  title="OTA Advertising on Booking.com, Expedia & More — Advertising Systems"
  description="Coming soon: manage and optimize advertising across Booking.com, Expedia, TripAdvisor, Google Hotel Ads, Trivago and 10+ OTAs from one AI dashboard."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'OTA Advertising',
    description: 'Manage and optimize advertising across Booking.com, Expedia, TripAdvisor, Google Hotel Ads, Trivago, and 10+ OTA platforms from one AI-powered dashboard.',
    url: 'https://www.advertisingsystems.ai/ota-advertising',
  }}
>
  <Navbar />
  <main class="terminal">
    <Breadcrumb items={breadcrumbs} />

    <PageHero
      badge="Live — Expedia TravelAds"
      title="OTA advertising."
      titleAccent="Every platform on one ledger."
      lead="Sponsored listings across Booking.com, Expedia, TripAdvisor, Google Hotel Ads and Trivago — bid, budget and paced from one place, against one set of definitions."
      primaryCta={{ text: 'Book a demo', href: '/book-demo?source_page=ota-advertising&cta=ota-hero-demo' }}
      secondaryCta={{ text: 'Get started', href: '/signup?source_page=ota-advertising&cta=ota-hero-get-started' }}
    />

    <!-- 01 · Verified proof -->
    <section class="sec" aria-labelledby="stats-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="stats-heading">The hotel advertising proof.</h2>
            <p class="sub">
              One managed property, thirty days, every number taken from the platform export and
              reconciled line by line against its own daily series.
            </p>
          </div>
        </div>
        <div class="panel-box">
          <div class="panel-hd">
            <h3>Expedia TravelAds — 30-day export</h3>
            <span class="illus ok">Verified</span>
          </div>
          <div class="kpis">
            {otaStats.map((stat) => (
              <div class="kpi">
                <span class="k">{stat.label}</span>
                <span class="v num">{stat.value}</span>
                <span class="d">{stat.detail}</span>
              </div>
            ))}
          </div>
        </div>
        <p class="fine"><a href="/case-studies">Read the full case →</a></p>
      </div>
    </section>

    <!-- 02 · The problem -->
    <section class="sec soft" aria-labelledby="pain-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="pain-heading">Four extranets, four sets of rules.</h2>
            <p class="sub">What OTA advertising costs before a single bid is placed.</p>
          </div>
        </div>
        <div class="cardgrid pain">
          {otaPainPoints.map((point, i) => (
            <div>
              <div class="cn">{String(i + 1).padStart(2, '0')}</div>
              <h3>{point.title}</h3>
              <p>{point.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 03 · Platforms -->
    <section class="sec" aria-labelledby="platforms-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div>
            <h2 id="platforms-heading">Platforms you can activate today.</h2>
            <p class="sub">Live integrations only. Everything else on the roadmap is listed as planned on <a href="/integrations">integrations</a>, not shown here as if it shipped.</p>
          </div>
        </div>
        <div class="plats">
          {otaPlatforms.filter((platform) => platform.status === 'live').map((platform) => (
            <article class="plat">
              <div class="plat-hd">
                <h3>{platform.name}</h3>
                <span class="illus ok">Live</span>
              </div>
              <div class="plat-meta">
                <span>{platform.adModel}</span>
                <span>{platform.reach}</span>
              </div>
              <p class="plat-desc">{platform.description}</p>
              <ul class="plat-feats">
                {platform.features.map((feature) => <li>{feature}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 · The screen -->
    <section class="sec soft" aria-labelledby="mockup-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">04</span>
          <div>
            <h2 id="mockup-heading">One dashboard for every OTA.</h2>
            <p class="sub">Same columns on every platform, so a comparison between them is an actual comparison.</p>
          </div>
        </div>
        <div class="panel-box">
          <div class="panel-hd">
            <h3>OTA campaign manager</h3>
            <span class="illus">Illustrative</span>
          </div>
          <div class="scroll-x">
            <table class="bench">
              <thead>
                <tr>
                  <th>Platform</th>
                  <th class="r">Avg CPC</th>
                  <th class="r">Clicks</th>
                  <th class="r">ROAS</th>
                  <th>State</th>
                </tr>
              </thead>
              <tbody>
                <tr><td class="m">Expedia</td><td class="r">$0.98</td><td class="r">487</td><td class="r up">5.2×</td><td><span class="st st-live">Optimising</span></td></tr>
                <tr><td class="m">Booking.com</td><td class="r">$1.24</td><td class="r">312</td><td class="r up">4.8×</td><td><span class="st st-live">Optimising</span></td></tr>
                <tr><td class="m">TripAdvisor</td><td class="r">$1.96</td><td class="r">189</td><td class="r">3.9×</td><td><span class="st st-warn">Watch</span></td></tr>
              </tbody>
            </table>
          </div>
          <div class="log-row">
            <span class="src">CROSS-OTA</span>
            <p>Shifted <b>$280</b> from Booking.com to Expedia — higher trailing ROAS this week.</p>
            <span class="amt up num">+18% ROAS</span>
          </div>
          <div class="log-row">
            <span class="src">OCCUPANCY</span>
            <p>85% occupancy Mar 21–24 — Booking.com ads paused for those dates.</p>
            <span class="amt num">$140 held</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 05 · Capabilities -->
    <section class="sec" aria-labelledby="capabilities-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">05</span>
          <div><h2 id="capabilities-heading">What the OTA layer does.</h2></div>
        </div>
        <div class="cardgrid cols-2">
          {otaCapabilities.map((cap, i) => (
            <div>
              <div class="cn">{String(i + 1).padStart(2, '0')}</div>
              <h3>{cap.title}</h3>
              <p>{cap.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 06 · Landscape -->
    <section class="sec soft" aria-labelledby="market-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">06</span>
          <div>
            <h2 id="market-heading">Who you are bidding against.</h2>
            <p class="sub">Each of these is a portfolio, not a single site. Sponsored placement is how a property competes inside that marketing rather than under it.</p>
          </div>
        </div>
        <div class="scroll-x panel-box">
          <table class="bench">
            <thead>
              <tr><th>Group</th><th>Brands under it</th><th>Why it matters to your bid</th></tr>
            </thead>
            <tbody>
              {otaMarketInsights.map((insight) => (
                <tr>
                  <td class="m">{insight.title}</td>
                  <td>{insight.brands}</td>
                  <td>{insight.detail}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="how">
          <div class="how-step">
            <span class="cn">01</span>
            <h3>Bid for placement</h3>
            <p>Properties bid CPC or CPA to appear in premium positions inside OTA search results.</p>
          </div>
          <div class="how-step">
            <span class="cn">02</span>
            <h3>Travellers click</h3>
            <p>Your listing appears on the searches that match it. You pay on the click, or on the booking.</p>
          </div>
          <div class="how-step">
            <span class="cn">03</span>
            <h3>Convert and measure</h3>
            <p>Bookings, revenue and ROAS per platform — unified, so bids move on evidence rather than habit.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 07 · Manual comparison -->
    <section class="sec" aria-labelledby="compare-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">07</span>
          <div><h2 id="compare-heading">Why not run the extranets by hand?</h2></div>
        </div>
        <div class="panel-box scroll-x">
          <table class="bench">
            <thead>
              <tr><th>Capability</th><th>Manual (OTA extranets)</th><th>Advertising Systems</th></tr>
            </thead>
            <tbody>
              <tr><td class="m">Unified dashboard</td><td class="cmp-them">Separate logins per OTA</td><td class="cmp-us">All OTAs in one view</td></tr>
              <tr><td class="m">Bid optimisation</td><td class="cmp-them">Manual CPC adjustments</td><td class="cmp-us">Continuous, inside guardrails</td></tr>
              <tr><td class="m">Cross-OTA budget</td><td class="cmp-them">Fixed budget per platform</td><td class="cmp-us">Reallocated on performance</td></tr>
              <tr><td class="m">Occupancy-aware pacing</td><td class="cmp-them">Ads run regardless</td><td class="cmp-us">Paused at high occupancy</td></tr>
              <tr><td class="m">Attribution</td><td class="cmp-them">Each OTA reports alone</td><td class="cmp-us">OTA + Google + Meta together</td></tr>
              <tr><td class="m">Time to run it</td><td class="cmp-them">Hours, daily</td><td class="cmp-us">Setup, then reviewed</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 08 · Related -->
    <section class="sec soft" aria-labelledby="related-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">08</span>
          <div><h2 id="related-heading">The modules behind it.</h2></div>
        </div>
        <div class="cardgrid cols-2">
          <a href="/features/campaign-management" class="r-card"><div class="cn">01</div><h3>Campaign Intelligence</h3><span class="r-fact">One dashboard, every channel</span></a>
          <a href="/features/ai-optimization" class="r-card"><div class="cn">02</div><h3>AI Optimization Engine</h3><span class="r-fact">Adjusts every 15 minutes</span></a>
          <a href="/features/analytics" class="r-card"><div class="cn">03</div><h3>Performance Analytics</h3><span class="r-fact">Attribution to booking revenue</span></a>
          <a href="/features/budget-intelligence" class="r-card"><div class="cn">05</div><h3>Budget Allocator</h3><span class="r-fact">Cross-channel reallocation</span></a>
        </div>
      </div>
    </section>

    <FAQSection title="OTA advertising — common questions" faqs={otaAdvertisingFaqs} name="ota-faq" no="09" soft={false} />
    <CTABand />
  </main>
  <Footer />

  <style>
    .pain .cn { color: var(--neg); }
    .sec-hd .sub a { color: var(--acc); font-weight: 600; text-decoration: none; }

    .kpis { display: grid; grid-template-columns: repeat(4, 1fr); }
    .kpi { padding: 16px; border-right: 1px solid var(--border); min-width: 0; }
    .kpi:last-child { border-right: 0; }
    .kpi .k { display: block; font-size: 9.5px; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; color: var(--text-tertiary); }
    .kpi .v { display: block; margin-top: 6px; font-size: 24px; font-weight: 800; letter-spacing: -0.025em; color: var(--text-primary); }
    .kpi .d { display: block; margin-top: 6px; font-size: 11.5px; color: var(--text-tertiary); line-height: 1.45; }
    @media (max-width: 900px) {
      .kpis { grid-template-columns: repeat(2, 1fr); }
      .kpi:nth-child(2) { border-right: 0; }
      .kpi:nth-child(-n+2) { border-bottom: 1px solid var(--border); }
    }
    @media (max-width: 520px) {
      .kpis { grid-template-columns: 1fr; }
      .kpi { border-right: 0; border-bottom: 1px solid var(--border); }
      .kpi:last-child { border-bottom: 0; }
    }

    .plats { border-top: 1px solid var(--border); }
    .plat { padding: 24px 0; border-bottom: 1px solid var(--border); }
    .plat-hd { display: flex; align-items: center; gap: 12px; }
    .plat-hd h3 { font-size: 19px; font-weight: 800; letter-spacing: -0.02em; color: var(--text-primary); }
    .plat-meta { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 8px; font-size: 11.5px; font-weight: 600; color: var(--text-tertiary); }
    .plat-desc { margin-top: 11px; font-size: 14px; color: var(--text-secondary); max-width: 54em; line-height: 1.55; }
    .plat-feats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5px 22px; margin-top: 14px; }
    .plat-feats li { font-size: 12.5px; color: var(--text-tertiary); display: flex; gap: 8px; }
    .plat-feats li::before { content: "\2713"; color: var(--pos); font-weight: 700; }
    @media (max-width: 640px) { .plat-feats { grid-template-columns: 1fr; } }

    .st {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 11px; font-weight: 700;
      border: 1px solid var(--border); border-radius: 2px; padding: 2px 7px;
      white-space: nowrap; color: var(--text-tertiary);
    }
    .st::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
    .st-live { color: var(--pos); border-color: var(--pos-line); }
    .st-warn { color: var(--warn); border-color: var(--warn); }

    .log-row {
      display: grid; grid-template-columns: 120px 1fr auto; gap: 16px;
      padding: 12px 16px; border-top: 1px solid var(--border);
      font-size: 13px; align-items: center;
    }
    .log-row .src { font-size: 11px; font-weight: 700; letter-spacing: 0.05em; color: var(--text-secondary); }
    .log-row p { color: var(--text-secondary); line-height: 1.5; }
    .log-row p :global(b) { color: var(--text-primary); font-weight: 700; }
    .log-row .amt { font-weight: 700; white-space: nowrap; color: var(--text-primary); }
    .log-row .amt.up { color: var(--pos); }
    @media (max-width: 640px) {
      .log-row { grid-template-columns: 1fr auto; gap: 6px; }
      .log-row .src { grid-column: 1 / -1; }
    }

    .how {
      display: grid; grid-template-columns: repeat(3, 1fr);
      margin-top: 26px;
      border-top: 1px solid var(--border); border-left: 1px solid var(--border);
    }
    .how-step {
      padding: 20px; background: var(--surface-raised);
      border-right: 1px solid var(--border); border-bottom: 1px solid var(--border);
      min-width: 0;
    }
    .how-step .cn { font-size: 10px; font-weight: 700; letter-spacing: 0.12em; color: var(--acc); }
    .how-step h3 { margin-top: 7px; font-size: 15.5px; font-weight: 800; color: var(--text-primary); letter-spacing: -0.015em; }
    .how-step p { margin-top: 6px; font-size: 13px; color: var(--text-tertiary); line-height: 1.55; }
    @media (max-width: 800px) { .how { grid-template-columns: 1fr; } }

    .cmp-us { color: var(--text-primary); font-weight: 600; }
    .cmp-us::before { content: "\2713"; color: var(--pos); font-weight: 700; margin-right: 9px; }
    .cmp-them { color: var(--text-tertiary); }
    .cmp-them::before { content: "\2715"; color: var(--neg); font-weight: 700; margin-right: 9px; }

    .r-card { text-decoration: none; display: block; transition: background 0.15s; }
    a.r-card:hover { background: var(--surface); }
    a.r-card:hover h3 { color: var(--acc); }
    .r-card h3 { transition: color 0.15s; }
    .r-fact {
      display: inline-block; margin-top: 13px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--text-tertiary); border: 1px solid var(--border); border-radius: 2px; padding: 2px 6px;
    }
  </style>
</Layout>
