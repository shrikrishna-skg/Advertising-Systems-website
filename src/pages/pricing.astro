---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import RateRows from '../components/RateRows.astro';
import CTABand from '../components/CTABand.astro';
import { pricingPlans } from '../data/pricing';
import {
  pricingComparisonRows,
  planFeatureMatrix,
  ourDifferentiators,
  pricingPageFaqs,
} from '../data/pricing-comparison';

/**
 * Pricing — Wave 3, Terminal conversion.
 *
 * HONESTY PASS: the old ROI section claimed "$40,000/month managed spend, up to
 * 30% more bookings, $12M+ customer revenue". Those aggregates appear in 10+
 * files with no provenance anywhere in the repo (see the plan report). Removed
 * here, replaced with plan facts and a pointer to the verified export on the
 * homepage. Also removed: the old PricingCards "capability meters"
 * (Optimization 72, Insights 36 …) — invented precision with no unit.
 */
const breadcrumbs = [{ name: 'Pricing', href: '/pricing' }];

function formatCell(value: boolean | string): string {
  if (typeof value === 'boolean') return value ? 'Yes' : '—';
  return value;
}
---

<Layout
  breadcrumbs={[{ name: 'Home', href: '/' }, ...breadcrumbs]}
  title="Pricing — Advertising Systems | Plans & Value Comparison"
  description="Transparent pricing by ad account. Compare Advertising Systems against manual spreadsheets, single-channel dashboards, and agency reporting."
>
  <Navbar />
  <main class="terminal">
    <PageHero
      badge="Plans & decision guide"
      title="Simple pricing."
      titleAccent="No games."
      lead="One price per plan, set by ad accounts under management. No percentage of ad spend, no overages — the platforms bill your media directly."
      primaryCta={{ text: 'View plans', href: '#plans' }}
      secondaryCta={{ text: 'Compare options', href: '#compare' }}
      fine="Secure signup · Guided onboarding · Cancel anytime"
    />

    <!-- 01 · Plans -->
    <section class="sec" id="plans" aria-labelledby="plans-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">01</span>
          <div>
            <h2 id="plans-heading">Priced by accounts under management.</h2>
            <p class="sub">Same AI and modules on every plan. Scale by ad account count; ad spend is billed by the platforms, separately and directly.</p>
          </div>
        </div>

        <div class="rates-embed"><RateRows /></div>

        <div class="cardgrid cols-2 plan-detail" id="plan-detail">
          {pricingPlans.map((plan) => (
            <article aria-label={`${plan.name} plan details`}>
              <div class="cn">{plan.name}{plan.badge && <span class="pd-pop">{plan.badge}</span>}</div>
              <div class="pd-price num">
                {plan.price.replace(/\.00$/, '')}
                {plan.period === '/month' && <em>/mo · {plan.annualPrice.replace(/\.00$/, '')}/mo annual</em>}
              </div>
              <ul class="pd-quotas">
                {plan.quotas.map((q) => (
                  <li><b class="num">{q.value}</b> {q.label}</li>
                ))}
              </ul>
              <ul class="pd-features">
                {plan.features.map((f) => <li>{f}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <p class="fine">Annual billing is 20% lower. Choosing a plan carries it into the demo booking so the call starts with the right account scope.</p>
      </div>
    </section>

    <!-- 02 · Operating-model comparison -->
    <section class="sec soft" id="compare" aria-labelledby="compare-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">02</span>
          <div>
            <h2 id="compare-heading">Choose the operating model before the plan.</h2>
            <p class="sub">The question is not just price. It is how clearly your team can see spend, revenue and the next action across every channel.</p>
          </div>
        </div>

        <div class="panel-box scroll-x">
          <table class="bench" role="table">
            <thead>
              <tr>
                <th>Option</th><th>Pricing model</th><th>Visibility</th><th>Automation</th><th>Best fit</th>
              </tr>
            </thead>
            <tbody>
              {pricingComparisonRows.map((row) => (
                <tr class={row.highlighted ? 'is-hl' : ''}>
                  <td class="m">{row.highlighted ? 'Advertising Systems' : row.name}</td>
                  <td>{row.pricingModel}</td>
                  <td>{row.visibility}</td>
                  <td>{row.automation}</td>
                  <td>{row.bestFit}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fine">Use this guide to choose the right control model before you choose a plan.</p>
      </div>
    </section>

    <!-- 03 · How the pricing is different -->
    <section class="sec" aria-labelledby="different-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">03</span>
          <div>
            <h2 id="different-heading">Why this pricing is different.</h2>
            <p class="sub">No percentage of spend. No overages. One platform for Google, Meta and the OTAs.</p>
          </div>
        </div>
        <div class="cardgrid cols-2">
          {ourDifferentiators.map((item, i) => (
            <div>
              <div class="cn">{String(i + 1).padStart(2, '0')}</div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 · Feature matrix -->
    <section class="sec soft" aria-labelledby="features-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">04</span>
          <div>
            <h2 id="features-heading">What's in each plan.</h2>
            <p class="sub">Full feature breakdown. No hidden paywalls inside your tier.</p>
          </div>
        </div>

        <div class="panel-box scroll-x">
          <table class="bench" role="table">
            <thead>
              <tr>
                <th>Feature</th>
                <th class="c">Launch</th>
                <th class="c is-hl-col">Growth</th>
                <th class="c">Scale</th>
                <th class="c">Enterprise</th>
              </tr>
            </thead>
            <tbody>
              {planFeatureMatrix.map((row) => (
                <tr>
                  <td class="m">{row.feature}</td>
                  <td class="c">{formatCell(row.launch)}</td>
                  <td class="c is-hl-col">{formatCell(row.growth)}</td>
                  <td class="c">{formatCell(row.scale)}</td>
                  <td class="c">{formatCell(row.enterprise)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 05 · What the money buys, verifiably -->
    <section class="sec" aria-labelledby="value-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">05</span>
          <div>
            <h2 id="value-heading">One platform. One price. Predictable.</h2>
            <p class="sub">
              You pay for the system, never a percentage of your media. For what the platform
              does on a real account, read the verified 30-day Expedia TravelAds export on the
              homepage — real spend, real bookings, reconciled line by line.
            </p>
          </div>
        </div>
        <ul class="value-points" role="list">
          <li>Guided onboarding on every plan</li>
          <li>Paid ads tied to booking revenue</li>
          <li>Every automated decision logged and readable</li>
          <li>Cancel anytime</li>
        </ul>
        <p class="fine"><a href="/#case">See the verified case →</a></p>
      </div>
    </section>

    <!-- 06 · FAQ -->
    <section class="sec soft" aria-labelledby="pricing-faq-heading">
      <div class="wrap">
        <div class="sec-hd">
          <span class="no" aria-hidden="true">06</span>
          <div><h2 id="pricing-faq-heading">Pricing questions.</h2></div>
        </div>
        <div class="faq">
          {pricingPageFaqs.map((item, i) => (
            <details open={i === 0}>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
        <p class="fine"><a href="/faq">Full FAQ</a> · <a href="/contact">Contact us</a></p>
      </div>
    </section>

    <CTABand />
  </main>
  <Footer />

  <style>
    /* RateRows renders its own section chrome; embedded here we only want the
       rows, so collapse its outer spacing and hide its duplicate heading. */
    .rates-embed :global(section.sec) { padding: 0; }
    .rates-embed :global(.sec-hd), .rates-embed :global(.fine) { display: none; }
    .rates-embed { margin-bottom: 18px; }

    .plan-detail article { position: relative; }
    .pd-pop {
      margin-left: 8px;
      font-size: 9.5px; font-weight: 800; letter-spacing: 0.1em;
      color: var(--acc-btn-fg, #fff); background: var(--acc-btn); border-radius: 2px; padding: 2px 6px;
    }
    .pd-price {
      font-size: 22px; font-weight: 800; letter-spacing: -0.03em;
      color: var(--text-primary);
    }
    .pd-price em { font-style: normal; font-size: 12px; font-weight: 600; color: var(--text-tertiary); }
    .pd-quotas {
      display: flex; flex-wrap: wrap; gap: 6px 16px;
      margin-top: 10px; padding: 0; list-style: none;
      font-size: 12.5px; color: var(--text-tertiary);
    }
    .pd-quotas b { color: var(--text-primary); font-weight: 700; }
    .pd-features { margin-top: 12px; padding: 0; list-style: none; }
    .pd-features li {
      position: relative; padding: 4px 0 4px 16px;
      font-size: 13.5px; color: var(--text-secondary); line-height: 1.5;
    }
    .pd-features li::before {
      content: ""; position: absolute; left: 0; top: 0.85em;
      width: 6px; height: 2px; background: var(--acc);
    }

    .terminal table.bench tr.is-hl td { background: var(--acc-tint); }
    .terminal table.bench .is-hl-col { background: var(--surface-alt); }

    .value-points {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 0;
      padding: 0; list-style: none;
      border-top: 1px solid var(--border); border-left: 1px solid var(--border);
    }
    .value-points li {
      padding: 16px 18px;
      border-right: 1px solid var(--border); border-bottom: 1px solid var(--border);
      background: var(--surface-raised);
      font-size: 14px; font-weight: 600; color: var(--text-secondary);
      position: relative; padding-left: 38px;
    }
    .value-points li::before {
      content: ""; position: absolute; left: 18px; top: 22px;
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--pos);
    }
    .fine a { color: var(--acc); font-weight: 600; }

    @media (max-width: 640px) {
      .value-points { grid-template-columns: 1fr; }
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('#plans a[href]').forEach(function(el) {
        el.addEventListener('click', function() {
          window.posthog?.capture('pricing_plan_selected', {
            cta_text: el.textContent?.trim(),
            cta_href: el.getAttribute('href'),
          });
        });
      });
    });
  </script>
</Layout>
