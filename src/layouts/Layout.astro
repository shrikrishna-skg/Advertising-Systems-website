---
import '../styles/global.css';
import PostHog from '../components/posthog.astro';
import SiteControls from '../components/SiteControls.astro';

interface BreadcrumbItem {
  name: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  breadcrumbs?: BreadcrumbItem[];
  jsonLd?: Record<string, unknown>;
  /** Set to true for pages that must not be indexed (e.g. 404). */
  noindex?: boolean;
}

const {
  title = 'Advertising Systems — AI-Powered Advertising Management | by Multisystems',
  description = 'Stop wasting ad spend. AI-powered campaign management, optimization, and analytics across Google Ads, Meta Ads, and OTAs — all in one dashboard.',
  canonical: canonicalProp,
  ogImage = '/og-image.png',
  breadcrumbs = [],
  jsonLd,
  noindex = false,
} = Astro.props;

// www is canonical: the apex 307-redirects to www in production.
const siteUrl = 'https://www.advertisingsystems.ai';

// Build canonical URL for search engines: always absolute, no trailing slash (matches sitemap).
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = canonicalProp ?? `${siteUrl}${pathname}`;

const robotsContent = noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Advertising Systems',
  url: siteUrl,
  logo: `${siteUrl}/logos/advertisingsystems-logo.svg`,
  description: 'AI-Powered Advertising Management Platform by Multisystems',
  parentOrganization: {
    '@type': 'Organization',
    '@id': 'https://www.multisystems.ai/#organization',
    name: 'Multisystems',
    url: 'https://www.multisystems.ai',
  },
  // Family graph: the hub's product page for this brand plus every live
  // sibling at its canonical host (reputation/hotel/ota/image serve on apex;
  // revenue 308s apex → www). Mirrors revenuesystems.app, the one sibling
  // that already enumerates us.
  sameAs: [
    'https://www.linkedin.com/company/multisystems-ai',
    'https://www.multisystems.ai/products/advertising-systems',
    'https://www.revenuesystems.app',
    'https://reputationsystems.ai',
    'https://hotelsystems.ai',
    'https://otasystems.ai',
    'https://imagesystems.ai',
  ],
};

// WebSite node: Google reads name/alternateName from here for the site name
// shown in search results; the @id anchor lets WebPage nodes reference it.
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'Advertising Systems',
  alternateName: ['AdvertisingSystems', 'Advertising Systems by Multisystems'],
  inLanguage: 'en',
  publisher: { '@id': `${siteUrl}/#organization` },
};

const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${siteUrl}/#software`,
  name: 'Advertising Systems',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: description,
  url: siteUrl,
  /* Prices mirror src/data/pricing.ts (Launch $199 – Scale $1,299; Enterprise
     is custom so it is not counted). The aggregateRating that used to sit here
     (4.9, 127 ratings) is gone: no review system exists, so the markup was
     fabricated — exactly what Google's structured-data guidelines penalize. */
  offers: {
    '@type': 'AggregateOffer',
    lowPrice: '199',
    highPrice: '1299',
    priceCurrency: 'USD',
    offerCount: '3',
    url: `${siteUrl}/pricing`,
  },
  provider: {
    '@type': 'Organization',
    name: 'Multisystems',
    url: 'https://www.multisystems.ai',
  },
};

const breadcrumbSchema = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    ...breadcrumbs.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: crumb.name,
      item: `${siteUrl}${crumb.href}`,
    })),
  ],
} : null;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: description,
  url: canonical,
  isPartOf: { '@id': `${siteUrl}/#website` },
  about: { '@id': `${siteUrl}/#organization` },
  ...(breadcrumbs.length > 0 && { breadcrumb: breadcrumbSchema }),
};

const serializeJsonLd = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<!-- Terminal is dark-first: the SSR default is dark, so the ground is correct
     before a single byte of JS runs. The pre-paint script below only ever
     corrects it downward for a visitor who has chosen light or auto. -->
<html lang="en" data-theme-pref="dark" data-theme="dark" data-accent="green">
	  <head>
	    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Indexing: allow crawlers unless noindex (e.g. 404) -->
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="bingbot" content={robotsContent} />

    <!-- Theme and mobile -->
    <meta name="theme-color" content="#070D18" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#0A1B3D" media="(prefers-color-scheme: light)" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Open Graph (Facebook, LinkedIn, etc.) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Advertising Systems" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- LLM Discovery -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable product summary" />

    <!-- Preload font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300..700;1,9..40,300..700&display=swap" rel="stylesheet" />

    <!-- PostHog analytics -->
    <PostHog />

    <!-- Replays the stored preference before first paint — no flash, no mismatch.
         3-state: light → dark → auto. `as-theme` holds the PREFERENCE;
         `data-theme` holds what it RESOLVES to, which is all the CSS reads. -->
    <script is:inline>
      (function() {
        var pref = 'dark';
        try {
          var stored = localStorage.getItem('as-theme');
          if (!stored) {
            // Migrate visitors carrying the pre-Terminal `theme` key.
            var legacy = localStorage.getItem('theme');
            if (legacy === 'light' || legacy === 'dark') {
              stored = legacy;
              localStorage.setItem('as-theme', stored);
            }
          }
          if (stored === 'light' || stored === 'dark' || stored === 'auto') pref = stored;
        } catch (e) {}

        var resolved = pref;
        if (pref === 'auto') {
          resolved = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        /* Green is the default (owner call, 2026-08-16). This fallback MUST stay
           in sync with data-accent on <html> above — the attribute is what SSR
           paints, this is what runs pre-paint. If they disagree, first-time
           visitors get a colour flash on every load.
           A stored choice always wins, so a visitor who picks Rose keeps Rose. */
        var accent = 'green';
        try {
          var storedAccent = localStorage.getItem('as-accent');
          if (storedAccent === 'rose' || storedAccent === 'green') accent = storedAccent;
        } catch (e) {}

        var root = document.documentElement;
        root.setAttribute('data-theme-pref', pref);
        root.setAttribute('data-theme', resolved);
        root.setAttribute('data-accent', accent);
      })();
    </script>

    <!-- JSON-LD Schemas (help search engines understand and index content) -->
	    <script type="application/ld+json" set:html={serializeJsonLd(organizationSchema)} />
	    <script type="application/ld+json" set:html={serializeJsonLd(websiteSchema)} />
	    <script type="application/ld+json" set:html={serializeJsonLd(softwareSchema)} />
	    <script type="application/ld+json" set:html={serializeJsonLd(webPageSchema)} />
	    {breadcrumbSchema && <script type="application/ld+json" set:html={serializeJsonLd(breadcrumbSchema)} />}
	    {jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
	  </head>
	  <body class="bg-[var(--surface)] text-[var(--text-secondary)] transition-colors duration-300 min-w-0 pb-safe">
    <slot />

    <SiteControls />


	    <div id="cookie-consent-banner" class="hidden fixed inset-x-3 sm:inset-x-4 bottom-3 sm:bottom-4 z-50 max-w-xl mx-auto rounded-xl sm:rounded-2xl border border-[var(--border)] bg-[var(--surface)] text-[var(--text-secondary)] shadow-2xl p-3 sm:p-4" role="dialog" aria-live="polite" aria-label="Cookie consent">
	      <p class="text-xs sm:text-sm leading-relaxed">
	        We use optional analytics and support tools to improve the site. You can accept them or keep browsing with only essential storage.
	      </p>
	      <div class="mt-3 grid grid-cols-2 sm:flex gap-2 sm:justify-end">
	        <button type="button" id="cookie-consent-decline" class="px-4 py-2 rounded-lg border border-[var(--border)] text-xs sm:text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors">Decline</button>
	        <button type="button" id="cookie-consent-accept" class="px-4 py-2 rounded-lg bg-acc-500 text-white text-xs sm:text-sm font-semibold hover:bg-acc-600 transition-colors">Accept</button>
	      </div>
	    </div>

	    <script is:inline>
	      (function() {
	        var CONSENT_KEY = 'ads_cookie_consent';
	        var GTM_ID = 'GTM-T349524D';
	        var GA_ID = 'G-V2W1EBPC9R';
	        var ZOHO_SRC = 'https://salesiq.zohopublic.com/widget?wc=siqce0c2ba6bae40ab6f6639c9f14f8e43cea1fff6057d06bdcae51ca54ba513ddf';

	        function getConsent() {
	          try { return localStorage.getItem(CONSENT_KEY); } catch (e) { return 'declined'; }
	        }

	        function setConsent(value) {
	          try { localStorage.setItem(CONSENT_KEY, value); } catch (e) {}
	        }

	        function appendScript(src, options) {
	          if (document.querySelector('script[src="' + src + '"]')) return;
	          var script = document.createElement('script');
	          script.src = src;
	          script.async = options && options.async !== undefined ? options.async : true;
	          script.defer = Boolean(options && options.defer);
	          if (options && options.id) script.id = options.id;
	          document.head.appendChild(script);
	        }

	        function loadMarketingTools() {
	          if (window.__adsMarketingLoaded) return;
	          window.__adsMarketingLoaded = true;

	          window.dataLayer = window.dataLayer || [];
	          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
	          appendScript('https://www.googletagmanager.com/gtm.js?id=' + GTM_ID, { async: true });

	          window.gtag = window.gtag || function() { window.dataLayer.push(arguments); };
	          appendScript('https://www.googletagmanager.com/gtag/js?id=' + GA_ID, { async: true });
	          window.gtag('js', new Date());
	          window.gtag('config', GA_ID, { anonymize_ip: true });

	          window.$zoho = window.$zoho || {};
	          window.$zoho.salesiq = window.$zoho.salesiq || { ready: function() {} };
	          appendScript(ZOHO_SRC, { id: 'zsiqscript', defer: true });
	        }

	        function hideBanner() {
	          var banner = document.getElementById('cookie-consent-banner');
	          if (banner) banner.classList.add('hidden');
	        }

	        function initConsent() {
	          var banner = document.getElementById('cookie-consent-banner');
	          var accept = document.getElementById('cookie-consent-accept');
	          var decline = document.getElementById('cookie-consent-decline');

	          // Listeners attach regardless of the stored choice. They used to be
	          // wired only when consent was unset, which meant a visitor who had
	          // already chosen could never change their mind — the banner had no
	          // working buttons left. The bottom-left control reopens it.
	          if (banner && accept && decline) {
	            accept.addEventListener('click', function() {
	              setConsent('accepted');
	              hideBanner();
	              loadMarketingTools();
	              window.dispatchEvent(new CustomEvent('ads-cookie-consent-accepted'));
	            });
	            decline.addEventListener('click', function() {
	              setConsent('declined');
	              hideBanner();
	            });
	            window.adsOpenCookieSettings = function() {
	              banner.classList.remove('hidden');
	            };
	          }

	          var consent = getConsent();
	          if (consent === 'accepted') {
	            loadMarketingTools();
	            return;
	          }
	          if (consent === 'declined') return;

	          if (banner) banner.classList.remove('hidden');
	        }

	        if (document.readyState === 'loading') {
	          document.addEventListener('DOMContentLoaded', initConsent, { once: true });
	        } else {
	          initConsent();
	        }
	      })();
	    </script>
	  </body>
	</html>
