# Copy to .env and fill in. Never commit .env or real secrets.

# Google Calendar API (for /api/book-demo)
# Create OAuth 2.0 credentials at https://console.cloud.google.com/apis/credentials
# Use "Desktop app" or "Web application" and add your redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# One-time: run an OAuth flow with access_type=offline&prompt=consent to get a refresh token
# for the Google account that owns the calendar (e.g. shrikrishna@multisystems.ai).
# Get refresh token: node scripts/get-google-refresh-token.js (sign in as shrikrishna@multisystems.ai)
GOOGLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_CALENDAR_ID=primary
# Must match one authorized redirect URI on the OAuth client when generating a refresh token.
GOOGLE_REDIRECT_URI=http://localhost
DEMO_TIME_ZONE=America/Chicago
DEMO_DURATION_MINUTES=30
# Set true only if the prospect should receive a Google Calendar invite email.
DEMO_SEND_CALENDAR_INVITES=true
# Set true to auto-create a Google Meet link on the calendar event.
DEMO_CREATE_GOOGLE_MEET=true
# Optional: Zoom, Google Meet, phone number, or office location shown on created events.
DEMO_EVENT_LOCATION=

# SMTP confirmation email sent after the Google Calendar event is created.
# Keep the password server-side only. Do not commit a real password.
DEMO_CONFIRMATION_EMAIL_ENABLED=true
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=no-reply@multisystems.ai
SPRING_MAIL_PASSWORD=your-smtp-app-password
SPRING_MAIL_FROM_NAME=Advertising Systems
DEMO_REPLY_TO_EMAIL=contact@multisystems.ai
PUBLIC_SITE_URL=https://advertisingsystems.ai

# PostHog analytics (client-side and optional server-side demo conversion events)
PUBLIC_POSTHOG_PROJECT_TOKEN=your-public-posthog-project-token
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_TOKEN=your-posthog-project-token
POSTHOG_HOST=https://us.i.posthog.com
